{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "bun install --frozen-lockfile",
	"buildCommand": "bash scripts/install-resume-assets.sh && bun run build",
	"ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"gh-pages\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"resume-assets\" ]; then exit 0; else exit 1; fi",
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
				},
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin"
				}
			]
		},
		{
			"source": "/site.webmanifest",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/manifest+json; charset=utf-8"
				}
			]
		},
		{
			"source": "/resume/manifest.json",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				},
				{
					"key": "Cache-Control",
					"value": "no-store"
				}
			]
		},
		{
			"source": "/resume/david-sandoval-resume.pdf",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/pdf"
				},
				{
					"key": "Content-Disposition",
					"value": "attachment; filename=\"david-sandoval-resume.pdf\""
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, s-maxage=300, must-revalidate"
				}
			]
		},
		{
			"source": "/resume/david-sandoval-resume-es.pdf",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/pdf"
				},
				{
					"key": "Content-Disposition",
					"value": "attachment; filename=\"david-sandoval-resume-es.pdf\""
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, s-maxage=300, must-revalidate"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/links",
			"destination": "https://hub.sandovaldavid.com",
			"permanent": true
		},
		{
			"source": "/links/:path*",
			"destination": "https://hub.sandovaldavid.com/:path*",
			"permanent": true
		},
		{
			"source": "/atena",
			"destination": "/experience/atena-software-engineer",
			"permanent": true
		},
		{
			"source": "/es/atena",
			"destination": "/es/experience/atena-software-engineer",
			"permanent": true
		}
	]
}
