---
import { Font } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ArrowUpRightIcon from '@assets/icons/ArrowUpRight.astro';
import '@app/styles/global.css';
import { Footer } from '@widgets/footer';
import { Header } from '@widgets/header';
import { Button, LinkButton } from '@shared/ui';
import {
	createScopedUiTranslator,
	getUiCatalogNamespace,
	LANGUAGE_LABELS,
	Language,
} from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';

const defaultLang = Language.ENGLISH;
const tErrors = createScopedUiTranslator(defaultLang, 'errors');
const localizedErrors = {
	[Language.ENGLISH]: getUiCatalogNamespace(Language.ENGLISH, 'errors'),
	[Language.SPANISH]: getUiCatalogNamespace(Language.SPANISH, 'errors'),
};
const localizedHomePaths = {
	[Language.ENGLISH]: getRelativeLocaleUrl(Language.ENGLISH, ''),
	[Language.SPANISH]: getRelativeLocaleUrl(Language.SPANISH, ''),
};
const localizedShell = {
	[Language.ENGLISH]: {
		navigation: getUiCatalogNamespace(Language.ENGLISH, 'navigation'),
		footer: getUiCatalogNamespace(Language.ENGLISH, 'footer'),
		accessibility: getUiCatalogNamespace(Language.ENGLISH, 'accessibility'),
		paths: {
			home: localizedHomePaths[Language.ENGLISH],
			blog: getRelativeLocaleUrl(Language.ENGLISH, 'blog'),
			devlog: getRelativeLocaleUrl(Language.ENGLISH, 'devlog'),
		},
		resume: siteConfig.resume.en,
	},
	[Language.SPANISH]: {
		navigation: getUiCatalogNamespace(Language.SPANISH, 'navigation'),
		footer: getUiCatalogNamespace(Language.SPANISH, 'footer'),
		accessibility: getUiCatalogNamespace(Language.SPANISH, 'accessibility'),
		paths: {
			home: localizedHomePaths[Language.SPANISH],
			blog: getRelativeLocaleUrl(Language.SPANISH, 'blog'),
			devlog: getRelativeLocaleUrl(Language.SPANISH, 'devlog'),
		},
		resume: siteConfig.resume.es,
	},
};
---

<!doctype html>
<html lang={defaultLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={tErrors('notFoundDescription')} />
		<meta name="robots" content="noindex, follow" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.light.svg"
			media="(prefers-color-scheme: light)"
		/>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.dark.svg"
			media="(prefers-color-scheme: dark)"
		/>
		<title>{tErrors('notFoundPageTitle')}</title>

		<Font cssVariable="--font-pixel" />
		<Font cssVariable="--font-pixel-clean" preload />
		<Font cssVariable="--font-retro-tag" />
		<Font cssVariable="--font-gaming-mono" />
		<Font cssVariable="--font-mono" />

		<script is:inline>
			(function applyTheme() {
				const saved = localStorage.getItem('theme') || 'dark';
				const isDark =
					saved === 'dark' ||
					(saved === 'system' &&
						window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.classList.toggle('dark', isDark);
			})();
		</script>
		<script
			is:inline
			data-localized-errors={JSON.stringify(localizedErrors)}
			data-localized-shell={JSON.stringify(localizedShell)}
			data-language-labels={JSON.stringify(LANGUAGE_LABELS)}
			data-site-name={siteConfig.name}
		>
			const localizationScript = document.currentScript;
			const localizedErrors = JSON.parse(
				localizationScript?.getAttribute('data-localized-errors') ?? '{}'
			);
			const localizedShell = JSON.parse(
				localizationScript?.getAttribute('data-localized-shell') ?? '{}'
			);
			const languageLabels = JSON.parse(
				localizationScript?.getAttribute('data-language-labels') ?? '{}'
			);
			const siteName = localizationScript?.getAttribute('data-site-name') ?? 'David Sandoval';
			const locale =
				window.location.pathname === '/es' || window.location.pathname.startsWith('/es/')
					? 'es'
					: 'en';
			const localizedCopy = localizedErrors[locale];
			const shell = localizedShell[locale];

			if (!localizedCopy || !shell) {
				throw new Error(`Missing static 404 localization data for locale: ${locale}`);
			}

			document.documentElement.lang = locale;
			document.title = localizedCopy.notFoundPageTitle;
			document
				.querySelector('meta[name="description"]')
				?.setAttribute('content', localizedCopy.notFoundDescription);

			const setOwnText = (element, value) => {
				if (!element) return;
				const textNode = Array.from(element.childNodes).find(
					node => node.nodeType === Node.TEXT_NODE && node.textContent?.trim()
				);
				if (textNode) textNode.textContent = ` ${value} `;
				else element.append(document.createTextNode(value));
			};

			const applyLocalizedNotFoundCopy = () => {
				const textById = {
					'not-found-title': localizedCopy.notFoundTitle,
					'not-found-message': localizedCopy.notFoundMessage,
					'not-found-home-label': localizedCopy.homeButton,
					'not-found-back-label': localizedCopy.backButton,
					'not-found-quote': localizedCopy.notFoundQuote,
				};
				for (const [id, value] of Object.entries(textById)) {
					const element = document.getElementById(id);
					if (element) element.textContent = value;
				}
				document
					.querySelector('#not-found-home-link a')
					?.setAttribute('href', shell.paths.home);

				const header = document.querySelector('header[data-header]');
				const brandLink = header?.querySelector('.brand-logo-link');
				brandLink?.setAttribute('href', shell.paths.home);
				brandLink?.setAttribute('aria-label', shell.accessibility.brandHomeLink);

				const navBySection = {
					experience: shell.navigation.experience,
					projects: shell.navigation.projects,
					research: shell.navigation.research,
					'about-me': shell.navigation.about,
					blog: shell.navigation.blog,
				};
				header?.querySelectorAll('a[data-section-id]').forEach(link => {
					const section = link.getAttribute('data-section-id');
					const label = navBySection[section];
					if (!label) return;
					link.setAttribute('aria-label', label);
					const labelElement = link.querySelector('span');
					if (labelElement) labelElement.textContent = label;
					link.setAttribute(
						'href',
						section === 'blog' ? shell.paths.blog : `${shell.paths.home}#${section}`
					);
				});

				header?.querySelectorAll('a.btn-primary[target="_blank"]').forEach(link => {
					link.setAttribute('href', shell.resume);
					link.setAttribute(
						'aria-label',
						`${shell.navigation.resume}, ${shell.accessibility.externalLink}`
					);
					setOwnText(link, shell.navigation.resume);
				});
				const mobileContact = header?.querySelector('a.btn-secondary[href^="mailto:"]');
				setOwnText(mobileContact, shell.footer.contact);

				const menuButton = document.getElementById('mobile-menu-btn');
				const closeButton = document.getElementById('mobile-menu-close');
				menuButton?.setAttribute('aria-label', shell.accessibility.openMenu);
				closeButton?.setAttribute('aria-label', shell.accessibility.closeMenu);
				header?.querySelectorAll('nav[aria-label]').forEach(nav => {
					nav.setAttribute(
						'aria-label',
						nav.closest('#mobile-menu')
							? shell.accessibility.mobileNavigation
							: shell.accessibility.mainNavigation
					);
				});

				const languageGroup = header?.querySelector('[role="group"]');
				languageGroup?.setAttribute('aria-label', shell.accessibility.chooseLanguage);
				header?.querySelectorAll('[data-language-base-path]').forEach(link => {
					const language = link.textContent?.trim().toLowerCase();
					const languageShell = localizedShell[language];
					if (!languageShell) return;
					const isCurrent = language === locale;
					link.setAttribute('href', languageShell.paths.home);
					link.setAttribute('data-language-base-path', languageShell.paths.home);
					link.toggleAttribute('aria-current', isCurrent);
					link.setAttribute(
						'aria-label',
						isCurrent
							? `${languageLabels[language]}, ${shell.accessibility.currentPage}`
							: languageLabels[language]
					);
					link.classList.toggle('pointer-events-none', isCurrent);
					link.classList.toggle('cursor-default', isCurrent);
					link.classList.toggle('bg-button-primary-background', isCurrent);
					link.classList.toggle('text-button-primary-content', isCurrent);
					link.classList.toggle('bg-channel-surface-default', !isCurrent);
					link.classList.toggle('text-content-strong', !isCurrent);
				});

				const footer = document.querySelector('footer');
				const footerContent = footer?.querySelector(':scope > div');
				const footerTitle = footerContent?.querySelector('h2');
				const footerSubtitle = footerContent?.querySelector('p');
				if (footerTitle) footerTitle.textContent = shell.footer.title;
				if (footerSubtitle) footerSubtitle.textContent = shell.footer.subtitle;
				const footerContact = footerContent?.querySelector(
					'a.btn-primary[href^="mailto:"]'
				);
				setOwnText(footerContact, shell.footer.contact);

				const footerCopyright = footer?.querySelector(':scope > p');
				const footerDevlog = footerCopyright?.querySelector('a');
				if (footerCopyright) {
					setOwnText(
						footerCopyright,
						`© ${new Date().getFullYear()} ${siteName} · ${shell.footer.builtWith} · V2.0.0 ·`
					);
				}
				if (footerDevlog) {
					footerDevlog.textContent = shell.navigation.devlog;
					footerDevlog.setAttribute('href', shell.paths.devlog);
				}
				const emailSocial = footerContent?.querySelector('ul a[href^="mailto:"]');
				emailSocial?.setAttribute('title', shell.footer.emailDavid);
				emailSocial?.setAttribute('aria-label', shell.footer.emailDavid);
				const backToTop = document.querySelector(
					'[aria-label="Back to top"], [aria-label="Volver arriba"]'
				);
				backToTop?.setAttribute('aria-label', shell.accessibility.backToTop);
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', applyLocalizedNotFoundCopy, {
					once: true,
				});
			} else {
				applyLocalizedNotFoundCopy();
			}
		</script>
	</head>

	<body class="min-h-screen bg-channel-background-canvas text-channel-content-strong">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:border-2 focus:border-button-border focus:bg-button-primary-background focus:px-4 focus:py-2 focus:text-button-label focus:text-button-primary-content focus:shadow-retro-lg focus:no-underline"
		>
			{getUiCatalogNamespace(defaultLang, 'accessibility').skipToContent}
		</a>

		<div class="flex min-h-screen w-full flex-col">
			<Header localizedPaths={localizedHomePaths} />

			<main
				id="main-content"
				class="flex min-h-screen w-full items-center justify-center px-5 pt-28 pb-16 md:px-8"
			>
				<div class="mx-auto flex w-full max-w-3xl flex-col items-center text-center">
					<p
						class="font-pixel-clean text-8xl leading-none text-channel-accent-primary select-none md:text-9xl"
						aria-hidden="true"
					>
						404
					</p>

					<h1
						id="not-found-title"
						class="mt-8 text-feature-title uppercase text-channel-content-strong md:text-section-title"
					>
						{tErrors('notFoundTitle')}
					</h1>
					<p
						id="not-found-message"
						class="mt-5 max-w-2xl text-body text-channel-content-default"
					>
						{tErrors('notFoundMessage')}
					</p>

					<div
						class="mt-6 w-full max-w-2xl border border-channel-edge-subtle bg-channel-surface-default px-5 py-4 shadow-retro-sm"
					>
						<p class="text-code text-channel-content-default">
							<span aria-hidden="true">“</span><span id="not-found-quote"
								>{tErrors('notFoundQuote')}</span
							><span aria-hidden="true">”</span>
						</p>
					</div>

					<div
						class="mt-6 flex w-full max-w-85 flex-col justify-center gap-4 sm:max-w-none sm:flex-row"
					>
						<div id="not-found-home-link" class="w-full sm:w-auto">
							<LinkButton
								href={localizedHomePaths[defaultLang]}
								target="_self"
								class="w-full sm:w-47.5"
							>
								<ArrowUpRightIcon aria-hidden="true" />
								<span id="not-found-home-label">{tErrors('homeButton')}</span>
							</LinkButton>
						</div>
						<Button
							variant="secondary"
							onclick="history.back()"
							class="w-full sm:w-47.5"
						>
							<ArrowUpRightIcon aria-hidden="true" />
							<span id="not-found-back-label">{tErrors('backButton')}</span>
						</Button>
					</div>
				</div>
			</main>

			<Footer />
		</div>
	</body>
</html>
