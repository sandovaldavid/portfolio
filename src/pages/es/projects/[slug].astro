---
import { render } from 'astro:content';
import Layout from '@app/layouts/Layout.astro';
import { getProjectDetailBySlug, getProjectsData } from '@entities/project';
import { createScopedUiTranslator, getLanguageFromLocale, Language } from '@shared/config/i18n';
import { ProjectCaseStudy, projectCaseStudyComponents } from '@widgets/project-case-study';

export async function getStaticPaths() {
	const projects = await getProjectsData(Language.SPANISH);
	return projects.map(project => ({
		params: { slug: project.slug },
		props: { slug: project.slug },
	}));
}

const lang = getLanguageFromLocale(Astro.currentLocale);
const slug = Astro.params.slug ?? '';
const tProjects = createScopedUiTranslator(lang, 'sections.projects');
const detail = await getProjectDetailBySlug(lang, slug);

if (!detail) {
	return Astro.redirect('/404');
}

const { project, entry } = detail;
const { Content } = await render(entry);
const pageTitle = `${project.title} — ${tProjects('caseStudy')} | David Sandoval`;
const previewImage = `/og/preview-project-${slug}-${lang}-dark.png`;
---

<Layout
	title={pageTitle}
	description={project.description}
	img_preview={previewImage}
	imageAlt={`${project.title} — ${tProjects('caseStudy')}`}
	pageType="project"
	breadcrumbLabel={project.title}
	contentLayout="flush"
>
	<ProjectCaseStudy {project}>
		<Content components={projectCaseStudyComponents} />
	</ProjectCaseStudy>
</Layout>
