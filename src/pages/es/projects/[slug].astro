---
import { getProjectsData } from '@entities/project';
import { Language } from '@shared/config/i18n';
import Page from '../../projects/[slug].astro';

export async function getStaticPaths() {
	const projects = await getProjectsData(Language.SPANISH);
	return projects.map(project => ({
		params: { slug: project.slug },
		props: { slug: project.slug },
	}));
}
---

<Page {...Astro.props} />
