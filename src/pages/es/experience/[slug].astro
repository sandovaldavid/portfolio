---
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '@app/layouts/Layout.astro';
import { getExperienceData, getExperienceDetailBySlug } from '@entities/experience';
import { Language } from '@shared/config/i18n';
import { ExperienceCaseStudy, experienceCaseStudyComponents } from '@widgets/experience-case-study';

export async function getStaticPaths() {
	const experience = await getExperienceData(Language.SPANISH);
	return experience.map(item => ({
		params: { slug: item.experienceId },
		props: { slug: item.experienceId },
	}));
}

const slug = Astro.params.slug ?? '';
const detail = await getExperienceDetailBySlug(Language.SPANISH, slug);

if (!detail) {
	return Astro.redirect('/404');
}

const { experience, entry, previous, next } = detail;
const { Content } = await render(entry);
const pageTitle = `${experience.title} — ${experience.company} | David Sandoval`;
const previewImage =
	slug === 'atena-software-engineer'
		? `/og/preview-case-study-${slug}-es-dark.png`
		: '/og/preview-website-experience-es-dark.png';
const localizedPaths = {
	[Language.ENGLISH]: getRelativeLocaleUrl(Language.ENGLISH, `experience/${slug}`),
	[Language.SPANISH]: getRelativeLocaleUrl(Language.SPANISH, `experience/${slug}`),
};
---

<Layout
	title={pageTitle}
	description={experience.summary}
	img_preview={previewImage}
	imageAlt={`${experience.company} — ${experience.title}`}
	pageType="experience"
	breadcrumbLabel={experience.company}
	{localizedPaths}
	contentLayout="flush"
>
	<ExperienceCaseStudy {experience} {previous} {next}>
		<Content components={experienceCaseStudyComponents} />
	</ExperienceCaseStudy>
</Layout>
