---
import { render } from 'astro:content';
import Layout from '@app/layouts/Layout.astro';
import { getExperienceData, getExperienceDetailBySlug } from '@entities/experience';
import { Language } from '@shared/config/i18n';
import {
	ExperienceCaseStudy,
	experienceCaseStudyComponents,
} from '@widgets/experience-case-study';

export async function getStaticPaths() {
	const experience = await getExperienceData(Language.SPANISH);
	return experience.map(item => ({
		params: { slug: item.experienceId },
		props: { slug: item.experienceId },
	}));
}

const slug = Astro.params.slug ?? '';
const detail = await getExperienceDetailBySlug(Language.SPANISH, slug);

if (!detail) {
	return Astro.redirect('/es/404');
}

const { experience, entry, previous, next } = detail;
const { Content } = await render(entry);
const pageTitle = `${experience.title} — ${experience.company} | David Sandoval`;
---

<Layout
	title={pageTitle}
	description={experience.summary}
	img_preview="/profile/perfil.webp"
	imageAlt={`${experience.company} — ${experience.title}`}
	breadcrumbLabel={experience.company}
	contentLayout="flush"
>
	<ExperienceCaseStudy {experience} {previous} {next}>
		<Content components={experienceCaseStudyComponents} />
	</ExperienceCaseStudy>
</Layout>
