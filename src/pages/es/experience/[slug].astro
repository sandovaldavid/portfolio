---
import { getExperienceData } from '@entities/experience';
import { Language } from '@shared/config/i18n';
import Page from '../../experience/[slug].astro';

export async function getStaticPaths() {
	const experience = await getExperienceData(Language.SPANISH);
	return experience.map(item => ({
		params: { slug: item.experienceId },
		props: { slug: item.experienceId },
	}));
}
---

<Page {...Astro.props} />
