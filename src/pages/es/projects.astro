---
import Layout from '@app/layouts/Layout.astro';
import { ProjectsCatalog } from '@widgets/projects';
import { createScopedUiTranslator, Language } from '@shared/config/i18n';

const tProjects = createScopedUiTranslator(Language.SPANISH, 'sections.projects');
---

<Layout
	title={tProjects('catalogTitle')}
	description={tProjects('catalogDescription')}
	img_preview="/projects/portfolio.webp"
>
	<ProjectsCatalog lang={Language.SPANISH} />
</Layout>
