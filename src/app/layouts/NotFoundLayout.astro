---
/**
 * Document shell for the static 404 page.
 *
 * Astro renders one 404 document for every unknown path, so the served copy is
 * English and the client script retargets it to `/es` paths after load. The
 * patched element ids are the contract between this shell and its slot content.
 */
import { Font } from 'astro:assets';
import '@app/styles/global.css';
import ThemeBootstrap from '@app/layouts/ThemeBootstrap.astro';
import { Footer } from '@widgets/footer';
import { Header } from '@widgets/header';
import { getUiCatalogNamespace, type Language, type LocalizedPathMap } from '@shared/config/i18n';

interface Props {
	lang: Language;
	title: string;
	description: string;
	localizedErrors: Record<Language, Record<string, string>>;
	localizedHomePaths: LocalizedPathMap;
}

const { lang, title, description, localizedErrors, localizedHomePaths } = Astro.props;
const skipToContent = getUiCatalogNamespace(lang, 'accessibility').skipToContent;
---

<!doctype html>
<html {lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, follow" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.light.svg"
			media="(prefers-color-scheme: light)"
		/>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.dark.svg"
			media="(prefers-color-scheme: dark)"
		/>
		<title>{title}</title>

		<Font cssVariable="--font-pixel" />
		<Font cssVariable="--font-pixel-clean" />
		<Font cssVariable="--font-retro-tag" />
		<Font cssVariable="--font-gaming-mono" />
		<Font cssVariable="--font-mono" preload={[{ weight: '400', style: 'normal' }]} />

		<ThemeBootstrap />
		<script
			is:inline
			data-localized-errors={JSON.stringify(localizedErrors)}
			data-localized-home-paths={JSON.stringify(localizedHomePaths)}
		>
			const script = document.currentScript;
			const localizedErrors = JSON.parse(
				script?.getAttribute('data-localized-errors') ?? '{}'
			);
			const homePaths = JSON.parse(script?.getAttribute('data-localized-home-paths') ?? '{}');
			const locale =
				window.location.pathname === '/es' || window.location.pathname.startsWith('/es/')
					? 'es'
					: 'en';
			const localizedCopy = localizedErrors[locale];

			if (localizedCopy) {
				document.documentElement.lang = locale;
				document.title = localizedCopy.notFoundPageTitle;
				document
					.querySelector('meta[name="description"]')
					?.setAttribute('content', localizedCopy.notFoundDescription);

				const updateNotFoundDom = () => {
					const textById = {
						'not-found-title': localizedCopy.notFoundTitle,
						'not-found-message': localizedCopy.notFoundMessage,
						'not-found-quote': localizedCopy.notFoundQuote,
						'not-found-home-label': localizedCopy.homeButton,
						'not-found-back-label': localizedCopy.backButton,
					};
					for (const [id, value] of Object.entries(textById)) {
						const element = document.getElementById(id);
						if (element) element.textContent = value;
					}
					document
						.querySelector('#not-found-home-link a')
						?.setAttribute('href', homePaths[locale]);
				};

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', updateNotFoundDom, {
						once: true,
					});
				} else {
					updateNotFoundDom();
				}
			}
		</script>
	</head>

	<body class="min-h-screen bg-channel-background-canvas text-channel-content-strong">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:border-2 focus:border-button-border focus:bg-button-primary-background focus:px-4 focus:py-2 focus:text-button-label focus:text-button-primary-content focus:shadow-retro-lg focus:no-underline"
		>
			{skipToContent}
		</a>

		<div class="flex min-h-screen w-full flex-col">
			<Header localizedPaths={localizedHomePaths} />

			<main
				id="main-content"
				class="flex min-h-screen w-full items-center justify-center px-5 pt-28 pb-16 md:px-8"
			>
				<div class="mx-auto flex w-full max-w-3xl flex-col items-center text-center">
					<slot />
				</div>
			</main>

			<Footer />
		</div>
	</body>
</html>
