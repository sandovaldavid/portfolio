---
import {
	createScopedUiTranslator,
	getLanguageFromLocale,
	getUiCatalogNamespace,
	Language,
} from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tCli = createScopedUiTranslator(lang, 'cli');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const tRecruiter = createScopedUiTranslator(lang, 'recruiter');
const runtimeCopy = getUiCatalogNamespace(lang, 'cli');
const resumeUrl = lang === Language.ENGLISH ? siteConfig.resume.en : siteConfig.resume.es;
const emailHref = `mailto:${siteConfig.email}?subject=${encodeURIComponent(tRecruiter('emailSubject'))}`;

const navigationShortcuts: [string, string][] = [
	['j', tCli('shortcuts.scrollDown')],
	['k', tCli('shortcuts.scrollUp')],
	['gg', tCli('shortcuts.goTop')],
	['G', tCli('shortcuts.goBottom')],
];
const sectionShortcuts: [string, string][] = [
	['1', tCli('sections.hero')],
	['2', tCli('sections.experience')],
	['3', tCli('sections.research')],
	['4', tCli('sections.projects')],
	['5', tCli('sections.about')],
	['6', tCli('sections.technologies')],
];
const actionShortcuts: [string, string][] = [
	[':', tCli('shortcuts.openTerminal')],
	['/', tCli('shortcuts.navigateSection')],
	['?', tCli('shortcuts.showShortcuts')],
	['Esc', tCli('shortcuts.closeOverlay')],
];
const sectionNames = [
	tCli('sections.hero'),
	tCli('sections.experience'),
	tCli('sections.research'),
	tCli('sections.projects'),
	tCli('sections.about'),
	tCli('sections.technologies'),
];
const easterRows = [
	{
		label: tCli('easter.coffeeLabel'),
		value: tCli('easter.coffeeValue'),
		color: 'var(--color-channel-portfolio-terminal-phosphor)',
	},
	{
		label: tCli('easter.bugsLabel'),
		value: tCli('easter.bugsValue'),
		color: 'var(--color-channel-portfolio-terminal-error)',
	},
	{
		label: tCli('easter.tabsLabel'),
		value: tCli('easter.tabsValue'),
		color: 'var(--color-channel-portfolio-terminal-warning)',
	},
	{
		label: tCli('easter.commitLabel'),
		value: tCli('easter.commitValue'),
		color: 'var(--color-channel-portfolio-terminal-cyan)',
	},
	{
		label: tCli('easter.editorLabel'),
		value: tCli('easter.editorValue'),
		color: 'var(--color-channel-portfolio-terminal-phosphor)',
	},
	{
		label: tCli('easter.vimLabel'),
		value: tCli('easter.vimValue'),
		color: 'var(--color-channel-portfolio-terminal-phosphor)',
	},
	{
		label: tCli('easter.debugLabel'),
		value: tCli('easter.debugValue'),
		color: 'var(--color-channel-portfolio-terminal-content-muted)',
	},
	{
		label: tCli('easter.deployLabel'),
		value: tCli('easter.deployValue'),
		color: 'var(--color-channel-portfolio-terminal-warning)',
	},
	{
		label: tCli('easter.teamLabel'),
		value: tCli('easter.teamValue'),
		color: 'var(--color-channel-portfolio-terminal-phosphor)',
	},
];
---

<div id="cli-terminal-root">
	<div
		id="cli-runtime-data"
		hidden
		data-copy={JSON.stringify(runtimeCopy)}
		data-section-names={JSON.stringify(sectionNames)}
		data-resume-url={resumeUrl}
		data-github-user={siteConfig.social.githubUsername}
		data-email={siteConfig.email}
		data-linkedin={siteConfig.social.linkedinUsername}
		data-site-url={siteConfig.url}
	>
	</div>

	<div
		id="cli-overlay"
		role="dialog"
		aria-modal="true"
		aria-label={tAccessibility('terminalDialog')}
		class="fixed inset-0 z-[200] bg-channel-overlay backdrop-blur-sm hidden items-center justify-center p-4"
	>
		<div class="w-full max-w-2xl">
			<div
				class="bg-channel-portfolio-terminal-surface border-2 border-channel-portfolio-terminal-cyan shadow-terminal-glow font-mono"
			>
				<div
					class="flex items-center gap-2 px-4 py-2.5 bg-channel-portfolio-terminal-surface-raised border-b border-channel-portfolio-terminal-cyan/40 select-none"
				>
					<button
						id="cli-close-dot"
						type="button"
						aria-label={tAccessibility('closeTerminal')}
						class="w-3 h-3 rounded-full bg-channel-status-error hover:brightness-125 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-channel-portfolio-terminal-content"
					></button>
					<div class="w-3 h-3 rounded-full bg-channel-status-warning" aria-hidden="true">
					</div>
					<div
						class="w-3 h-3 rounded-full bg-channel-portfolio-terminal-phosphor"
						aria-hidden="true"
					>
					</div>
					<span
						class="ml-3 text-xs text-channel-portfolio-terminal-cyan tracking-widest uppercase"
					>
						portfolio@sandovaldavid:~
					</span>
					<span
						class="ml-auto text-xs text-channel-portfolio-terminal-content-muted hidden sm:block"
					>
						[{tCli('terminal.escapeHint')}]
					</span>
				</div>
				<div
					id="cli-output"
					class="h-96 overflow-y-auto p-4 space-y-0.5"
					aria-live="polite"
					aria-relevant="additions"
				>
				</div>
				<div
					class="flex items-center border-t border-channel-portfolio-terminal-cyan/30 px-4 py-3 bg-channel-portfolio-terminal-surface"
				>
					<span
						class="text-channel-portfolio-terminal-cyan mr-2 text-sm font-bold select-none"
						aria-hidden="true">$</span
					>
					<input
						id="cli-input"
						type="text"
						class="flex-1 bg-transparent text-sm text-channel-portfolio-terminal-content outline-none placeholder:text-channel-portfolio-terminal-content-muted caret-channel-portfolio-terminal-cyan"
						placeholder={tCli('terminal.placeholder')}
						autocomplete="off"
						spellcheck="false"
						aria-label={tAccessibility('terminalInput')}
					/>
					<span
						class="text-xs text-channel-portfolio-terminal-content-muted uppercase tracking-widest hidden sm:block"
					>
						{tCli('terminal.tabHint')}
					</span>
				</div>
			</div>
		</div>
	</div>

	<div
		id="shortcuts-modal"
		role="dialog"
		aria-modal="true"
		aria-label={tCli('shortcuts.title')}
		class="fixed inset-0 z-[200] bg-channel-overlay backdrop-blur-sm hidden items-center justify-center p-4"
	>
		<div
			class="w-full max-w-lg bg-channel-surface-default border-2 border-channel-edge-default shadow-retro-3xl font-mono"
		>
			<div
				class="flex items-center justify-between px-5 py-3 border-b-2 border-dashed border-channel-edge-subtle"
			>
				<span
					class="text-channel-accent-primary font-pixel-clean text-xs font-bold tracking-wider uppercase"
				>
					{tCli('shortcuts.title')}
				</span>
				<button
					id="shortcuts-close"
					type="button"
					class="px-1.5 py-0.5 border border-channel-edge-default text-xs font-bold hover:bg-channel-status-error hover:text-button-primary-content transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
					aria-label={tCli('shortcuts.closeOverlay')}
				>
					<span aria-hidden="true">×</span>
				</button>
			</div>

			<div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs">
				{
					[
						[tCli('shortcuts.navigationHeading'), navigationShortcuts],
						[tCli('shortcuts.sectionsHeading'), sectionShortcuts],
						[tCli('shortcuts.actionsHeading'), actionShortcuts],
					].map(([heading, shortcuts]) => (
						<div>
							<div class="text-channel-content-muted uppercase tracking-widest text-xs pb-1 mb-3 border-b border-channel-edge-subtle">
								{heading}
							</div>
							<div class="space-y-2">
								{(shortcuts as [string, string][]).map(([key, label]) => (
									<div class="flex items-center gap-2.5">
										<kbd class="inline-block min-w-[28px] text-center px-2 py-0.5 border border-channel-edge-default bg-channel-surface-highlight text-xs font-bold shadow-retro-sm">
											{key}
										</kbd>
										<span class="text-channel-content-muted">{label}</span>
									</div>
								))}
							</div>
						</div>
					))
				}

				<div class="opacity-60">
					<div
						class="text-channel-content-muted uppercase tracking-widest text-xs pb-1 mb-3 border-b border-channel-edge-subtle"
					>
						{tCli('shortcuts.secretHeading')}
					</div>
					<div class="space-y-2">
						<div class="flex items-center gap-2.5">
							<kbd
								class="inline-block min-w-[28px] text-center px-2 py-0.5 border border-channel-edge-default/40 bg-channel-surface-highlight/50 text-xs font-bold opacity-50"
							>
								??
							</kbd>
							<span class="text-channel-content-muted/80 text-xs italic">
								{tCli('shortcuts.secretHint')}
							</span>
						</div>
						<div class="text-sm text-channel-content-muted italic pl-1">
							{tCli('shortcuts.secretMessage')}
						</div>
					</div>
				</div>
			</div>

			<div
				class="px-5 py-2.5 border-t-2 border-dashed border-channel-edge-subtle text-sm text-channel-content-muted/80 text-center uppercase tracking-widest"
			>
				{tCli('shortcuts.footer')}
			</div>
		</div>
	</div>

	<div
		id="easter-egg-overlay"
		role="dialog"
		aria-modal="true"
		aria-label={tAccessibility('secretMode')}
		class="fixed inset-0 z-[300] bg-channel-overlay hidden items-center justify-center p-4"
	>
		<div class="terminal-grid absolute inset-0 pointer-events-none opacity-25"></div>
		<div class="w-full max-w-md font-mono space-y-4 relative z-10">
			<div
				class="border-2 border-channel-portfolio-terminal-error bg-channel-portfolio-terminal-error/10 px-6 py-4 text-center"
			>
				<div
					class="text-channel-portfolio-terminal-error font-bold tracking-[0.4rem] text-xl animate-pulse"
				>
					{tCli('easter.classified')}
				</div>
				<div
					class="text-channel-portfolio-terminal-error/80 text-xs mt-1.5 tracking-widest"
				>
					{tCli('easter.protocol')}
				</div>
				<div class="text-channel-portfolio-terminal-error/80 text-xs mt-0.5">
					{tCli('easter.clearance')}
				</div>
			</div>

			<div
				id="egg-loading"
				class="bg-channel-portfolio-terminal-surface/60 border border-channel-portfolio-terminal-cyan/30 p-4 text-xs space-y-1 min-h-[9rem] overflow-hidden"
			>
			</div>

			<div
				id="egg-stats"
				class="hidden border-2 border-channel-portfolio-terminal-phosphor bg-channel-portfolio-terminal-phosphor/5 p-4"
			>
				<div
					class="text-channel-portfolio-terminal-phosphor font-bold tracking-widest text-xs mb-3 uppercase"
				>
					{tCli('easter.statsTitle')}
				</div>
				<div class="space-y-2 text-xs">
					{
						easterRows.map(({ label, value, color }) => (
							<div class="flex justify-between gap-4">
								<span class="text-channel-portfolio-terminal-content/50 shrink-0">
									{label}
								</span>
								<span style={`color: ${color}`}>{value}</span>
							</div>
						))
					}
				</div>
				<p class="mt-4 text-xs text-channel-portfolio-terminal-content/70">
					{tCli('easter.footer')}
				</p>
				<div class="mt-4 grid grid-cols-2 gap-2">
					<a
						href={emailHref}
						class="px-3 py-2 text-center border border-channel-portfolio-terminal-phosphor text-channel-portfolio-terminal-phosphor hover:bg-channel-portfolio-terminal-phosphor/10"
					>
						{tCli('easter.hire')}
					</a>
					<button
						id="egg-close"
						type="button"
						class="px-3 py-2 border border-channel-portfolio-terminal-cyan text-channel-portfolio-terminal-cyan hover:bg-channel-portfolio-terminal-cyan/10"
					>
						{tCli('easter.close')}
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import { setupCliTerminal } from '../model/runtime';

	setupCliTerminal();
	document.addEventListener('astro:page-load', setupCliTerminal);
</script>

<style>
	.terminal-grid {
		background: repeating-linear-gradient(
			0deg,
			transparent,
			transparent 2px,
			var(--color-channel-portfolio-terminal-grid) 2px,
			var(--color-channel-portfolio-terminal-grid) 4px
		);
	}

	:global(body.matrix-mode)::before {
		content: '';
		position: fixed;
		inset: 0;
		z-index: 40;
		pointer-events: none;
		background: repeating-linear-gradient(
			90deg,
			transparent,
			transparent 24px,
			var(--color-channel-portfolio-terminal-grid) 25px
		);
		opacity: 0.4;
	}

	@media (prefers-reduced-motion: reduce) {
		.animate-pulse {
			animation: none;
		}
	}
</style>
