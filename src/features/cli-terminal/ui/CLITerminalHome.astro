---
import { getPathByLocale } from 'astro:i18n';
import CLITerminalCatalog from './CLITerminalCatalog.astro';

const pathnameSegments = Astro.url.pathname.split('/').filter(Boolean);
const localePath = Astro.currentLocale ? getPathByLocale(Astro.currentLocale) : '';
const isHome =
	pathnameSegments.length === 0 ||
	(pathnameSegments.length === 1 && pathnameSegments[0] === localePath);
---

{isHome && <CLITerminalCatalog />}
