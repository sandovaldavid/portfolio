---
interface Props {
	enabled?: boolean;
}

const { enabled = true } = Astro.props;
---

<div id="section-scroll-controller" data-enabled={enabled ? 'true' : 'false'}></div>

<script>
	let sectionScrollCleanup: (() => void) | null = null;

	function setupSectionScroll() {
		sectionScrollCleanup?.();
		sectionScrollCleanup = null;

		const controller = document.getElementById('section-scroll-controller');
		if (!controller || controller.dataset.enabled !== 'true') return;

		const isHome =
			document.body.dataset.isHome === 'true' ||
			Boolean(document.querySelector('main #experience'));
		if (!isHome) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const sections = ['hero', 'experience', 'projects', 'research', 'about-me', 'contact']
			.map(id => document.getElementById(id))
			.filter((section): section is HTMLElement => section instanceof HTMLElement);
		if (sections.length < 2) return;

		const HEADER_HEIGHT = 72;
		const POSITION_TOLERANCE = 8;
		const WHEEL_THRESHOLD = 15;
		const WHEEL_QUIET_PERIOD = 120;
		const MAX_NAVIGATION_TIME = 1600;

		let isNavigating = false;
		let navigationTargetY = 0;
		let navigationStartedAt = 0;
		let lastWheelAt = 0;
		let settleFrame: number | undefined;

		const getMaxScrollY = () =>
			Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
		const getTargetY = (section: HTMLElement) =>
			Math.min(getMaxScrollY(), Math.max(0, section.offsetTop - HEADER_HEIGHT));

		const elementCanScrollVertically = (start: HTMLElement, deltaY: number) => {
			let element: HTMLElement | null = start;

			while (element && element !== document.body && element !== document.documentElement) {
				if (element.matches('[role="dialog"], #cli-terminal')) return true;

				const { overflowY } = window.getComputedStyle(element);
				const supportsVerticalScroll =
					/(auto|scroll|overlay)/.test(overflowY) &&
					element.scrollHeight > element.clientHeight + 1;

				if (supportsVerticalScroll) {
					if (
						deltaY > 0 &&
						element.scrollTop + element.clientHeight < element.scrollHeight - 1
					) {
						return true;
					}
					if (deltaY < 0 && element.scrollTop > 1) return true;
				}

				element = element.parentElement;
			}

			return false;
		};

		const findDirectionalTarget = (direction: 1 | -1) => {
			const currentY = window.scrollY;
			const positionedSections = sections.map(section => ({ section, y: getTargetY(section) }));

			if (direction > 0) {
				return positionedSections.find(({ y }) => y > currentY + POSITION_TOLERANCE)?.section;
			}

			return [...positionedSections]
				.reverse()
				.find(({ y }) => y < currentY - POSITION_TOLERANCE)?.section;
		};

		const stopNavigationTracking = () => {
			if (settleFrame !== undefined) window.cancelAnimationFrame(settleFrame);
			settleFrame = undefined;
			isNavigating = false;
		};

		const trackNavigationSettlement = () => {
			const tick = (now: number) => {
				const reachedTarget = Math.abs(window.scrollY - navigationTargetY) <= 2;
				const wheelIsQuiet = now - lastWheelAt >= WHEEL_QUIET_PERIOD;
				const timedOut = now - navigationStartedAt >= MAX_NAVIGATION_TIME;

				if ((reachedTarget && wheelIsQuiet) || timedOut) {
					stopNavigationTracking();
					return;
				}

				settleFrame = window.requestAnimationFrame(tick);
			};

			settleFrame = window.requestAnimationFrame(tick);
		};

		const scrollToSection = (section: HTMLElement) => {
			stopNavigationTracking();
			isNavigating = true;
			navigationTargetY = getTargetY(section);
			navigationStartedAt = performance.now();
			lastWheelAt = navigationStartedAt;

			window.scrollTo({ top: navigationTargetY, behavior: 'smooth' });
			trackNavigationSettlement();
		};

		const onWheel = (event: WheelEvent) => {
			if (window.innerWidth < 768) return;
			if (Math.abs(event.deltaY) < WHEEL_THRESHOLD) return;
			if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;

			const target = event.target instanceof HTMLElement ? event.target : null;
			if (target && elementCanScrollVertically(target, event.deltaY)) return;

			if (isNavigating) {
				lastWheelAt = performance.now();
				event.preventDefault();
				return;
			}

			const direction: 1 | -1 = event.deltaY > 0 ? 1 : -1;
			const targetSection = findDirectionalTarget(direction);

			// Core Stack stays content-driven rather than becoming a viewport snap target.
			// The directional Home journey closes explicitly from About Me to Contact,
			// while any position inside the compact tail resolves upward to About Me
			// and downward to the Footer.
			if (!targetSection) return;

			event.preventDefault();
			scrollToSection(targetSection);
		};

		window.addEventListener('wheel', onWheel, { passive: false });
		sectionScrollCleanup = () => {
			window.removeEventListener('wheel', onWheel);
			stopNavigationTracking();
		};
	}

	setupSectionScroll();
	document.addEventListener('astro:page-load', setupSectionScroll);
</script>
