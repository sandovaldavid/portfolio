---
interface Props {
	enabled?: boolean;
}

const { enabled = true } = Astro.props;
---

<div id="section-scroll-controller" data-enabled={enabled ? 'true' : 'false'}></div>

<script>
	let sectionScrollCleanup: (() => void) | null = null;

	function setupSectionScroll() {
		sectionScrollCleanup?.();
		sectionScrollCleanup = null;

		const controller = document.getElementById('section-scroll-controller');
		if (!controller || controller.dataset.enabled !== 'true') return;

		const isHome =
			document.body.dataset.isHome === 'true' ||
			Boolean(document.querySelector('main #experience'));
		if (!isHome) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const sections = Array.from(
			document.querySelectorAll<HTMLElement>('main > div > section[id], footer[id]')
		);
		if (sections.length < 2) return;

		let isThrottled = false;
		let throttleTimer: number | undefined;
		const getHeaderHeight = () => 72;

		const getCurrentIndex = () => {
			const currentTop = window.scrollY + getHeaderHeight() + 20;
			let index = 0;
			for (let i = 0; i < sections.length; i++) {
				if (sections[i].offsetTop <= currentTop) index = i;
			}
			return index;
		};

		const scrollToSection = (targetIndex: number) => {
			if (targetIndex < 0 || targetIndex >= sections.length) return;
			isThrottled = true;
			const targetSection = sections[targetIndex];
			const targetY = targetSection.offsetTop - getHeaderHeight();

			window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });

			window.clearTimeout(throttleTimer);
			throttleTimer = window.setTimeout(() => {
				isThrottled = false;
			}, 500);
		};

		const onWheel = (event: WheelEvent) => {
			if (window.innerWidth < 768) return;

			const target = event.target as HTMLElement | null;
			if (
				target?.closest(
					'.overflow-y-auto, .overflow-auto, .overflow-x-auto, [role="dialog"], #cli-terminal'
				)
			) {
				return;
			}
			if (Math.abs(event.deltaY) < 15) return;

			if (isThrottled) {
				event.preventDefault();
				return;
			}

			const currentIndex = getCurrentIndex();
			if (event.deltaY > 0 && currentIndex < sections.length - 1) {
				event.preventDefault();
				scrollToSection(currentIndex + 1);
			} else if (event.deltaY < 0 && currentIndex > 0) {
				event.preventDefault();
				scrollToSection(currentIndex - 1);
			}
		};

		window.addEventListener('wheel', onWheel, { passive: false });
		sectionScrollCleanup = () => {
			window.removeEventListener('wheel', onWheel);
			window.clearTimeout(throttleTimer);
		};
	}

	setupSectionScroll();
	document.addEventListener('astro:page-load', setupSectionScroll);
</script>
