---
import SunIcon from '@assets/icons/Sun.astro';
import MoonIcon from '@assets/icons/Moon.astro';
import SystemIcon from '@assets/icons/System.astro';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tTheme = createScopedUiTranslator(lang, 'theme');
---

<!--
	Portfolio / Theme Toggle (Figma v2): one 40×40 cyclic control.
	Current is runtime preference state, not a menu axis:
	Light → Dark → System → Light.
-->
<button
	type="button"
	class="theme-toggle relative grid size-10 shrink-0 place-items-center rounded border-2 border-edge-strong bg-channel-surface-default p-0 text-content-strong transition-colors duration-150 hover:bg-channel-surface-highlight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus focus-visible:ring-offset-2 focus-visible:ring-offset-channel-background-canvas"
	data-theme-toggle
	data-theme-select-label={tTheme('select')}
	data-theme-light-label={tTheme('light')}
	data-theme-dark-label={tTheme('dark')}
	data-theme-system-label={tTheme('system')}
	aria-label={tTheme('select')}
>
	<span class="theme-toggle-icon" data-theme-icon="light" aria-hidden="true">
		<SunIcon class="size-5" aria-hidden="true" />
	</span>
	<span class="theme-toggle-icon" data-theme-icon="dark" aria-hidden="true">
		<MoonIcon class="size-5" aria-hidden="true" />
	</span>
	<span class="theme-toggle-icon" data-theme-icon="system" aria-hidden="true">
		<SystemIcon class="size-5" aria-hidden="true" />
	</span>
</button>

<script>
	type ThemePreference = 'light' | 'dark' | 'system';
	type ResolvedTheme = 'light' | 'dark';
	type ThemeViewTransition = {
		skipTransition: () => void;
		finished: Promise<void>;
	};
	type ViewTransitionDocument = Document & {
		startViewTransition?: (updateCallback: () => void) => ThemeViewTransition;
		activeViewTransition?: ThemeViewTransition | null;
	};

	const THEME_STORAGE_KEY = 'theme';
	const THEME_ORDER: ThemePreference[] = ['light', 'dark', 'system'];
	const darkSchemeMedia = window.matchMedia('(prefers-color-scheme: dark)');
	const reducedMotionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
	let activeThemeTransition: ThemeViewTransition | undefined;
	let themeRequestVersion = 0;

	const isThemePreference = (value: string | null): value is ThemePreference =>
		value === 'light' || value === 'dark' || value === 'system';

	const getSavedTheme = (): ThemePreference => {
		const saved = localStorage.getItem(THEME_STORAGE_KEY);
		return isThemePreference(saved) ? saved : 'dark';
	};

	const getResolvedTheme = (theme: ThemePreference): ResolvedTheme =>
		theme === 'dark' || (theme === 'system' && darkSchemeMedia.matches) ? 'dark' : 'light';

	const getNextTheme = (theme: ThemePreference): ThemePreference => {
		const index = THEME_ORDER.indexOf(theme);
		return THEME_ORDER[(index + 1) % THEME_ORDER.length] ?? 'light';
	};

	const getThemeLabel = (button: HTMLButtonElement, theme: ThemePreference): string => {
		if (theme === 'light') return button.dataset.themeLightLabel ?? '';
		if (theme === 'dark') return button.dataset.themeDarkLabel ?? '';
		return button.dataset.themeSystemLabel ?? '';
	};

	const syncThemeFavicon = (resolvedTheme: ResolvedTheme) => {
		let favicon = document.querySelector<HTMLLinkElement>('link[data-theme-favicon-active]');
		if (!favicon) {
			favicon = document.createElement('link');
			favicon.rel = 'icon';
			favicon.type = 'image/svg+xml';
			favicon.dataset.themeFaviconActive = 'true';
		}

		const source = `/favicon.${resolvedTheme}.svg`;
		if (favicon.getAttribute('href') !== source) favicon.setAttribute('href', source);

		// Keep the runtime-selected favicon as the last icon candidate. The static
		// prefers-color-scheme links remain a no-JS fallback, while this link follows
		// the Portfolio preference even when it differs from the operating system.
		document.head.append(favicon);
	};

	const syncThemeState = () => {
		const theme = getSavedTheme();
		const resolvedTheme = getResolvedTheme(theme);
		const isDark = resolvedTheme === 'dark';
		document.documentElement.classList.toggle('dark', isDark);
		document.documentElement.dataset.themeResolved = resolvedTheme;
		syncThemeFavicon(resolvedTheme);

		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(button => {
			button.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach(icon => {
				icon.dataset.themeActive = String(icon.dataset.themeIcon === theme);
			});

			const nextTheme = getNextTheme(theme);
			const selectLabel = button.dataset.themeSelectLabel ?? '';
			button.setAttribute(
				'aria-label',
				`${selectLabel}: ${getThemeLabel(button, theme)} → ${getThemeLabel(button, nextTheme)}`
			);
			button.dataset.themeCurrent = theme;
		});
	};

	const beginThemeTransition = (applyTheme: () => void) => {
		const root = document.documentElement;
		const transitionDocument = document as ViewTransitionDocument;

		if (reducedMotionMedia.matches || !transitionDocument.startViewTransition) {
			root.classList.remove('theme-transition');
			applyTheme();
			return;
		}

		// Rapid theme input should favor state correctness over stacking document
		// snapshots. Skip only the transition owned by this feature; never cancel an
		// Astro ClientRouter navigation transition that happens to be active.
		if (activeThemeTransition) {
			const previousTransition = activeThemeTransition;
			activeThemeTransition = undefined;
			previousTransition.skipTransition();
			root.classList.remove('theme-transition');
			applyTheme();
			return;
		}

		if (transitionDocument.activeViewTransition) {
			root.classList.remove('theme-transition');
			applyTheme();
			return;
		}

		root.classList.add('theme-transition');
		const transition = transitionDocument.startViewTransition(applyTheme);
		activeThemeTransition = transition;

		const clearTransition = () => {
			if (activeThemeTransition !== transition) return;
			activeThemeTransition = undefined;
			root.classList.remove('theme-transition');
		};

		void transition.finished.then(clearTransition, clearTransition);
	};

	const applyThemePreference = (currentTheme: ThemePreference, nextTheme: ThemePreference) => {
		const currentResolvedTheme = getResolvedTheme(currentTheme);
		const nextResolvedTheme = getResolvedTheme(nextTheme);
		const renderedResolvedTheme = document.documentElement.dataset.themeResolved;

		// Preference and resolved palette are separate contracts. System can resolve
		// to the palette that is already visible, so starting a document snapshot in
		// that case only re-captures identical colors and can produce a perceptible
		// flash. Update preference semantics directly unless the palette must change.
		localStorage.setItem(THEME_STORAGE_KEY, nextTheme);
		if (
			currentResolvedTheme === nextResolvedTheme ||
			renderedResolvedTheme === nextResolvedTheme
		) {
			syncThemeState();
			return;
		}

		const requestVersion = ++themeRequestVersion;
		beginThemeTransition(() => {
			if (requestVersion !== themeRequestVersion) return;
			syncThemeState();
		});
	};

	const setupThemeToggles = () => {
		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(button => {
			if (button.dataset.themeReady === 'true') return;
			button.dataset.themeReady = 'true';

			button.addEventListener('click', () => {
				const currentTheme = getSavedTheme();
				const nextTheme = getNextTheme(currentTheme);
				applyThemePreference(currentTheme, nextTheme);
			});
		});

		syncThemeState();
	};

	if (document.documentElement.dataset.themeSchemeListener !== 'ready') {
		document.documentElement.dataset.themeSchemeListener = 'ready';
		darkSchemeMedia.addEventListener('change', () => {
			if (getSavedTheme() !== 'system') return;
			const requestVersion = ++themeRequestVersion;
			beginThemeTransition(() => {
				if (requestVersion !== themeRequestVersion || getSavedTheme() !== 'system') return;
				syncThemeState();
			});
		});
	}

	setupThemeToggles();
	document.addEventListener('astro:page-load', setupThemeToggles);
</script>

<style is:global>
	.theme-toggle-icon {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		opacity: 0;
		pointer-events: none;
	}

	.theme-toggle-icon[data-theme-active='true'] {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle,
		.theme-toggle-icon {
			transition: none !important;
		}
	}
</style>
