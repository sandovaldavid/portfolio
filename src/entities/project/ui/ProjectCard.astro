---
import { Image } from 'astro:assets';
import ArrowUpRightIcon from '@assets/icons/ArrowUpRight.astro';
import { Badge, LinkButton, TechPill } from '@shared/ui';
import type { ProjectItem, ProjectLifecycle, ProjectSourceAccess } from '../model';

interface Props {
	project: ProjectItem;
	caseStudyText?: string;
	caseStudyLink?: string;
	sourceText?: string;
	newTabLabel: string;
	cardTypeText: string;
	lifecycleText: string;
	sourceAccessText: string;
	variant?: 'primary' | 'secondary';
	priority?: boolean;
	showSecondaryAction?: boolean;
	headingLevel?: 'h2' | 'h3';
}

const {
	project,
	caseStudyText,
	caseStudyLink,
	sourceText,
	newTabLabel,
	cardTypeText,
	lifecycleText,
	sourceAccessText,
	variant = 'secondary',
	priority = false,
	showSecondaryAction = true,
	headingLevel = 'h3',
} = Astro.props;

const Heading = headingLevel;
const { image, imageAlt, title, description, tags, github, category, lifecycle, sourceAccess } =
	project;
const isPrimary = variant === 'primary';
const visibleTags = tags.slice(0, 3);

const LIFECYCLE_BADGE_VARIANT: Record<
	ProjectLifecycle,
	'success' | 'info' | 'warning' | 'default'
> = {
	active: 'success',
	maintained: 'info',
	experimental: 'warning',
	archived: 'default',
	deprecated: 'default',
};
const SOURCE_BADGE_VARIANT: Record<ProjectSourceAccess, 'success' | 'default'> = {
	public: 'success',
	private: 'default',
};

const cardHeight = isPrimary
	? 'h-131.5 md:h-134.5 lg:h-116'
	: 'h-116.5 md:h-119.5 lg:h-93.5';
const mediaHeight = isPrimary ? 'h-47.5 lg:h-52.5' : 'h-32.5 lg:h-30';
---

<article class="group h-full w-full font-sans">
	<div
		class:list={[
			'relative mx-auto flex w-full max-w-85 flex-col overflow-hidden border-2 border-edge-strong bg-channel-surface-default p-0.5 shadow-retro-md transition-[box-shadow] duration-150 group-hover:shadow-retro-3xl md:max-w-92.25 lg:max-w-130',
			cardHeight,
		]}
	>
		<figure class:list={['relative w-full shrink-0 overflow-hidden', mediaHeight]}>
			<div
				class="absolute inset-x-0 top-0 z-10 flex h-7 items-center gap-1.5 bg-channel-portfolio-terminal-surface-raised px-3"
			>
				<span class="size-2 shrink-0 bg-channel-status-error" aria-hidden="true"></span>
				<span class="size-2 shrink-0 bg-channel-status-warning" aria-hidden="true"></span>
				<span class="size-2 shrink-0 bg-channel-status-success" aria-hidden="true"></span>
				<span class="ml-auto truncate text-caption font-bold text-channel-portfolio-terminal-content">
					{cardTypeText}
				</span>
			</div>
			<div class="relative h-full w-full overflow-hidden bg-channel-portfolio-terminal-surface">
				<Image
					src={image}
					width={isPrimary ? 800 : 600}
					height={isPrimary ? 500 : 380}
					class="absolute inset-0 size-full object-cover"
					decoding={priority ? 'sync' : 'async'}
					loading={priority ? 'eager' : 'lazy'}
					fetchpriority={priority ? 'high' : 'auto'}
					alt={imageAlt}
				/>
			</div>
		</figure>

		<div class="flex min-h-0 grow flex-col gap-2 px-3.5 py-2 lg:px-5">
			<div class="flex min-h-0 grow flex-col gap-2 overflow-hidden">
				<div class="flex flex-wrap items-start justify-between gap-x-2 gap-y-1">
					{
						category && (
							<p class="min-w-0 flex-1 text-editorial-label-compact uppercase text-channel-accent-primary">
								{category}
							</p>
						)
					}
					<ul
						class="flex shrink-0 flex-row flex-wrap items-center justify-end gap-1.5"
						aria-label={`${lifecycleText}, ${sourceAccessText}`}
					>
						<li>
							<Badge variant={LIFECYCLE_BADGE_VARIANT[lifecycle]} size="sm">
								{lifecycleText}
							</Badge>
						</li>
						<li class="hidden sm:block">
							<Badge variant={SOURCE_BADGE_VARIANT[sourceAccess]} size="sm">
								{sourceAccessText}
							</Badge>
						</li>
					</ul>
				</div>

				<Heading class="line-clamp-2 text-component-title text-content-strong">{title}</Heading>

				<p class="line-clamp-3 text-secondary text-content-default md:text-body lg:line-clamp-2">
					{description}
				</p>

				{
					visibleTags.length > 0 && (
						<ul class="flex flex-row flex-wrap gap-x-2 gap-y-1.5 pt-1">
							{visibleTags.map(tag => (
								<li>
									<TechPill label={tag.name} icon={tag.icon} size="sm" variant="card" />
								</li>
							))}
						</ul>
					)
				}
			</div>

			<footer class="mt-auto flex min-h-14 shrink-0 items-end gap-2 pb-3">
				{
					caseStudyText && caseStudyLink && (
						<LinkButton
							href={caseStudyLink}
							target="_self"
							class="w-44 shrink-0"
						>
							<ArrowUpRightIcon class="size-4" aria-hidden="true" />
							{caseStudyText}
						</LinkButton>
					)
				}
				{
					github && showSecondaryAction && sourceText && (
						<LinkButton
							href={github}
							{newTabLabel}
							variant="secondary"
							class="hidden w-28 shrink-0 md:inline-flex"
						>
							<ArrowUpRightIcon class="size-4" aria-hidden="true" />
							{sourceText}
						</LinkButton>
					)
				}
			</footer>
		</div>
	</div>
</article>
