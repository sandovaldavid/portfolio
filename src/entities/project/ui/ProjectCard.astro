---
import { Image } from 'astro:assets';
import ArrowUpRightIcon from '@assets/icons/ArrowUpRight.astro';
import { Badge, LinkButton, TechPill } from '@shared/ui';
import type { ProjectItem, ProjectLifecycle } from '../model';

interface Props {
	project: ProjectItem;
	caseStudyText?: string;
	caseStudyLink?: string;
	sourceText?: string;
	newTabLabel: string;
	lifecycleText: string;
	variant?: 'primary' | 'secondary';
	priority?: boolean;
	showSecondaryAction?: boolean;
	headingLevel?: 'h2' | 'h3';
}

const {
	project,
	caseStudyText,
	caseStudyLink,
	sourceText,
	newTabLabel,
	lifecycleText,
	variant = 'secondary',
	priority = false,
	showSecondaryAction = true,
	headingLevel = 'h3',
} = Astro.props;

const Heading = headingLevel;
const { image, imageAlt, title, description, tags, github, category, lifecycle } = project;
const isPrimary = variant === 'primary';
const visibleTags = tags.slice(0, 3);

const LIFECYCLE_BADGE_VARIANT: Record<
	ProjectLifecycle,
	'success' | 'info' | 'warning' | 'default'
> = {
	active: 'success',
	maintained: 'info',
	experimental: 'warning',
	archived: 'default',
	deprecated: 'default',
};

const cardHeight = isPrimary ? 'h-131.5 md:h-134.5 lg:h-116' : 'h-116.5 md:h-119.5 lg:h-93.5';
const mediaHeight = isPrimary ? 'h-47.5 lg:h-52.5' : 'h-32.5 lg:h-30';
---

<article class="group h-full w-full">
	<div
		class:list={[
			'relative mx-auto flex w-full max-w-85 flex-col overflow-hidden border-2 border-edge-strong bg-channel-surface-default p-0.5 shadow-retro-md transition-[box-shadow] duration-150 group-hover:shadow-retro-3xl md:max-w-92.25 lg:max-w-130',
			cardHeight,
		]}
	>
		<figure class:list={['relative w-full shrink-0 overflow-hidden', mediaHeight]}>
			<div
				class="absolute inset-x-0 top-0 z-10 flex h-7 items-center gap-1.5 bg-channel-portfolio-terminal-surface-raised px-3"
				aria-hidden="true"
			>
				<span class="size-2 shrink-0 bg-channel-status-error"></span>
				<span class="size-2 shrink-0 bg-channel-status-warning"></span>
				<span class="size-2 shrink-0 bg-channel-status-success"></span>
			</div>
			<div
				class="relative h-full w-full overflow-hidden bg-channel-portfolio-terminal-surface"
			>
				<Image
					src={image}
					width={isPrimary ? 800 : 600}
					height={isPrimary ? 500 : 380}
					class="absolute inset-0 size-full object-cover"
					decoding={priority ? 'sync' : 'async'}
					loading={priority ? 'eager' : 'lazy'}
					fetchpriority={priority ? 'high' : 'auto'}
					alt={imageAlt}
				/>
			</div>
		</figure>

		<div class="flex min-h-0 grow flex-col gap-2 px-3.5 py-2 lg:px-5">
			<div class="flex min-h-0 grow flex-col gap-2 overflow-hidden">
				<div class="flex items-start justify-between gap-2">
					{
						category && (
							<p class="min-w-0 flex-1 text-editorial-label-compact uppercase text-channel-accent-primary">
								{category}
							</p>
						)
					}
					<Badge variant={LIFECYCLE_BADGE_VARIANT[lifecycle]} size="sm">
						{lifecycleText}
					</Badge>
				</div>

				<Heading class="line-clamp-2 text-component-title text-content-strong"
					>{title}</Heading
				>

				<p
					class="line-clamp-3 text-secondary text-content-default md:text-body lg:line-clamp-2"
				>
					{description}
				</p>

				{
					visibleTags.length > 0 && (
						<ul class="flex flex-row flex-wrap gap-x-2 gap-y-1.5 pt-1">
							{visibleTags.map(tag => (
								<li>
									<TechPill
										label={tag.name}
										icon={tag.icon}
										size="sm"
										variant="card"
									/>
								</li>
							))}
						</ul>
					)
				}
			</div>

			<footer
				class="mt-auto flex min-h-14 w-full shrink-0 items-end justify-between gap-2 pb-3"
			>
				{
					caseStudyText && caseStudyLink && (
						<LinkButton href={caseStudyLink} target="_self" class="w-fit shrink-0 px-3">
							<ArrowUpRightIcon class="size-4" aria-hidden="true" />
							{caseStudyText}
						</LinkButton>
					)
				}
				{
					github && showSecondaryAction && sourceText && (
						<div class="hidden shrink-0 md:block">
							<LinkButton
								href={github}
								{newTabLabel}
								variant="secondary"
								class="w-fit px-3"
							>
								<ArrowUpRightIcon class="size-4" aria-hidden="true" />
								{sourceText}
							</LinkButton>
						</div>
					)
				}
			</footer>
		</div>
	</div>
</article>
