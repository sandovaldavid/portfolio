---
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
	href: string;
	class?: string;
}

const { href, class: className, ...rest } = Astro.props;
---

<a
	{href}
	class:list={[
		'inline-flex items-center font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300',
		className,
	]}
	{...rest}
>
	<slot />
</a>
