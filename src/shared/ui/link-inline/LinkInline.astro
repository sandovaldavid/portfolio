---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
	href: string;
	class?: string;
	icon?: AstroComponentFactory;
	iconPosition?: 'leading' | 'trailing';
	/** Screen-reader-only text announcing the link opens in a new tab. Omit for non-navigating targets (e.g. mailto:). */
	newTabLabel?: string;
}

const {
	href,
	class: className,
	icon: Icon,
	iconPosition = 'leading',
	newTabLabel,
	...rest
} = Astro.props;

/*
 * Link Inline contract (spec/03): height 32px, gap 6px, icon 16px,
 * Inter Medium 16, foreground accent primary. Underline decoration
 * appears on hover/focus without shifting line geometry.
 */
const iconClasses = 'size-4 shrink-0';
---

<a
	{href}
	class:list={[
		'link-inline inline-flex h-8 items-center gap-1.5 font-sans text-base font-medium text-channel-accent-primary',
		className,
	]}
	{...rest}
>
	{iconPosition === 'leading' && Icon && <Icon class={iconClasses} aria-hidden="true" />}
	<slot />
	{iconPosition === 'trailing' && Icon && <Icon class={iconClasses} aria-hidden="true" />}
	{newTabLabel && <span class="sr-only"> {newTabLabel}</span>}
</a>

<style>
	/* Contract metrics are utilities so consumers can override them predictably. */
	a:where(.link-inline):hover {
		text-decoration-line: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
		color: var(--color-channel-accent-primary-hover);
	}

	a:where(.link-inline):focus-visible {
		text-decoration-line: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
		outline: 2px solid var(--color-button-focus);
		outline-offset: 2px;
	}

	.link-inline :global(svg) {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
	}
</style>
