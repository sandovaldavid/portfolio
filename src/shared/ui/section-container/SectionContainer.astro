---
interface Props {
	class?: string;
	id?: string;
}

const { class: className, id } = Astro.props;

/**
 * Home has a deliberate viewport-section rhythm that should not leak into
 * internal pages using the same content container. These IDs are owned by the
 * Home composition in Layout. Experience and Hero use dedicated widgets
 * because their internal layout contracts are different.
 */
const HOME_VIEWPORT_SECTIONS = new Set(['projects', 'research', 'about-me', 'technologies']);
const isHomeViewportSection = Boolean(id && HOME_VIEWPORT_SECTIONS.has(id));
const homeSurface =
	id === 'research' || id === 'technologies'
		? 'bg-channel-surface-highlight'
		: 'bg-channel-background-canvas';
---

{
	isHomeViewportSection ? (
		<section id={id} class:list={['w-full max-w-none scroll-mt-18', homeSurface]}>
			<div
				data-home-viewport-shell
				class:list={[
					'mx-auto flex w-full max-w-360 flex-col justify-center px-5 md:min-h-[calc(100svh-4.5rem)] md:px-8 lg:px-20',
					className,
				]}
			>
				<slot />
			</div>
		</section>
	) : (
		<section
			{id}
			class:list={[
				'w-full max-w-360 px-5 md:px-8 lg:px-20 mx-auto',
				'flex flex-col justify-center',
				'scroll-mt-18',
				className,
			]}
		>
			<slot />
		</section>
	)
}

<style>
	[data-home-viewport-shell] :global(.title-section) {
		width: 100%;
		justify-content: center;
		text-align: center;
	}
</style>
