---
interface Props {
	class?: string;
	id?: string;
}

const { class: className, id } = Astro.props;
---

<!--
	Portfolio v2 responsive content-container contract (ADR-0009 / Figma):
	1440+ viewport -> 1440 shell / 1280 content (80px gutters)
	834 tablet      -> 834 shell  / 770 content  (32px gutters)
	390 mobile      -> 390 shell  / 350 content  (20px gutters)
	Section backgrounds belong to the owning full-width section; this primitive
	caps and centers its content mass. Consumers own vertical rhythm.
-->
<section
	{id}
	class:list={[
		'w-full max-w-[1440px] px-5 md:px-8 lg:px-20 mx-auto',
		'flex flex-col justify-center',
		'scroll-mt-[4.5rem]',
		className,
	]}
>
	<slot />
</section>
