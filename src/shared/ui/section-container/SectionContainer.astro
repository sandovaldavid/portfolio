---
interface Props {
	class?: string;
	id?: string;
}

const { class: className, id } = Astro.props;

/**
 * Home has two deliberate section rhythms that must not leak into internal
 * pages using the same content container:
 *
 * - viewport sections reserve the usable viewport from Tablet upward;
 * - compact sections keep the same full-bleed surface/content shell but size
 *   only to their content.
 *
 * Experience and Hero use dedicated widgets because their internal layout
 * contracts are different.
 */
const HOME_VIEWPORT_SECTIONS = new Set(['projects', 'research', 'about-me']);
const HOME_COMPACT_SECTIONS = new Set(['technologies']);
const isHomeViewportSection = Boolean(id && HOME_VIEWPORT_SECTIONS.has(id));
const isHomeCompactSection = Boolean(id && HOME_COMPACT_SECTIONS.has(id));
const isHomeSection = isHomeViewportSection || isHomeCompactSection;
const homeSurface =
	id === 'research' || id === 'technologies'
		? 'bg-channel-surface-highlight'
		: 'bg-channel-background-canvas';
---

{
	isHomeSection ? (
		<section id={id} class:list={['w-full max-w-none scroll-mt-18', homeSurface]}>
			<div
				data-home-section-shell
				data-home-viewport-shell={isHomeViewportSection ? 'true' : undefined}
				data-home-compact-shell={isHomeCompactSection ? 'true' : undefined}
				class:list={[
					'mx-auto flex w-full max-w-360 flex-col justify-center px-5 md:px-8 lg:px-20',
					isHomeViewportSection && 'md:min-h-[calc(100svh-4.5rem)]',
					className,
				]}
			>
				<slot />
			</div>
		</section>
	) : (
		<section
			{id}
			class:list={[
				'w-full max-w-360 px-5 md:px-8 lg:px-20 mx-auto',
				'flex flex-col justify-center',
				'scroll-mt-18',
				className,
			]}
		>
			<slot />
		</section>
	)
}
