---
interface Props {
	className?: string;
}

const { className } = Astro.props;
---

<!--
	Section Title contract (spec/03): gap 12, optional leading icon 20px,
	JetBrains Mono Bold 36/40 tracking .9px; wraps inside a 340px mobile column.
-->
<h2
	class:list={[
		'title-section mb-12 flex items-center gap-3 font-mono text-4xl font-bold leading-10 tracking-[0.9px] text-content-strong',
		className,
	]}
>
	<slot />
</h2>

<style>
	/* Leading icons lock to the 20px contract size. */
	.title-section :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
		flex-shrink: 0;
	}
</style>
