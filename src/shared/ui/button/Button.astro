---
import './button.css';

interface Props {
	id?: string;
	variant?: 'primary' | 'secondary';
	type?: 'button' | 'submit' | 'reset';
	disabled?: boolean;
	class?: string;
}

const {
	id,
	variant = 'primary',
	type = 'button',
	disabled = false,
	class: className,
} = Astro.props;
---

<button
	{id}
	{type}
	{disabled}
	class:list={['btn-base', variant === 'primary' ? 'btn-primary' : 'btn-secondary', className]}
>
	<slot />
</button>
