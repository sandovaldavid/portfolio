---
import '../button/button.css';

type Props = Omit<astroHTML.JSX.AnchorHTMLAttributes, 'href' | 'target' | 'class'> & {
	href: string;
	target?: '_blank' | '_self';
	variant?: 'primary' | 'secondary';
	disabled?: boolean;
	class?: string;
	/** Screen-reader-only text announcing the link opens in a new tab. Omit for non-navigating targets (e.g. mailto:). */
	newTabLabel?: string;
};

const {
	href,
	target = '_blank',
	variant = 'primary',
	disabled = false,
	class: className,
	newTabLabel,
	...rest
} = Astro.props;
---

<a
	{href}
	{target}
	rel={target === '_blank' ? 'noopener noreferrer' : undefined}
	role="link"
	aria-disabled={disabled ? 'true' : undefined}
	tabindex={disabled ? -1 : undefined}
	class:list={[
		'btn-base',
		variant === 'primary' ? 'btn-primary' : 'btn-secondary',
		disabled && 'btn-disabled',
		className,
	]}
	{...rest}
>
	<slot />
	{target === '_blank' && newTabLabel && <span class="sr-only"> {newTabLabel}</span>}
</a>
