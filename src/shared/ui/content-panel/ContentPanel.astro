---
interface Props {
	variant?: keyof typeof variantClasses;
	density?: 'compact' | 'standard';
	label?: string;
	title?: string;
	/** Heading level for the panel title inside the page outline. */
	headingLevel?: 'h2' | 'h3' | 'h4';
	class?: string;
}

const {
	variant = 'default',
	density = 'standard',
	label,
	title,
	headingLevel = 'h3',
	class: className,
} = Astro.props;

const Heading = headingLevel;

/*
 * Content Panel contract (spec/03 Content Panel + spec/02 component-local sizes):
 * border 2, hard shadow 3px, flex column gap 10, content-driven height with
 * min-heights only (Compact 180 / Standard 240 / Tablet 200 / Mobile 220) so
 * long translated copy grows vertically instead of clipping.
 * Widths are grid targets: Mobile 340 / Tablet 373 / Compact 420 / Standard 620.
 */
const variantClasses = {
	default: 'bg-channel-surface-default border-edge-strong',
	highlight: 'bg-channel-surface-highlight border-channel-accent-primary',
	success: 'bg-channel-surface-default border-status-success-border',
	danger: 'bg-channel-surface-default border-channel-status-error',
} as const;

const labelClasses = {
	default: 'text-channel-accent-primary',
	highlight: 'text-channel-accent-primary',
	success: 'text-status-success-text',
	danger: 'text-channel-status-error',
} as const;

const isCompact = density === 'compact';

/*
 * Desktop title scale switches on density; body copy stays 16px at every
 * density and viewport because long localized panel copy is reading text
 * under the repository's 16px reading-copy floor.
 */
const titleClasses = isCompact ? 'lg:text-[20px]' : 'lg:text-[22px]';
const minHeightClasses = isCompact ? 'lg:min-h-[180px]' : 'lg:min-h-[240px]';
const maxWidthClasses = isCompact ? 'lg:max-w-[420px]' : 'lg:max-w-[620px]';
const desktopPaddingClasses = isCompact ? 'lg:p-5' : 'lg:p-6';
---

<section
	class:list={[
		'relative flex w-full flex-col gap-2.5 overflow-hidden rounded-none border-2 shadow-retro-md',
		'max-w-[340px] min-h-[220px] px-4 py-4.5',
		'md:max-w-[373px] md:min-h-[200px]',
		maxWidthClasses,
		minHeightClasses,
		desktopPaddingClasses,
		variantClasses[variant],
		className,
	]}
>
	{
		label && (
			<span
				class:list={[
					'font-retro-tag text-xs font-bold tracking-wide',
					labelClasses[variant],
				]}
			>
				{label}
			</span>
		)
	}
	{
		title && (
			<Heading
				class:list={[
					'text-content-strong font-mono font-medium leading-snug text-lg',
					titleClasses,
				]}
			>
				{title}
			</Heading>
		)
	}
	<div class:list={['font-sans text-base leading-6 text-content-default']}>
		<slot />
	</div>
</section>
