---
interface Props {
	variant?: keyof typeof variantClasses;
	size?: keyof typeof sizeClasses;
	class?: string;
}

const { variant = 'default', size = 'md', class: className } = Astro.props;

/*
 * Badge contract (spec/03 + spec/01 "Badge variants"):
 * SM h24 px8 py2 icon12 label12; MD h28 px10 py4 icon14 label14;
 * LG h34 px12 py6 icon16 label16; gap 4, border 2 strong edge,
 * hard shadow 1.5px, width always hugs content.
 */
const variantClasses = {
	default: 'bg-badge-default-bg text-badge-default-text',
	primary: 'bg-badge-brand-bg text-badge-brand-text',
	secondary: 'bg-badge-secondary-bg text-badge-secondary-text',
	success: 'bg-status-success-bg text-status-success-text',
	warning: 'bg-badge-warning-bg text-badge-warning-text',
	danger: 'bg-badge-danger-bg text-badge-danger-text',
	info: 'bg-badge-info-bg text-badge-info-text',
	custom: '', // No default colors - use class prop for full customization
} as const;

const sizeClasses = {
	sm: 'badge-sm h-6 px-2 py-0.5 text-xs leading-[16px]',
	md: 'badge-md h-7 px-2.5 py-1 text-sm leading-[16px]',
	lg: 'badge-lg h-[34px] px-3 py-1.5 text-base leading-[18px]',
} as const;
---

<span
	class:list={[
		'badge-base inline-flex items-center gap-1 w-fit whitespace-nowrap',
		'font-mono font-bold',
		'rounded-none border-2 border-edge-strong shadow-retro-sm',
		variant !== 'custom' && variantClasses[variant],
		sizeClasses[size],
		className,
	]}
>
	<slot />
</span>

<style>
	/* Slot icons lock to the per-size contract dimensions (12/14/16px). */
	.badge-base :global(svg) {
		flex-shrink: 0;
	}

	.badge-sm :global(svg) {
		width: 0.75rem;
		height: 0.75rem;
	}

	.badge-md :global(svg) {
		width: 0.875rem;
		height: 0.875rem;
	}

	.badge-lg :global(svg) {
		width: 1rem;
		height: 1rem;
	}
</style>
