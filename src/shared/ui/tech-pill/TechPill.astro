---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

interface Props {
	label: string;
	icon?: AstroComponentFactory; // Astro component for optional icon
	href?: string; // Optional link for the pill
	size?: 'sm' | 'md';
	variant?: 'card' | 'stack';
	class?: string;
	/** Screen-reader-only text announcing the link opens in a new tab. Omit for non-navigating targets (e.g. mailto:). */
	newTabLabel?: string;
}
const {
	label,
	icon: Icon,
	href,
	size = 'md',
	variant = 'card',
	class: additionalClasses = '',
	newTabLabel,
} = Astro.props;

/*
 * Tech Pill contract (spec/03): border 2 strong edge, hard shadow 1.5px,
 * optional 24px icon, min-width driven so long translated labels never clip.
 * Card SM h30/min126/px12/gap6 default surface label 12
 * Card MD h30/min138/px12/gap6 default surface label 14
 * Stack SM h34/min124/px10/gap8 highlight surface label 12
 * Stack MD h46/min156/px20/gap8 highlight surface label 14
 */
const comboGeometry = {
	'card-sm': 'h-7.5 min-w-31.5 px-3 gap-1.5 text-xs',
	'card-md': 'h-7.5 min-w-34.5 px-3 gap-1.5 text-sm',
	'stack-sm': 'h-8.5 min-w-31 px-2.5 gap-2 text-xs',
	'stack-md': 'h-11.5 min-w-39 px-5 gap-2 text-sm',
} as const;

// Consumer-provided bg-/text- classes replace the contract surfaces (existing data-driven brand colors).
const hasBg = additionalClasses.includes('bg-');
const hasText = additionalClasses.includes('text-');

const containerClasses = [
	'tech-pill inline-flex w-fit items-center rounded-none border-2 border-edge-strong',
	'shadow-retro-sm font-mono font-bold',
	!hasText && 'text-content-strong',
	!hasBg && (variant === 'stack' ? 'bg-channel-surface-highlight' : 'bg-channel-surface-default'),
	comboGeometry[`${variant}-${size}`],
	additionalClasses,
]
	.filter(Boolean)
	.join(' ');

// Contract icon size: 24px for every combo.
const iconClasses = 'size-6 shrink-0';
---

{
	href ? (
		<a href={href} class={containerClasses} rel="noopener noreferrer" target="_blank">
			{Icon && <Icon class={iconClasses} aria-hidden="true" />}
			<span>{label}</span>
			{newTabLabel && <span class="sr-only"> {newTabLabel}</span>}
		</a>
	) : (
		<span class={containerClasses}>
			{Icon && <Icon class={iconClasses} aria-hidden="true" />}
			<span>{label}</span>
		</span>
	)
}
