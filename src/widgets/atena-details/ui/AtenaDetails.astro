---
import type { ExperienceItem } from '@entities/experience';
import { createScopedUiTranslator, Language } from '@shared/config/i18n';
import { ContentPanel, TechPill, TitleSection } from '@shared/ui';

interface Props {
	lang: Language;
	experience: ExperienceItem;
}

const { lang, experience } = Astro.props;
const tPage = createScopedUiTranslator(lang, 'pages.atena');

/*
 * Atena page composition (spec/04 "Atena" + plans/pages/atena.md):
 * Intro → Current Role (Experience Detail 740/446/360) → Role Context
 * (two Standard Content Panels 620x240) → Current Stack (Stack-MD pills)
 * → global Footer. Widths are the hard contracts; vertical rhythm stays
 * content-driven so translated copy grows without clipping.
 */
---

<div class="w-full max-w-[1280px] flex flex-col px-5 md:px-8 lg:px-0">
	<header class="flex flex-col gap-3">
		<p
			class="font-retro-tag text-xs font-bold uppercase tracking-[0.5px] text-channel-accent-primary"
		>
			{tPage('introKicker')}
		</p>
		<h1
			class="font-mono text-[40px] font-bold leading-12 tracking-[-0.5px] text-content-strong lg:text-[48px] lg:leading-14 lg:tracking-[-1px]"
		>
			{tPage('introTitle')}
		</h1>
		<p
			class="max-w-[720px] font-sans text-sm leading-[22px] text-content-default md:text-base md:leading-[26px]"
		>
			{tPage('introSummary')}
		</p>
	</header>

	<section class="pt-8 pb-14 lg:pb-16">
		<h2 class="sr-only">{tPage('roleSectionLabel')}</h2>
		<div class="mx-auto w-full max-w-[360px] md:max-w-[446px] lg:mx-0 lg:max-w-[740px]">
			<slot />
		</div>
	</section>

	<section class="pb-14 lg:pb-16">
		<TitleSection className="mb-8">{tPage('roleContextTitle')}</TitleSection>
		<div
			class="grid grid-cols-1 gap-5 md:grid-cols-2 justify-items-center md:justify-items-start"
		>
			<ContentPanel label={tPage('roleContextTitle')} title={tPage('rolePanelTitle')}>
				<p
					class="font-retro-tag text-xs font-bold uppercase tracking-wide text-channel-content-muted"
				>
					{tPage('roleTagline')}
				</p>
				<p>{tPage('roleBody')}</p>
			</ContentPanel>
			<ContentPanel
				label={tPage('confidentialityTitle')}
				title={tPage('confidentialityPanelTitle')}
			>
				<p>{tPage('confidentialityBody')}</p>
			</ContentPanel>
		</div>
	</section>

	<section class="pb-4">
		<TitleSection className="mb-8">{tPage('stackTitle')}</TitleSection>
		<ul class="flex flex-wrap gap-x-3 gap-y-3">
			{
				experience.technologies.map(technology => (
					<li>
						<TechPill label={technology} size="md" variant="stack" />
					</li>
				))
			}
		</ul>
	</section>
</div>
