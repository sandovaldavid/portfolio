---
import AngularIcon from '@assets/technologies/Angular.astro';
import AstroIcon from '@assets/technologies/AstroIcon.astro';
import CSharpIcon from '@assets/technologies/CSharp.astro';
import DotNetIcon from '@assets/technologies/DotNet.astro';
import PostgreSQLIcon from '@assets/technologies/PostgreSQL.astro';
import TypeScriptIcon from '@assets/technologies/TypeScript.astro';
import { TechPill } from '@shared/ui';

const coreStack = [
	{ label: '.NET', icon: DotNetIcon },
	{ label: 'C#', icon: CSharpIcon },
	{ label: 'Angular', icon: AngularIcon },
	{ label: 'TypeScript', icon: TypeScriptIcon },
	{ label: 'Astro', icon: AstroIcon },
	{ label: 'PostgreSQL', icon: PostgreSQLIcon },
	{ label: 'Playwright' },
	{ label: 'GitHub Actions' },
];
---

<div class="flex w-full flex-col items-center justify-center gap-8 md:gap-10">
	<ul class="flex w-full max-w-270 flex-wrap items-center justify-center gap-4">
		{
			coreStack.map(({ label, icon }) => (
				<li>
					<TechPill label={label} icon={icon} variant="stack" size="md" />
				</li>
			))
		}
	</ul>
</div>
