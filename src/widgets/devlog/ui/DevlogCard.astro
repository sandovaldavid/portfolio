---
import type { DevlogPost } from '@entities/devlog';
import { getDevlogSlug } from '@entities/devlog';
import { EditorialCard } from '@shared/ui';

interface Props {
	post: DevlogPost;
	readMoreText: string;
	readMoreLink: string;
	/** Heading level for the card title inside the page outline. */
	headingLevel?: 'h2' | 'h3';
}

const { post, readMoreText, readMoreLink, headingLevel = 'h2' } = Astro.props;
const { title, summary, pubDate, version, tags } = post.data;
const slug = getDevlogSlug(post);
---

<EditorialCard
	typeLabel={version}
	metaText={`${pubDate.toISOString().split('T')[0]} · #${slug}`}
	datetime={pubDate.toISOString()}
	{tags}
	{title}
	description={summary}
	ctaText={readMoreText}
	ctaHref={readMoreLink}
	{headingLevel}
/>
