---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getDevlogPosts, getDevlogSlug } from '@entities/devlog';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import DevlogCard from './DevlogCard.astro';

/*
 * Devlog list composition:
 * - Shell clearance: pt-18 matches fixed navbar contract.
 * - Header: open editorial layout with kicker, title and milestone scope summary.
 * - Snapshot: version milestone metrics bar showing released and active versions.
 * - Grid: responsive 2-column retro grid bounded by the canonical 320 container.
 */
const lang = getLanguageFromLocale(Astro.currentLocale);
const tDevlog = createScopedUiTranslator(lang, 'pages.devlog');
const posts = await getDevlogPosts(lang);
const formatCount = (count: number) => String(count).padStart(2, '0');
---

<div class="w-full pt-18">
	<header
		class="w-full bg-channel-background-canvas px-5 py-8 md:px-8 md:py-10 lg:px-20 lg:py-12"
		aria-labelledby="devlog-list-title"
	>
		<div class="mx-auto grid w-full max-w-320 grid-cols-1 gap-6 lg:grid-cols-[minmax(0,720fr)_minmax(0,480fr)] lg:gap-x-20">
			<div class="flex min-w-0 flex-col gap-4 lg:gap-5">
				<p class="text-editorial-label uppercase text-channel-accent-primary">
					{tDevlog('introKicker')}
				</p>
				<h1
					id="devlog-list-title"
					class="text-page-title-mobile text-content-strong md:text-page-title"
				>
					{tDevlog('introTitle')}
				</h1>
			</div>

			<div class="flex flex-col justify-center lg:pt-10">
				<p class="text-body text-content-default">{tDevlog('introBody')}</p>
			</div>
		</div>
	</header>

	<section
		class="w-full bg-channel-background-canvas px-5 md:px-8 lg:px-20"
		aria-label={tDevlog('snapshotLabel')}
	>
		<div class="mx-auto grid w-full max-w-320 border-y border-edge-subtle bg-channel-surface-highlight sm:grid-cols-3">
			<div class="flex min-w-0 flex-col gap-1 px-4 py-4 md:px-5 md:py-5">
				<strong class="font-mono text-2xl leading-none text-content-strong md:text-3xl">
					{formatCount(posts.length)}
				</strong>
				<span class="text-editorial-label-compact uppercase text-content-muted">
					{tDevlog('snapshotMilestones')}
				</span>
			</div>
			<div class="flex min-w-0 flex-col gap-1 border-t sm:border-t-0 sm:border-l border-edge-subtle px-4 py-4 md:px-5 md:py-5">
				<strong class="font-mono text-lg font-bold leading-tight text-channel-accent-primary md:text-xl">
					v2.0.0
				</strong>
				<span class="text-editorial-label-compact uppercase text-content-muted">
					{tDevlog('snapshotActiveStatus')}
				</span>
			</div>
			<div class="flex min-w-0 flex-col gap-1 border-t sm:border-t-0 sm:border-l border-edge-subtle px-4 py-4 md:px-5 md:py-5">
				<strong class="font-mono text-lg font-bold leading-tight text-content-strong md:text-xl">
					v1.0.0
				</strong>
				<span class="text-editorial-label-compact uppercase text-content-muted">
					{tDevlog('snapshotCurrentBaseline')}
				</span>
			</div>
		</div>
	</section>

	<section
		class="w-full bg-channel-background-canvas px-5 py-10 md:px-8 md:py-12 lg:px-20 lg:py-16"
		aria-label={tDevlog('gridSectionLabel')}
	>
		<div class="mx-auto w-full max-w-320">
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8 lg:gap-8">
				{posts.map(post => (
					<DevlogCard
						{post}
						readMoreText={tDevlog('readMore')}
						readMoreLink={getRelativeLocaleUrl(lang, `devlog/${getDevlogSlug(post)}`)}
					/>
				))}
			</div>
		</div>
	</section>
</div>
