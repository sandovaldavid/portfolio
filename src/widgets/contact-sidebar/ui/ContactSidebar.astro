---
/**
 * Global floating contact shortcuts.
 * Home starts expanded and retracts after scrolling. Other pages start
 * collapsed and can be revealed from the left-edge hotspot by pointer or
 * keyboard focus.
 */
import GitHubIcon from '@assets/technologies/GitHub.astro';
import LinkedInIcon from '@assets/social-networks/LinkedIn.astro';
import LinkHubIcon from '@assets/social-networks/LinkHub.astro';
import MailIcon from '@assets/icons/Mail.astro';
import ProfileCheckIcon from '@assets/icons/ProfileCheck.astro';
import { createScopedUiTranslator, getLanguageFromLocale, Language } from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tRecruiter = createScopedUiTranslator(lang, 'recruiter');
const tFooter = createScopedUiTranslator(lang, 'footer');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/es/';
const defaultCollapsed = !isHome;

const links = [
	{
		label: tRecruiter('github'),
		href: siteConfig.social.github,
		tooltip: `@${siteConfig.social.githubUsername}`,
		external: true,
		Icon: GitHubIcon,
	},
	{
		label: tRecruiter('linkedin'),
		href: siteConfig.social.linkedin,
		tooltip: `in/${siteConfig.social.linkedinUsername}`,
		external: true,
		Icon: LinkedInIcon,
	},
	{
		label: tRecruiter('email'),
		href: `mailto:${siteConfig.email}`,
		tooltip: siteConfig.email,
		external: false,
		Icon: MailIcon,
	},
	{
		label: tFooter('linkHub'),
		href: siteConfig.social.linkHub,
		tooltip: tFooter('linkHub'),
		external: true,
		Icon: LinkHubIcon,
	},
	{
		label: tRecruiter('resume'),
		href: lang === Language.ENGLISH ? siteConfig.resume.en : siteConfig.resume.es,
		tooltip: tRecruiter('downloadResume'),
		external: true,
		Icon: ProfileCheckIcon,
	},
];
---

<aside
	id="contact-sidebar"
	class="contact-sidebar fixed left-0 top-1/2 z-40 hidden w-14 -translate-y-1/2 xl:flex"
	data-collapsed={String(defaultCollapsed)}
	data-default-collapsed={String(defaultCollapsed)}
	aria-label={tAccessibility('socialContactLinks')}
>
	<div
		id="contact-sidebar-rail"
		class="contact-sidebar-rail flex flex-col items-center"
		aria-hidden={defaultCollapsed}
		inert={defaultCollapsed ? true : undefined}
	>
		<div class="h-16 w-px bg-edge-strong opacity-60" aria-hidden="true"></div>

		<nav
			class="flex flex-col border-2 border-edge-strong bg-channel-surface-default shadow-retro-md"
			aria-label={tAccessibility('socialContactLinks')}
		>
			{
				links.map(({ label, href, tooltip, external, Icon }) => (
					<a
						href={href}
						target={external ? '_blank' : undefined}
						rel={external ? 'noopener noreferrer' : undefined}
						title={tooltip}
						aria-label={
							external ? `${label}, ${tAccessibility('externalLink')}` : label
						}
						class="group relative flex size-11 items-center justify-center border-b-2 border-edge-strong text-content-muted transition-colors duration-150 last:border-b-0 hover:bg-badge-brand-bg hover:text-channel-accent-primary focus-visible:bg-badge-brand-bg focus-visible:text-channel-accent-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-button-focus"
					>
						<Icon class="size-5" aria-hidden="true" />
						<span class="pointer-events-none absolute left-full z-50 ml-3 translate-x-1 whitespace-nowrap border-2 border-edge-strong bg-channel-surface-default px-2.5 py-1.5 text-caption text-content-strong opacity-0 shadow-retro-md transition-[opacity,transform] duration-150 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100">
							{tooltip}
						</span>
					</a>
				))
			}
		</nav>

		<div class="h-16 w-px bg-edge-strong opacity-60" aria-hidden="true"></div>
	</div>

	<button
		id="contact-sidebar-reveal"
		type="button"
		class="contact-sidebar-hotspot absolute inset-y-0 left-0 grid w-6 cursor-pointer place-items-center bg-transparent opacity-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
		aria-label={tRecruiter('showContactShortcuts')}
		tabindex={defaultCollapsed ? 0 : -1}
	>
		<span class="h-16 w-1 bg-channel-accent-primary" aria-hidden="true"></span>
	</button>
</aside>

<style>
	.contact-sidebar-rail {
		opacity: 1;
		transform: translateX(0);
		transition:
			opacity 180ms ease-out,
			transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.contact-sidebar-hotspot {
		pointer-events: none;
		transition: opacity 160ms ease-out;
	}

	.contact-sidebar[data-collapsed='true'] .contact-sidebar-rail {
		opacity: 0;
		pointer-events: none;
		transform: translateX(calc(-100% - 0.5rem));
	}

	.contact-sidebar[data-collapsed='true'] .contact-sidebar-hotspot {
		opacity: 1;
		pointer-events: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-sidebar-rail,
		.contact-sidebar-hotspot {
			transition: none;
		}
	}
</style>

<script>
	const COLLAPSE_SCROLL_OFFSET = 96;
	let contactRailCleanup: (() => void) | null = null;

	const setContactRailCollapsed = (root: HTMLElement, collapsed: boolean) => {
		const rail = root.querySelector<HTMLElement>('#contact-sidebar-rail');
		const reveal = root.querySelector<HTMLButtonElement>('#contact-sidebar-reveal');
		if (!rail || !reveal) return;

		root.dataset.collapsed = String(collapsed);
		rail.setAttribute('aria-hidden', String(collapsed));
		rail.inert = collapsed;
		reveal.tabIndex = collapsed ? 0 : -1;
	};

	const setupContactRail = () => {
		contactRailCleanup?.();
		contactRailCleanup = null;

		const root = document.getElementById('contact-sidebar');
		if (!root) return;

		const reveal = root.querySelector<HTMLButtonElement>('#contact-sidebar-reveal');
		const rail = root.querySelector<HTMLElement>('#contact-sidebar-rail');
		if (!reveal || !rail) return;

		const collapseAtRest = root.dataset.defaultCollapsed === 'true';
		let pointerInside = false;
		let frame = 0;

		const shouldCollapse = () =>
			(collapseAtRest || window.scrollY > COLLAPSE_SCROLL_OFFSET) &&
			!pointerInside &&
			!root.contains(document.activeElement);

		const syncFromScroll = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(() => setContactRailCollapsed(root, shouldCollapse()));
		};

		const onPointerEnter = () => {
			pointerInside = true;
			setContactRailCollapsed(root, false);
		};
		const onPointerLeave = () => {
			pointerInside = false;
			if (shouldCollapse()) setContactRailCollapsed(root, true);
		};
		const onFocusIn = () => setContactRailCollapsed(root, false);
		const onFocusOut = () => {
			requestAnimationFrame(() => {
				if (shouldCollapse()) setContactRailCollapsed(root, true);
			});
		};
		const onReveal = () => {
			setContactRailCollapsed(root, false);
			requestAnimationFrame(() => rail.querySelector<HTMLAnchorElement>('a')?.focus());
		};

		root.addEventListener('pointerenter', onPointerEnter);
		root.addEventListener('pointerleave', onPointerLeave);
		root.addEventListener('focusin', onFocusIn);
		root.addEventListener('focusout', onFocusOut);
		reveal.addEventListener('click', onReveal);
		window.addEventListener('scroll', syncFromScroll, { passive: true });

		setContactRailCollapsed(root, collapseAtRest || window.scrollY > COLLAPSE_SCROLL_OFFSET);

		contactRailCleanup = () => {
			cancelAnimationFrame(frame);
			window.removeEventListener('scroll', syncFromScroll);
			root.removeEventListener('pointerenter', onPointerEnter);
			root.removeEventListener('pointerleave', onPointerLeave);
			root.removeEventListener('focusin', onFocusIn);
			root.removeEventListener('focusout', onFocusOut);
			reveal.removeEventListener('click', onReveal);
		};
	};

	setupContactRail();
	document.addEventListener('astro:page-load', setupContactRail);
</script>
