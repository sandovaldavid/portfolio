---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { createScopedUiTranslator, type Language } from '@shared/config/i18n';
import { TAGS } from '@shared/config/technology';
import { LinkButton, TechPill } from '@shared/ui';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const tPage = createScopedUiTranslator(lang, 'pages.skills');

/*
 * Skills page composition (spec/04 "Skills" + plans/pages/skills.md):
 * Intro kicker+title, then three category columns (410 wide + 24 gap
 * desktop / Frontend+Backend pairs with a full-width Tools row on tablet /
 * stacked 340 columns on mobile). Pills are Stack-SM TechPills fed by the
 * verified technology catalog; two per row at the 42px row step. The CTA is
 * left-aligned on desktop and centered below tablet, geometry unchanged on
 * hover.
 */
const categories = [
	{
		heading: tPage('frontendHeading'),
		technologies: [
			TAGS.TYPESCRIPT,
			TAGS.ANGULAR,
			TAGS.RXJS,
			TAGS.NEXTJS,
			TAGS.REACT,
			TAGS.ASTRO,
			TAGS.TAILWIND,
			TAGS.JAVASCRIPT,
			TAGS.CSS,
			TAGS.HTML,
			TAGS.BOOTSTRAP,
		],
	},
	{
		heading: tPage('backendHeading'),
		technologies: [
			TAGS.CSHARP,
			TAGS.JAVA,
			TAGS.PYTHON,
			TAGS.DJANGO,
			TAGS.EXPRESS,
			TAGS.POSTGRESQL,
			TAGS.MYSQL,
			TAGS.SQLITE,
		],
	},
	{
		heading: tPage('toolsHeading'),
		technologies: [TAGS.CLOUDINARY, TAGS.SANITY, TAGS.CHARTJS, TAGS.MARKDOWN],
	},
];
---

<div class="w-full px-5 md:px-8 lg:px-0">
	{
		/* Inner container sits below #main-content's depth-2 max-width reset so
	    the 1280px category grid actually applies on wide screens. */
	}
	<div class="mx-auto flex w-full max-w-[1280px] flex-col">
		<header class="flex flex-col gap-3" aria-labelledby="skills-page-title">
			<p class="text-editorial-label uppercase tracking-[0.5px] text-channel-accent-primary">
				{tPage('introKicker')}
			</p>
			<h1
				id="skills-page-title"
				class="font-mono text-[40px] font-bold leading-12 tracking-[-0.5px] text-content-strong lg:text-[48px] lg:leading-14 lg:tracking-[-1px]"
			>
				{tPage('heading')}
			</h1>
		</header>

		<section
			class="grid grid-cols-1 gap-5 pt-10 md:grid-cols-2 lg:grid-cols-[repeat(3,minmax(0,410px))] lg:gap-x-6 lg:gap-y-6 lg:pt-12"
			aria-label={tPage('categoriesSectionLabel')}
		>
			{
				categories.map((category, categoryIndex) => (
					<article
						class:list={[
							'flex flex-col border-2 border-edge-strong bg-channel-surface-default p-6 shadow-retro-md',
							categoryIndex === 2 && 'md:col-span-2 lg:col-span-1',
						]}
					>
						<h2 class="flex h-8 items-center font-mono text-lg font-bold uppercase tracking-wide text-channel-accent-primary">
							{category.heading}
						</h2>
						<ul class="mt-[18px] grid grid-cols-2 gap-2">
							{category.technologies.map(technology => (
								<li>
									<TechPill
										label={technology.name}
										icon={technology.icon}
										size="sm"
										variant="stack"
									/>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</section>

		<div class="mt-10 flex justify-center lg:mt-12 lg:justify-start">
			<LinkButton href={getRelativeLocaleUrl(lang, '')} target="_self" class="w-[190px]">
				{tPage('returnHome')}
			</LinkButton>
		</div>
	</div>
</div>
