---
import ChevronRightIcon from '@assets/icons/ChevronRight.astro';
import { createScopedUiTranslator, type Language } from '@shared/config/i18n';
import { CORE_STACK, TAGS } from '@shared/config/technology';
import { TechPill, TitleSection } from '@shared/ui';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const tPage = createScopedUiTranslator(lang, 'pages.skills');

const supportingCategories = [
	{
		heading: tPage('backendHeading'),
		technologies: [
			TAGS.CSHARP,
			TAGS.JAVA,
			TAGS.PYTHON,
			TAGS.DJANGO,
			TAGS.EXPRESS,
			TAGS.POSTGRESQL,
			TAGS.MYSQL,
			TAGS.SQLITE,
		],
	},
	{
		heading: tPage('frontendHeading'),
		technologies: [
			TAGS.TYPESCRIPT,
			TAGS.ANGULAR,
			TAGS.RXJS,
			TAGS.NEXTJS,
			TAGS.REACT,
			TAGS.ASTRO,
			TAGS.TAILWIND,
			TAGS.JAVASCRIPT,
			TAGS.CSS,
			TAGS.HTML,
			TAGS.BOOTSTRAP,
		],
	},
	{
		heading: tPage('toolsHeading'),
		technologies: [TAGS.CLOUDINARY, TAGS.SANITY, TAGS.CHARTJS, TAGS.MARKDOWN],
	},
];
---

<div class="w-full px-5 md:px-8">
	<div class="mx-auto flex w-full max-w-7xl flex-col">
		<header
			class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
			aria-labelledby="skills-page-title"
		>
			<div class="flex flex-col gap-3">
				<p class="text-editorial-label uppercase text-channel-accent-primary">
					<span aria-hidden="true">[ </span>{tPage('introKicker')}<span aria-hidden="true"> ]</span>
				</p>
				<h1
					id="skills-page-title"
					class="text-page-title-mobile text-channel-content-strong lg:text-page-title"
				>
					{tPage('heading')}
				</h1>
			</div>

			<p class="max-w-md text-editorial-label uppercase text-channel-content-muted md:text-right">
				<span aria-hidden="true">[ </span>{tPage('currentStackLabel')}<span aria-hidden="true"> ]</span>
			</p>
		</header>

		<section
			class="mt-16 md:mt-20"
			aria-labelledby="skills-core-stack-title"
			data-skills-core-stack
		>
			<TitleSection className="uppercase">
				<ChevronRightIcon class="text-channel-accent-primary" aria-hidden="true" />
				<span id="skills-core-stack-title">{tPage('coreStackHeading')}</span>
			</TitleSection>

			<ul class="mt-6 flex flex-wrap items-center gap-4" role="list">
				{
					CORE_STACK.map(({ name, icon }) => (
						<li>
							<TechPill label={name} icon={icon} size="md" variant="stack" />
						</li>
					))
				}
			</ul>
		</section>

		<section
			class="mt-16 md:mt-20"
			aria-labelledby="skills-supporting-technologies-title"
			data-skills-supporting
		>
			<TitleSection className="uppercase">
				<ChevronRightIcon class="text-channel-accent-primary" aria-hidden="true" />
				<span id="skills-supporting-technologies-title">{tPage('supportingHeading')}</span>
			</TitleSection>

			<div
				class="mt-6 grid grid-cols-1 gap-x-12 gap-y-10 md:grid-cols-2 lg:gap-x-16 lg:gap-y-12"
				aria-label={tPage('categoriesSectionLabel')}
			>
				{
					supportingCategories.map((category, categoryIndex) => (
						<article
							data-skills-category
							class:list={[
								'min-w-0',
								categoryIndex === 2 && 'md:col-span-2 lg:col-span-1',
							]}
						>
							<h3 class="text-subheading uppercase text-channel-accent-primary">
								<span aria-hidden="true">[ </span>{category.heading}<span aria-hidden="true"> ]</span>
							</h3>
							<ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4" role="list">
								{category.technologies.map(technology => (
									<li class="min-w-0">
										<TechPill
											label={technology.name}
											icon={technology.icon}
											size="sm"
											variant="stack"
										/>
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</section>
	</div>
</div>
