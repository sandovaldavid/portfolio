---
import ArrowRightIcon from '@assets/icons/ArrowRight.astro';
import BrainIcon from '@assets/icons/Brain.astro';
import { getResearchContent } from '@entities/research';
import { createScopedUiTranslator, Language } from '@shared/config/i18n';
import { Badge, ContentPanel, TechPill, TitleSection } from '@shared/ui';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const research = await getResearchContent(lang);
const tPage = createScopedUiTranslator(lang, 'pages.research');

const metrics = [
	{ prefix: 'ACC', text: research.metrics.accuracy },
	{ prefix: 'F1', text: research.metrics.f1 },
	{ prefix: 'AUC', text: research.metrics.auc },
	{ prefix: 'LOSS', text: research.metrics.loss },
];

/*
 * Research page composition (spec/04 "Research" + plans/pages/research.md):
 * Hero with left accent bar (10px desktop/tablet, 8px mobile) → two-column
 * content (primary 760 / secondary 492, stacked below lg) → Keywords pill row
 * → global Footer. All claims come from the localized research content
 * collection unchanged; the layout only restructures them.
 */
---

<div class="w-full max-w-[1280px] flex flex-col">
	<header class="relative mx-5 py-10 md:mx-8 lg:mx-0" aria-labelledby="research-title">
		<span
			class="absolute inset-y-0 left-0 w-2 bg-channel-accent-primary md:w-2.5"
			aria-hidden="true"></span>
		<div class="flex flex-col gap-4 pl-2 lg:gap-6 lg:pl-4">
			<span
				class="font-retro-tag text-xs font-bold uppercase tracking-[0.5px] text-channel-content-muted lg:leading-[22px]"
			>
				{research.institution} · {research.label}
			</span>
			<h1
				id="research-title"
				class="font-mono text-[40px] font-bold leading-12 tracking-[-0.5px] text-content-strong lg:h-[168px] lg:max-w-[1120px] lg:text-[48px] lg:leading-14 lg:tracking-[-1px]"
			>
				{research.title}
			</h1>
			<Badge variant="success" size="md">{research.status}</Badge>
		</div>
	</header>

	<div
		class="mx-5 mt-12 grid grid-cols-1 gap-5 md:mx-8 lg:mt-16 lg:grid-cols-[minmax(0,760fr)_minmax(0,492fr)] lg:gap-7"
	>
		<div class="flex min-w-0 flex-col gap-5">
			<ContentPanel
				headingLevel="h2"
				label={tPage('problemLabel')}
				title={tPage('problemTitle')}
			>
				<p>{research.problem}</p>
			</ContentPanel>

			<ContentPanel
				headingLevel="h2"
				label={tPage('hypothesisLabel')}
				title={tPage('hypothesisTitle')}
			>
				<p class="italic">“{research.hypothesis}”</p>
			</ContentPanel>

			<ContentPanel
				headingLevel="h2"
				label={tPage('approachLabel')}
				title={tPage('approachTitle')}
			>
				<p>{research.approach}</p>
			</ContentPanel>

			<div
				class="flex w-full max-w-[620px] flex-col gap-3 border-2 border-channel-accent-primary bg-channel-surface-highlight p-5 shadow-retro-md"
			>
				<span
					class="font-retro-tag text-xs font-bold tracking-wide text-channel-accent-primary"
				>
					{tPage('pipelineLabel')}
				</span>
				<ul
					class="flex flex-col items-start gap-2 sm:flex-row sm:flex-wrap sm:items-center"
				>
					{
						research.pipelineSteps.map((step, index) => (
							<li class="flex items-center gap-2">
								<TechPill label={step} size="sm" variant="card" />
								{index < research.pipelineSteps.length - 1 && (
									<ArrowRightIcon
										class="hidden size-3.5 shrink-0 text-channel-accent-primary sm:block"
										aria-hidden="true"
										focusable="false"
									/>
								)}
							</li>
						))
					}
				</ul>
			</div>

			<ContentPanel headingLevel="h2" label={tPage('engineeredFeaturesLabel')}>
				<ul class="grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2">
					{
						research.engineeredFeatures.map(feature => (
							<li class="flex items-start gap-2">
								<span
									class="mt-[7px] size-1.5 shrink-0 bg-channel-accent-primary"
									aria-hidden="true"
								/>
								<span>{feature}</span>
							</li>
						))
					}
				</ul>
			</ContentPanel>

			<ContentPanel headingLevel="h2" label={tPage('datasetLabel')}>
				<p>{research.dataset}</p>
			</ContentPanel>
		</div>

		<div class="flex min-w-0 flex-col items-start gap-5">
			<ContentPanel headingLevel="h2" label={tPage('architectureLabel')} class="w-full">
				<ul class="flex flex-col gap-2">
					{
						research.architecture.map(item => (
							<li class="flex items-start justify-between gap-4 border border-edge-subtle px-3 py-2.5 text-sm">
								<span class="shrink-0 font-mono text-xs font-bold uppercase tracking-wide text-channel-accent-primary">
									{item.label}
								</span>
								<span class="text-right leading-snug">{item.value}</span>
							</li>
						))
					}
				</ul>
			</ContentPanel>

			<ContentPanel headingLevel="h2" label={tPage('metricsLabel')} class="w-full">
				<ul class="flex flex-col gap-2.5">
					{
						metrics.map(({ prefix, text }) => (
							<li class="flex items-start gap-2">
								<span class="shrink-0 bg-channel-accent-primary px-2 py-1 font-pixel-clean text-sm font-bold uppercase leading-none text-button-primary-content">
									{prefix}
								</span>
								<span class="text-sm leading-snug">{text}</span>
							</li>
						))
					}
				</ul>
			</ContentPanel>

			<ContentPanel
				headingLevel="h2"
				density="compact"
				variant="success"
				label={tPage('statusLabel')}
				class="w-full"
			>
				<span
					class="flex items-center gap-2 font-retro-tag text-xs font-bold uppercase tracking-wide text-status-success-text"
				>
					<span class="size-2 shrink-0 bg-status-success-text" aria-hidden="true"></span>
					{research.status}
				</span>
				<p>{research.currentStatus}</p>
			</ContentPanel>
		</div>
	</div>

	<section class="mx-5 mt-14 pb-4 md:mx-8 lg:mx-0 lg:mt-16" aria-label={tPage('keywordsLabel')}>
		<TitleSection className="mb-8"><BrainIcon />{tPage('keywordsLabel')}</TitleSection>
		<ul class="flex flex-wrap gap-3">
			{
				research.keywords.map(keyword => (
					<li>
						<TechPill label={keyword} size="sm" variant="card" />
					</li>
				))
			}
		</ul>
	</section>
</div>
