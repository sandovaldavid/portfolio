---
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';
import HeroProfileRecord from './HeroProfileRecord.astro';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tHero = createScopedUiTranslator(lang, 'sections.hero');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');

const profileFacts = [
	{ id: 'role', label: tHero('roleLabel'), value: tHero('role') },
	{ id: 'stack', label: tHero('stackLabel'), value: tHero('stack') },
	{ id: 'location', label: tHero('locationLabel'), value: tHero('location') },
	{ id: 'work-mode', label: tHero('workModeLabel'), value: tHero('workMode') },
	{ id: 'current', label: tHero('currentLabel'), value: tHero('current') },
	{ id: 'domain', label: tHero('domainLabel'), value: tHero('domain') },
];
---

<!--
	Portfolio / Home Hero (Figma v2)
	Desktop: viewport-like min-height below the 72px header, 80px gutters.
	Tablet/Mobile: content-driven. Mobile uses the 360px wide-component contract.
	The availability banner is the single availability signal.
-->
<section
	id="hero"
	class="flex w-full scroll-mt-[4.5rem] flex-col items-center gap-5 bg-channel-background-canvas px-4 py-10 md:gap-6 md:px-8 md:py-12 lg:min-h-[calc(100svh-4.5rem)] lg:justify-center lg:px-20"
	aria-labelledby="hero-title"
>
	<div
		class="flex h-[52px] w-full max-w-[360px] items-center justify-center border-2 border-dashed border-banner-border bg-badge-brand-bg px-4 text-center text-caption text-banner-text md:h-[38px] md:max-w-[766px] md:text-editorial-label lg:max-w-[956px]"
	>
		{tHero('banner')}
	</div>

	<div
		class="flex w-full max-w-[360px] flex-col items-center gap-3 text-center md:max-w-[766px] md:gap-4 lg:max-w-[956px]"
	>
		<p class="w-full text-editorial-label text-channel-accent-primary">
			{tHero('title')}
		</p>

		<h1
			id="hero-title"
			class="w-full text-page-title-mobile text-content-strong md:text-hero-display"
		>
			{siteConfig.name}
		</h1>

		<p class="w-full text-subheading text-channel-content-default">
			{tHero('subtitle')}
		</p>

		<p class="w-full text-body text-channel-content-muted">
			{tHero('credential')}
		</p>
	</div>

	<HeroProfileRecord
		portraitSrc="/profile/perfil.webp"
		portraitAlt={tAccessibility('profileImageAlt')}
		name={siteConfig.name}
		role={tHero('role')}
		heading={tHero('profile')}
		facts={profileFacts}
	/>
</section>
