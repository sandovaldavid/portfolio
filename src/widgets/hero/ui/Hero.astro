---
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';
import HeroProfileRecord from './HeroProfileRecord.astro';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tHero = createScopedUiTranslator(lang, 'sections.hero');
const tCommon = createScopedUiTranslator(lang, 'common');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');

const profileFacts = [
	{ label: tHero('roleLabel'), value: tHero('role') },
	{ label: tHero('stackLabel'), value: tHero('stack') },
	{ label: tHero('locationLabel'), value: tHero('location') },
	{ label: tHero('workModeLabel'), value: tHero('workMode') },
	{ label: tHero('currentLabel'), value: tHero('current') },
	{ label: tHero('researchLabel'), value: tHero('research') },
];
---

<section
	id="hero"
	class="w-full lg:min-h-[calc(100svh-4.5rem)] scroll-mt-[4.5rem] hero-gradient flex flex-col items-center justify-start md:justify-center py-8 md:py-12 px-4"
	aria-labelledby="hero-title"
>
	<div class="w-full max-w-[956px] flex flex-col items-center gap-8 md:gap-10">
		<div
			class="w-full text-left md:text-center border-2 border-dashed border-banner-border p-3 font-retro-tag text-xs sm:text-sm text-banner-text tracking-widest uppercase"
		>
			{tHero('banner')}
		</div>

		<div class="text-left md:text-center space-y-3">
			<span
				class="font-retro-tag text-xs uppercase tracking-widest text-primary-500 font-bold block"
			>
				{tHero('title')}
			</span>
			<h1
				id="hero-title"
				class="text-4xl sm:text-6xl lg:text-7xl text-content-strong font-mono font-bold normal-case tracking-[-0.028em] leading-[1.11]"
			>
				{siteConfig.name}
			</h1>
			<p class="text-lg text-content-strong font-gaming-mono tracking-wide max-w-2xl mx-auto">
				{tHero('subtitle')}
			</p>
			<p
				class="text-base text-content-muted font-gaming-mono tracking-wide max-w-3xl mx-auto"
			>
				{tHero('credential')}
			</p>
		</div>

		<HeroProfileRecord
			portraitSrc="/profile/perfil.webp"
			portraitAlt={tAccessibility('profileImageAlt')}
			name={siteConfig.name}
			role={tHero('role')}
			heading={tHero('profile')}
			availabilityLabel={tCommon('status.available')}
			facts={profileFacts}
		/>
	</div>
</section>
