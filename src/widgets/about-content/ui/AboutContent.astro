---
import type { PortfolioProfileData } from '@entities/profile';
import { createScopedUiTranslator, type Language } from '@shared/config/i18n';
import { ContentPanel, TitleSection } from '@shared/ui';

interface Props {
	lang: Language;
	profile: PortfolioProfileData;
}

const { lang, profile } = Astro.props;
const tPage = createScopedUiTranslator(lang, 'pages.about');
const tAbout = createScopedUiTranslator(lang, 'sections.about');

/*
 * About page composition (spec/04 "About" + plans/pages/about.md):
 * Intro inner grid 1280 wide — primary kicker+title w680, secondary compact
 * summary panel w520 — followed by the centered Hero Profile Record
 * (956/766/360 contract widths), three Compact biography panels across
 * (420 + 10 gap desktop / 373 pairs on tablet / 340 stacked on mobile) and
 * six Compact focus panels in a 3×2 grid (row gap 16, column gap 10).
 * Biography copy comes from the localized profile collection unchanged;
 * long paragraphs render at the 16px reading floor inside the panels.
 * The profile record itself is passed in by the route through the named
 * slot so this widget keeps importing no peer slice.
 */
---

<div class="w-full px-5 md:px-8 lg:px-0">
	{
		/* Inner container sits below #main-content's depth-2 max-width reset so
	    the 1280px intro grid actually applies on wide screens. */
	}
	<div class="mx-auto flex w-full max-w-[1280px] flex-col">
		<header
			class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,680fr)_minmax(0,520fr)] lg:gap-x-20"
			aria-labelledby="about-page-title"
		>
			<div>
				<p
					class="text-editorial-label uppercase tracking-[0.5px] text-channel-accent-primary"
				>
					{tAbout('profileRecord')}
				</p>
				<h1
					id="about-page-title"
					class="mt-2 max-w-[680px] font-mono text-[40px] font-bold leading-12 tracking-[-0.5px] text-content-strong lg:text-[48px] lg:leading-14 lg:tracking-[-1px]"
				>
					{tPage('introTitle')}
				</h1>
			</div>
			<ContentPanel density="compact" class="lg:mt-2">
				<p class="text-base leading-relaxed">{profile.summary}</p>
			</ContentPanel>
		</header>

		<section class="pt-8 lg:pt-10" aria-label={tAbout('profileTitle')}>
			<slot name="profile" />
		</section>

		<section class="pt-14 lg:pt-16">
			<p
				class="mb-2 text-editorial-label uppercase tracking-[0.5px] text-channel-content-muted"
			>
				{tPage('biographySubtitle')}
			</p>
			<TitleSection>{tAbout('biographyTitle')}</TitleSection>
			<div
				class="grid grid-cols-1 justify-items-center gap-y-5 md:grid-cols-2 md:gap-x-5 lg:grid-cols-[repeat(3,minmax(0,420px))] lg:justify-items-start lg:gap-x-2.5"
			>
				{
					profile.biography.map(paragraph => (
						<ContentPanel density="compact">
							<p class="text-base leading-relaxed">{paragraph}</p>
						</ContentPanel>
					))
				}
			</div>
		</section>

		<section class="pt-14 pb-2 lg:pt-16">
			<p
				class="mb-2 text-editorial-label uppercase tracking-[0.5px] text-channel-content-muted"
			>
				{tPage('focusSubtitle')}
			</p>
			<TitleSection>{tAbout('focusTitle')}</TitleSection>
			<div
				class="grid grid-cols-1 justify-items-center gap-y-4 md:grid-cols-2 md:gap-x-5 lg:grid-cols-[repeat(3,minmax(0,420px))] lg:justify-items-start lg:gap-x-2.5"
			>
				{
					profile.focusAreas.map(area => (
						<ContentPanel density="compact">
							<p>{area}</p>
						</ContentPanel>
					))
				}
			</div>
		</section>
	</div>
</div>
