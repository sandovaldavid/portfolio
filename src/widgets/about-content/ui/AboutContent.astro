---
import type { PortfolioProfileData } from '@entities/profile';
import { createScopedUiTranslator, type Language } from '@shared/config/i18n';
import { TitleSection } from '@shared/ui';

interface Props {
	lang: Language;
	profile: PortfolioProfileData;
}

const { lang, profile } = Astro.props;
const tPage = createScopedUiTranslator(lang, 'pages.about');
const tAbout = createScopedUiTranslator(lang, 'sections.about');
---

<div class="w-full px-5 md:px-8 lg:px-0">
	<div class="mx-auto flex w-full max-w-7xl flex-col">
		<header class="max-w-4xl" aria-labelledby="about-page-title">
			<p class="text-editorial-label uppercase text-channel-accent-primary">
				{tAbout('profileRecord')}
			</p>
			<h1
				id="about-page-title"
				class="mt-2 text-page-title-mobile text-content-strong lg:text-page-title"
			>
				{tPage('introTitle')}
			</h1>
			<p
				class="mt-6 max-w-3xl border-l-2 border-channel-accent-primary pl-5 text-body text-channel-content-default md:pl-6"
			>
				{profile.summary}
			</p>
		</header>

		<section class="pt-10 lg:pt-12" aria-label={tAbout('profileTitle')}>
			<slot name="profile" />
		</section>

		<section class="pt-14 lg:pt-16">
			<div class="max-w-3xl">
				<p class="mb-2 text-editorial-label uppercase text-channel-content-muted">
					{tPage('biographySubtitle')}
				</p>
				<TitleSection className="mb-6">{tAbout('biographyTitle')}</TitleSection>
				<div class="space-y-5">
					{
						profile.biography.map(paragraph => (
							<p class="text-body text-channel-content-default">{paragraph}</p>
						))
					}
				</div>
			</div>
		</section>

		<section class="pt-14 pb-2 lg:pt-16">
			<div class="max-w-3xl">
				<p class="mb-2 text-editorial-label uppercase text-channel-content-muted">
					{tPage('focusSubtitle')}
				</p>
				<TitleSection className="mb-6">{tAbout('focusTitle')}</TitleSection>
			</div>

			<ul class="grid grid-cols-1 gap-x-10 md:grid-cols-2" role="list">
				{
					profile.focusAreas.map((area, index) => (
						<li class="flex gap-4 border-t border-channel-edge-subtle py-5">
							<span
								class="shrink-0 text-editorial-label-compact text-channel-accent-primary"
								aria-hidden="true"
							>
								{String(index + 1).padStart(2, '0')}
							</span>
							<p class="text-body text-channel-content-default">{area}</p>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</div>
