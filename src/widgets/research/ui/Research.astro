---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ArrowUpRightIcon from '@assets/icons/ArrowUpRight.astro';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { Badge, LinkButton, TechPill } from '@shared/ui';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tResearch = createScopedUiTranslator(lang, 'sections.research');
const tCommon = createScopedUiTranslator(lang, 'common');
const techStack = ['BiLSTM', 'Python', 'TensorFlow', 'GitHub API'];
const pipeline = [
	tResearch('pipeline.githubApi'),
	tResearch('pipeline.raw'),
	tResearch('pipeline.features'),
	tResearch('pipeline.sequences'),
	tResearch('pipeline.bilstm'),
	tResearch('pipeline.classifier'),
];
---

<div class="w-full">
	<div class="grid w-full min-w-0 gap-10 lg:grid-cols-[minmax(0,760px)_minmax(0,456px)] lg:gap-16">
		<div class="flex min-w-0 flex-col gap-4">
			<div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-editorial-label text-channel-accent-primary">
					{tResearch('institution')} · {tResearch('label')}
				</p>
				<Badge variant="info" size="sm">{tCommon('status.inProgress')}</Badge>
			</div>

			<h3 class="max-w-190 uppercase text-feature-title text-content-strong">
				{tResearch('title')}
			</h3>

			<p class="max-w-190 text-body text-content-default">{tResearch('summary')}</p>

			<div class="flex flex-col gap-2 pt-1">
				<p class="text-editorial-label text-channel-accent-primary">
					{tResearch('hypothesisLabel')}
				</p>
				<p class="text-subheading text-content-strong">{tResearch('hypothesisTitle')}</p>
			</div>

			<LinkButton
				href={getRelativeLocaleUrl(lang, 'research')}
				target="_self"
				variant="primary"
				class="mt-1 w-full sm:w-47.5"
			>
				<ArrowUpRightIcon class="size-4" aria-hidden="true" />
				{tResearch('viewFull')}
			</LinkButton>
		</div>

		<aside class="flex min-w-0 flex-col gap-5 lg:pt-1" aria-label={tResearch('pipelineTitle')}>
			<div class="flex flex-col gap-3">
				<h4 class="text-component-title text-content-strong">{tResearch('pipelineTitle')}</h4>
				<ol class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
					{
						pipeline.map((step, index) => (
							<li class="flex min-w-0 items-center gap-2 py-1.5">
								<span class="w-5 shrink-0 text-editorial-label-compact text-channel-accent-primary">
									{String(index + 1).padStart(2, '0')}
								</span>
								<span class="min-w-0 text-secondary text-content-default">{step}</span>
							</li>
						))
					}
				</ol>
			</div>

			<div class="flex flex-col gap-3">
				<p class="text-editorial-label text-channel-accent-primary">
					{tResearch('techStackLabel')}
				</p>
				<ul class="flex flex-wrap gap-2">
					{techStack.map(tag => (
						<li>
							<TechPill label={tag} size="sm" variant="stack" />
						</li>
					))}
				</ul>
			</div>

			<div class="h-0.5 w-full bg-edge-subtle" aria-hidden="true"></div>
			<p class="max-w-114 text-secondary text-content-muted">{tResearch('methodologyHint')}</p>
		</aside>
	</div>
</div>
