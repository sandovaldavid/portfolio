---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ArrowRightIcon from '@assets/icons/ArrowRight.astro';
import BrainIcon from '@assets/icons/Brain.astro';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tResearch = createScopedUiTranslator(lang, 'sections.research');
const tCommon = createScopedUiTranslator(lang, 'common');
const techStack = ['BiLSTM', 'Deep Learning', 'MSR', 'Python', 'TensorFlow', 'GitHub API'];
---

<section class="w-full h-full flex items-center justify-center px-4 py-6">
	<article
		class="w-full max-w-3xl border-2 border-button-border bg-channel-surface-default shadow-retro-2xl font-mono overflow-hidden"
	>
		<div
			class="border-b-2 border-button-border bg-button-primary-background px-5 py-3.5 flex items-start justify-between gap-4"
		>
			<div class="flex items-start gap-3">
				<BrainIcon class="w-5 h-5 text-button-primary-content shrink-0 mt-0.5" />
				<div>
					<p
						class="font-retro-tag text-sm uppercase tracking-widest text-button-primary-content/90 leading-none"
					>
						{tResearch('institution')} · {tResearch('label')}
					</p>
					<h3
						class="font-pixel-clean text-lg sm:text-xl font-bold text-button-primary-content uppercase leading-tight mt-1"
					>
						{tResearch('title')}
					</h3>
				</div>
			</div>
			<span
				class="shrink-0 font-retro-tag text-xs bg-button-primary-content text-button-primary-background px-2.5 py-1 font-bold uppercase tracking-widest whitespace-nowrap"
			>
				{tCommon('status.inProgress')}
			</span>
		</div>

		<div class="px-5 py-5 space-y-5">
			<p class="text-base leading-relaxed text-channel-content-strong">
				{tResearch('summary')}
			</p>

			<div>
				<h4
					class="inline-flex items-center gap-1.5 font-retro-tag text-xs font-bold text-channel-accent-primary uppercase tracking-widest mb-2.5"
				>
					<ArrowRightIcon class="size-3.5" aria-hidden="true" focusable="false" />
					{tResearch('techStackLabel')}
				</h4>
				<div class="flex flex-wrap gap-2">
					{
						techStack.map(tag => (
							<span class="font-retro-tag text-xs uppercase tracking-wider border-2 border-badge-brand-outline-border text-badge-brand-text px-3 py-1 font-bold bg-badge-brand-bg">
								{tag}
							</span>
						))
					}
				</div>
			</div>

			<div
				class="border-t-2 border-dashed border-channel-edge-subtle pt-4 flex items-center justify-between gap-4"
			>
				<p class="text-sm text-channel-content-muted leading-snug">
					{tResearch('methodologyHint')}
				</p>
				<a
					href={getRelativeLocaleUrl(lang, 'research')}
					class="shrink-0 inline-flex items-center gap-2 font-retro-tag text-xs font-bold uppercase tracking-widest px-4 py-2 bg-button-primary-background text-button-primary-content border-2 border-button-border shadow-retro-sm hover:bg-button-primary-background-hover hover:-translate-x-[1px] hover:-translate-y-[1px] hover:shadow-retro-md active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all whitespace-nowrap"
				>
					{tResearch('viewFull')}
					<ArrowRightIcon class="size-4" aria-hidden="true" focusable="false" />
				</a>
			</div>
		</div>
	</article>
</section>
