---
import { getProjectsData, PROJECT_METADATA } from '@entities/project';
import {
	createScopedUiTranslator,
	getLanguageFromLocale,
	type Language,
} from '@shared/config/i18n';
import Projects from './Projects.astro';

interface Props {
	lang?: Language;
}

const { lang = getLanguageFromLocale(Astro.currentLocale) } = Astro.props;
const tPage = createScopedUiTranslator(lang, 'pages.projects');
const projects = await getProjectsData(lang);
const publishedProjects = projects.filter(
	project => !PROJECT_METADATA[project.projectId].developmentOnly
);
const inspectableSourceCount = publishedProjects.filter(
	project => project.sourceAccess !== 'private'
).length;
const activeProjectCount = publishedProjects.filter(project => project.lifecycle === 'active').length;
const technologyCounts = new Map<string, number>();

for (const project of publishedProjects) {
	for (const technology of project.tags) {
		technologyCounts.set(technology.name, (technologyCounts.get(technology.name) ?? 0) + 1);
	}
}

const topTechnologies = [...technologyCounts.entries()]
	.sort(([leftName, leftCount], [rightName, rightCount]) =>
		rightCount === leftCount ? leftName.localeCompare(rightName) : rightCount - leftCount
	)
	.slice(0, 4);
const formatCount = (value: number) => String(value).padStart(2, '0');
---

<div class="w-full pt-18">
	<header
		class="w-full bg-channel-background-canvas px-5 py-8 md:px-8 md:py-10 lg:px-20 lg:py-12"
		aria-labelledby="projects-catalog-title"
	>
		<div
			data-projects-catalog-intro-shell
			class="mx-auto grid w-full max-w-320 grid-cols-1 gap-4 lg:grid-cols-[minmax(0,720fr)_minmax(0,480fr)] lg:gap-x-20"
		>
			<div class="flex min-w-0 flex-col gap-4 lg:gap-5">
				<p class="text-editorial-label text-channel-accent-primary">
					{tPage('introKicker')}
				</p>
				<h1
					id="projects-catalog-title"
					class="text-page-title-mobile text-content-strong md:text-page-title"
				>
					{tPage('introTitle')}
				</h1>
			</div>

			<div class="lg:pt-10">
				<p class="text-body text-content-default">{tPage('introBody')}</p>
			</div>
		</div>
	</header>

	<section
		class="w-full bg-channel-background-canvas px-5 md:px-8 lg:px-20"
		aria-label={tPage('snapshotLabel')}
	>
		<div
			data-projects-catalog-snapshot
			class="mx-auto grid w-full max-w-320 border-y border-edge-subtle bg-channel-surface-highlight lg:grid-cols-[minmax(0,660px)_minmax(0,1fr)]"
		>
			<div class="grid grid-cols-3">
				<div class="flex min-w-0 flex-col gap-1 px-3 py-4 md:px-5 md:py-5">
					<strong class="font-mono text-2xl leading-none text-content-strong md:text-3xl">
						{formatCount(publishedProjects.length)}
					</strong>
					<span class="text-editorial-label-compact uppercase text-content-muted">
						{tPage('snapshotPublished')}
					</span>
				</div>
				<div
					class="flex min-w-0 flex-col gap-1 border-l border-edge-subtle px-3 py-4 md:px-5 md:py-5"
				>
					<strong class="font-mono text-2xl leading-none text-content-strong md:text-3xl">
						{formatCount(inspectableSourceCount)}
					</strong>
					<span class="text-editorial-label-compact uppercase text-content-muted">
						{tPage('snapshotInspectable')}
					</span>
				</div>
				<div
					class="flex min-w-0 flex-col gap-1 border-l border-edge-subtle px-3 py-4 md:px-5 md:py-5"
				>
					<strong class="font-mono text-2xl leading-none text-content-strong md:text-3xl">
						{formatCount(activeProjectCount)}
					</strong>
					<span class="text-editorial-label-compact uppercase text-content-muted">
						{tPage('snapshotActive')}
					</span>
				</div>
			</div>

			<div
				class="border-t border-edge-subtle px-4 py-4 md:px-5 md:py-5 lg:border-l lg:border-t-0"
			>
				<p class="text-editorial-label-compact uppercase text-channel-accent-primary">
					{tPage('snapshotTechnologies')}
				</p>
				<ul class="mt-3 flex flex-wrap gap-2" data-projects-top-technologies>
					{
						topTechnologies.map(([technology, count]) => (
							<li
								class="inline-flex min-h-8 items-center gap-2 border border-edge-subtle bg-channel-surface-default px-3 py-1.5 text-sm text-content-default"
							>
								<span class="font-mono font-bold text-content-strong">{technology}</span>
								<span class="font-mono text-xs text-channel-accent-primary">×{count}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section
		class="w-full bg-channel-background-canvas px-5 py-8 md:px-8 lg:px-20 lg:py-10"
		aria-label={tPage('catalogSectionLabel')}
	>
		<div
			data-projects-catalog-grid-shell
			class="mx-auto w-full max-w-85 md:max-w-192.5 lg:max-w-320"
		>
			<Projects showAll={true} layout="catalog" />
		</div>
	</section>
</div>
