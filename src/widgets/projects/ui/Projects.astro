---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ArrowUpRightIcon from '@assets/icons/ArrowUpRight.astro';
import { getProjectsData, ProjectCard } from '@entities/project';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { LinkButton } from '@shared/ui';

interface Props {
	showAll?: boolean;
	centered?: boolean;
}
const { showAll = false, centered = false } = Astro.props;

const lang = getLanguageFromLocale(Astro.currentLocale);
const tProjects = createScopedUiTranslator(lang, 'sections.projects');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const projects = await getProjectsData(lang);

const projectsToDisplay = showAll
	? projects
	: projects.filter(project => project.featured).slice(0, 2);
---

<section class="w-full font-sans">
	<div
		class:list={[
			'w-full items-stretch gap-8',
			centered
				? 'flex flex-col items-center md:flex-row md:flex-wrap md:justify-center'
				: 'grid grid-cols-1 md:grid-cols-2 lg:gap-20',
		]}
	>
		{
			projectsToDisplay.map((project, i) => (
				<div class:list={['h-full min-w-0', centered && 'w-full max-w-85 md:max-w-92.25 lg:max-w-130']}>
					<ProjectCard
						project={project}
						variant="secondary"
						headingLevel={showAll ? 'h2' : 'h3'}
						caseStudyText={tProjects('viewCaseStudy')}
						caseStudyLink={getRelativeLocaleUrl(lang, `projects/${project.slug}`)}
						sourceText={tProjects('source')}
						cardTypeText={tProjects(project.featured ? 'cardFeature' : 'cardProject')}
						lifecycleText={tProjects(`lifecycle.${project.lifecycle}`)}
						sourceAccessText={tProjects(`sourceAccess.${project.sourceAccess}`)}
						newTabLabel={tAccessibility('externalLink')}
						priority={i < 2}
					/>
				</div>
			))
		}
	</div>

	{
		!showAll && (
			<div class="mt-8 flex w-full justify-center md:mt-10">
				<LinkButton
					href={getRelativeLocaleUrl(lang, 'projects')}
					target="_self"
					variant="secondary"
					class="w-full max-w-68"
				>
					<ArrowUpRightIcon class="size-4" aria-hidden="true" />
					{tProjects('viewAll')}
				</LinkButton>
			</div>
		)
	}
</section>
