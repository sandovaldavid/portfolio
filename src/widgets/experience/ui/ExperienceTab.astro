---
import ArrowRightIcon from '@assets/icons/ArrowRight.astro';

interface Props {
	company: string;
	role: string;
	active: boolean;
	tabId: string;
	panelId: string;
	experienceId: string;
	index: number;
	selected: boolean;
	focusable: boolean;
}

const { company, role, active, tabId, panelId, experienceId, index, selected, focusable } =
	Astro.props;
---

<!--
	Portfolio / Experience Tab (Figma v2):
	Mobile 250×88 minimum, Tablet 300×88 minimum, Desktop 400×80. Company uses
	Navigation typography; role uses Caption. Text may wrap and must never be
	abbreviated. Home Experience itself uses the semantic highlight surface, so
	the runtime Hover state uses the brand-badge surface instead of the Figma
	standalone surface-highlight swatch; Active remains unambiguous through its
	strong border, accent text and indicator. Focus keeps the explicit accent
	border. State changes never shift geometry.
-->
<button
	role="tab"
	id={tabId}
	aria-controls={panelId}
	aria-selected={selected ? 'true' : 'false'}
	tabindex={focusable ? 0 : -1}
	data-index={index}
	data-experience-id={experienceId}
	data-active={active ? 'true' : 'false'}
	class="group relative flex min-h-22 w-62.5 shrink-0 cursor-pointer flex-col items-start gap-1 border-2 border-transparent bg-channel-surface-default py-2 pl-3.5 pr-4 text-left transition-[background-color,border-color] duration-200 hover:bg-badge-brand-bg focus-visible:border-channel-accent-primary focus-visible:bg-channel-surface-default focus-visible:outline-none data-[active=true]:border-edge-strong data-[active=true]:bg-badge-brand-bg md:w-75 md:px-5 lg:min-h-20 lg:w-100 lg:pl-5 lg:pr-7.5"
>
	<span
		data-experience-indicator="vertical"
		class="absolute -top-0.5 bottom-1.5 -left-0.5 hidden w-1 origin-top scale-y-0 bg-channel-accent-primary opacity-0 transition-[opacity,transform] duration-300 ease-out group-data-[active=true]:scale-y-100 group-data-[active=true]:opacity-100 motion-reduce:transition-none md:block"
		aria-hidden="true"
	></span>
	<span
		data-experience-indicator="horizontal"
		class="absolute bottom-0.5 -left-0.5 right-7 h-1 origin-left scale-x-0 bg-channel-accent-primary opacity-0 transition-[opacity,transform] duration-300 ease-out group-data-[active=true]:scale-x-100 group-data-[active=true]:opacity-100 motion-reduce:transition-none md:hidden"
		aria-hidden="true"
	></span>

	<span class="flex min-h-5 w-full min-w-0 items-center gap-2 overflow-hidden">
		<ArrowRightIcon class="size-4 shrink-0" aria-hidden="true" focusable="false" />
		<span
			class="min-w-0 uppercase text-navigation text-content-strong transition-colors duration-200 group-data-[active=true]:text-channel-accent-primary"
		>
			{company}
		</span>
	</span>
	<span class="w-full uppercase text-caption text-content-muted">{role}</span>
</button>
