---
import ChevronRightIcon from '@assets/icons/ChevronRight.astro';
import { getExperienceData } from '@entities/experience';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { TitleSection } from '@shared/ui';
import ExperienceDetail from './ExperienceDetail.astro';
import ExperienceTab from './ExperienceTab.astro';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const tExperience = createScopedUiTranslator(lang, 'sections.experience');
const EXPERIENCE = await getExperienceData(lang);
---

<section
	id="experience"
	class="w-full scroll-mt-18 overflow-x-clip bg-channel-surface-highlight"
	aria-labelledby="experience-title"
>
	<div
		data-experience-shell
		class="mx-auto grid w-full max-w-320 grid-cols-1 gap-8 px-5 py-10 md:min-h-[calc(100svh-4.5rem)] md:grid-rows-[auto_1fr] md:gap-8 md:px-8 md:py-12 lg:gap-10 lg:px-0 lg:py-14"
	>
		<TitleSection align="center" className="w-full md:mb-2">
			<ChevronRightIcon
				class="text-channel-accent-primary"
				aria-hidden="true"
				focusable="false"
			/>
			<span id="experience-title">{tExperience('sectionTitle')}</span>
		</TitleSection>

		<div
			data-experience-stage
			class="grid w-full min-w-0 grid-cols-1 items-stretch gap-6 md:self-center md:grid-cols-[280px_minmax(0,1fr)] md:gap-8 lg:grid-cols-[360px_minmax(0,1fr)] lg:gap-12"
		>
			<div
				id="experience-tablist"
				role="tablist"
				aria-label={tAccessibility('experienceTabs')}
				class="experience-tablist flex w-full min-w-0 items-stretch gap-2.5 overflow-x-auto md:flex-col md:overflow-visible md:border-y md:border-edge-subtle md:py-2"
			>
				{
					EXPERIENCE.map((exp, idx) => (
						<ExperienceTab
							company={exp.company}
							role={exp.title}
							date={exp.date}
							isCurrent={exp.isCurrent}
							selected={idx === 0}
							focusable={idx === 0}
							tabId={`exp-tab-${exp.experienceId}`}
							panelId={`exp-panel-${exp.experienceId}`}
							experienceId={exp.experienceId}
							index={idx}
						/>
					))
				}
			</div>

			<div class="experience-panels grid w-full min-w-0">
				{
					EXPERIENCE.map((exp, idx) => (
						<div
							class="experience-panel col-start-1 row-start-1 min-w-0"
							role="tabpanel"
							id={`exp-panel-${exp.experienceId}`}
							aria-labelledby={`exp-tab-${exp.experienceId}`}
							aria-hidden={idx === 0 ? 'false' : 'true'}
							data-active={idx === 0 ? 'true' : 'false'}
							data-motion="idle"
							data-experience-id={exp.experienceId}
						>
							<ExperienceDetail {...exp} />
						</div>
					))
				}
			</div>
		</div>
	</div>

	<style>
		.experience-tablist {
			scrollbar-width: none;
			-ms-overflow-style: none;
		}

		.experience-tablist::-webkit-scrollbar {
			display: none;
		}

		.experience-panel {
			opacity: 0;
			pointer-events: none;
			transform: translateY(0.5rem);
			visibility: hidden;
			will-change: opacity, transform;
			transition:
				opacity 180ms ease-out,
				transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
				visibility 0s linear 240ms;
		}

		.experience-panel[data-motion='enter-forward'] {
			transform: translateX(0.75rem);
			visibility: visible;
		}

		.experience-panel[data-motion='enter-backward'] {
			transform: translateX(-0.75rem);
			visibility: visible;
		}

		.experience-panel[data-motion='exit-forward'] {
			transform: translateX(-0.75rem);
			visibility: visible;
		}

		.experience-panel[data-motion='exit-backward'] {
			transform: translateX(0.75rem);
			visibility: visible;
		}

		.experience-panel[data-active='true'] {
			opacity: 1;
			pointer-events: auto;
			transform: translate(0, 0);
			visibility: visible;
			transition-delay: 0s;
		}

		.experience-panel[data-active='true'] [data-experience-detail-header] {
			animation: experience-detail-enter 260ms cubic-bezier(0.22, 1, 0.36, 1) 40ms both;
		}

		.experience-panel[data-active='true'] [data-experience-achievement]:nth-child(1) {
			animation: experience-detail-enter 260ms cubic-bezier(0.22, 1, 0.36, 1) 80ms both;
		}

		.experience-panel[data-active='true'] [data-experience-achievement]:nth-child(2) {
			animation: experience-detail-enter 260ms cubic-bezier(0.22, 1, 0.36, 1) 120ms both;
		}

		.experience-panel[data-active='true'] [data-experience-achievement]:nth-child(3) {
			animation: experience-detail-enter 260ms cubic-bezier(0.22, 1, 0.36, 1) 160ms both;
		}

		.experience-panel[data-active='true'] [data-experience-achievement]:nth-child(4) {
			animation: experience-detail-enter 260ms cubic-bezier(0.22, 1, 0.36, 1) 200ms both;
		}

		.experience-panel[data-active='true'] [data-experience-detail-footer] {
			animation: experience-detail-enter 260ms cubic-bezier(0.22, 1, 0.36, 1) 220ms both;
		}

		@keyframes experience-detail-enter {
			from {
				opacity: 0;
				transform: translateY(0.4rem);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		@media (min-width: 48rem) {
			.experience-tablist > [role='tab'] {
				flex: 1 1 0%;
				min-height: 0;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.experience-panel {
				transition: none;
			}

			.experience-panel[data-active='true'] [data-experience-detail-header],
			.experience-panel[data-active='true'] [data-experience-achievement],
			.experience-panel[data-active='true'] [data-experience-detail-footer] {
				animation: none;
			}
		}
	</style>

	<script>
		const setupExperienceTabs = () => {
			const tablist = document.getElementById('experience-tablist');
			if (!tablist || tablist.dataset.tabsReady === 'true') return;
			tablist.dataset.tabsReady = 'true';

			const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
			const panels = tabs.map(tab =>
				document.getElementById(tab.getAttribute('aria-controls') ?? '')
			);
			let motionResetTimer: number | undefined;

			const synchronizeSelection = (index: number) => {
				tabs.forEach((tab, tabIndex) => {
					const selected = tabIndex === index;
					tab.setAttribute('aria-selected', String(selected));
					tab.tabIndex = selected ? 0 : -1;
					tab.dataset.active = String(selected);

					const panel = panels[tabIndex];
					if (!panel) return;
					panel.dataset.active = String(selected);
					panel.setAttribute('aria-hidden', String(!selected));
					panel.inert = !selected;
				});
			};

			const activateTab = (index: number, focus = false) => {
				const currentIndex = tabs.findIndex(
					tab => tab.getAttribute('aria-selected') === 'true'
				);
				if (index < 0 || index >= tabs.length) return;

				if (currentIndex === index) {
					synchronizeSelection(index);
					if (focus) tabs[index]?.focus({ preventScroll: true });
					return;
				}

				const direction = currentIndex < index ? 'forward' : 'backward';
				const currentPanel = currentIndex >= 0 ? panels[currentIndex] : null;
				const nextPanel = panels[index];

				if (motionResetTimer !== undefined) window.clearTimeout(motionResetTimer);

				if (currentPanel) {
					currentPanel.dataset.motion = `exit-${direction}`;
					currentPanel.dataset.active = 'false';
					currentPanel.setAttribute('aria-hidden', 'true');
					currentPanel.inert = true;
				}

				tabs.forEach((tab, tabIndex) => {
					const selected = tabIndex === index;
					tab.setAttribute('aria-selected', String(selected));
					tab.tabIndex = selected ? 0 : -1;
					tab.dataset.active = String(selected);
				});

				if (nextPanel) {
					nextPanel.dataset.motion = `enter-${direction}`;
					nextPanel.dataset.active = 'false';
					nextPanel.setAttribute('aria-hidden', 'false');
					nextPanel.inert = false;
					void nextPanel.offsetWidth;
					nextPanel.dataset.active = 'true';
				}

				motionResetTimer = window.setTimeout(() => {
					if (currentPanel) currentPanel.dataset.motion = 'idle';
					if (nextPanel) nextPanel.dataset.motion = 'idle';
					motionResetTimer = undefined;
				}, 260);

				if (focus) tabs[index]?.focus({ preventScroll: true });
			};

			tabs.forEach((tab, index) => {
				tab.addEventListener('click', () => activateTab(index));
				tab.addEventListener('keydown', event => {
					let next: number;
					if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
						next = (index + 1) % tabs.length;
					} else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
						next = (index - 1 + tabs.length) % tabs.length;
					} else if (event.key === 'Home') {
						next = 0;
					} else if (event.key === 'End') {
						next = tabs.length - 1;
					} else if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault();
						activateTab(index, true);
						return;
					} else {
						return;
					}

					event.preventDefault();
					tabs[next]?.focus({ preventScroll: true });
				});
			});

			synchronizeSelection(0);
		};

		setupExperienceTabs();
		document.addEventListener('astro:page-load', setupExperienceTabs);
	</script>
</section>
