---
import ChevronRightIcon from '@assets/icons/ChevronRight.astro';
import { getExperienceData } from '@entities/experience';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { TitleSection } from '@shared/ui';
import ExperienceDetail from './ExperienceDetail.astro';
import ExperienceTab from './ExperienceTab.astro';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const tExperience = createScopedUiTranslator(lang, 'sections.experience');
const EXPERIENCE = await getExperienceData(lang);
---

<!--
	Portfolio / Home Experience (Figma v2):
	Desktop 1440 shell with 80px gutters, 56px vertical padding and a
	400 + 40 + 840 evidence grid. Tablet uses 32px gutters and 300 + 24 + 446.
	Mobile is content-driven with 20px gutters; tabs remain a horizontally
	scrollable 250px rail and the evidence detail follows below.
-->
<section
	id="experience"
	class="mx-auto flex w-full max-w-360 scroll-mt-18 flex-col items-center gap-5 bg-channel-surface-highlight px-5 py-10 md:gap-6 md:px-8 md:py-12 lg:px-20 lg:py-14"
	aria-labelledby="experience-title"
>
	<TitleSection className="w-full">
		<ChevronRightIcon class="text-channel-accent-primary" aria-hidden="true" focusable="false" />
		<span id="experience-title">{tExperience('sectionTitle')}</span>
	</TitleSection>

	<div
		class="flex w-full flex-col items-start gap-5 md:grid md:grid-cols-[300px_minmax(0,446px)] md:gap-6 lg:grid-cols-[400px_minmax(0,840px)] lg:gap-10"
	>
		<div
			id="experience-tablist"
			role="tablist"
			aria-label={tAccessibility('experienceTabs')}
			class="flex w-90 max-w-none gap-2.5 overflow-x-auto bg-channel-surface-default md:w-75 md:flex-col md:overflow-visible lg:w-100"
		>
			{
				EXPERIENCE.map((exp, idx) => (
					<ExperienceTab
						company={exp.company}
						role={exp.title}
						active={idx === 0}
						selected={idx === 0}
						focusable={idx === 0}
						tabId={`exp-tab-${exp.experienceId}`}
						panelId={`exp-panel-${exp.experienceId}`}
						experienceId={exp.experienceId}
						index={idx}
					/>
				))
			}
		</div>

		<div class="relative w-90 max-w-none md:w-111.5 lg:w-210">
			{
				EXPERIENCE.map((exp, idx) => (
					<div
						role="tabpanel"
						id={`exp-panel-${exp.experienceId}`}
						aria-labelledby={`exp-tab-${exp.experienceId}`}
						hidden={idx !== 0}
						data-active={idx === 0 ? 'true' : 'false'}
						data-experience-id={exp.experienceId}
					>
						<ExperienceDetail {...exp} />
					</div>
				))
			}
		</div>
	</div>

	<script>
		const setupExperienceTabs = () => {
			const tablist = document.getElementById('experience-tablist');
			if (!tablist || tablist.dataset.tabsReady === 'true') return;
			tablist.dataset.tabsReady = 'true';

			const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
			const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls') ?? ''));

			const activateTab = (index: number, focus = false) => {
				tabs.forEach((tab, tabIndex) => {
					const selected = tabIndex === index;
					tab.setAttribute('aria-selected', String(selected));
					tab.tabIndex = selected ? 0 : -1;
					tab.dataset.active = String(selected);

					const panel = panels[tabIndex];
					if (panel) {
						panel.hidden = !selected;
						panel.dataset.active = String(selected);
					}
				});

				if (focus) tabs[index]?.focus({ preventScroll: true });
			};

			tabs.forEach((tab, index) => {
				tab.addEventListener('click', () => activateTab(index));
				tab.addEventListener('keydown', event => {
					let next = index;
					if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
						next = (index + 1) % tabs.length;
					} else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
						next = (index - 1 + tabs.length) % tabs.length;
					} else if (event.key === 'Home') {
						next = 0;
					} else if (event.key === 'End') {
						next = tabs.length - 1;
					} else if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault();
						activateTab(index, true);
						return;
					} else {
						return;
					}

					event.preventDefault();
					tabs[next]?.focus({ preventScroll: true });
				});
			});

			activateTab(0);
		};

		setupExperienceTabs();
		document.addEventListener('astro:page-load', setupExperienceTabs);
	</script>
</section>
