---
import ChevronRightIcon from '@assets/icons/ChevronRight.astro';
import { getExperienceData } from '@entities/experience';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { TitleSection } from '@shared/ui';
import ExperienceDetail from './ExperienceDetail.astro';
import ExperienceTab from './ExperienceTab.astro';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const tExperience = createScopedUiTranslator(lang, 'sections.experience');
const EXPERIENCE = await getExperienceData(lang);
---

<!--
	Home Experience is intentionally a special viewport section. From tablet
	up it owns the usable viewport below the 72px Header, while Mobile remains
	content-driven. All detail panels share one CSS-grid cell: inactive panels
	stay visibility-hidden (not display:none), so the grid reserves the tallest
	localized panel and switching tabs never moves the rest of the page.
-->
<section
	id="experience"
	class="w-full scroll-mt-18 overflow-x-clip bg-channel-surface-highlight"
	aria-labelledby="experience-title"
>
	<div
		data-experience-shell
		class="mx-auto flex w-full max-w-360 flex-col justify-center gap-8 px-5 py-10 md:min-h-[calc(100svh-4.5rem)] md:gap-10 md:px-8 md:py-12 lg:gap-12 lg:px-20 lg:py-14"
	>
		<TitleSection align="center" className="w-full">
			<ChevronRightIcon
				class="text-channel-accent-primary"
				aria-hidden="true"
				focusable="false"
			/>
			<span id="experience-title">{tExperience('sectionTitle')}</span>
		</TitleSection>

		<div
			class="grid w-full min-w-0 grid-cols-1 items-start gap-6 md:grid-cols-[300px_minmax(0,446px)] md:gap-6 lg:grid-cols-[400px_minmax(0,840px)] lg:gap-10"
		>
			<div
				id="experience-tablist"
				role="tablist"
				aria-label={tAccessibility('experienceTabs')}
				class="experience-tablist flex w-full min-w-0 items-start gap-2.5 overflow-x-auto bg-channel-surface-default md:w-75 md:flex-col md:overflow-visible lg:w-100"
			>
				{
					EXPERIENCE.map((exp, idx) => (
						<ExperienceTab
							company={exp.company}
							role={exp.title}
							active={idx === 0}
							selected={idx === 0}
							focusable={idx === 0}
							tabId={`exp-tab-${exp.experienceId}`}
							panelId={`exp-panel-${exp.experienceId}`}
							experienceId={exp.experienceId}
							index={idx}
						/>
					))
				}
			</div>

			<div class="experience-panels grid w-full min-w-0">
				{
					EXPERIENCE.map((exp, idx) => (
						<div
							class="experience-panel col-start-1 row-start-1 min-w-0"
							role="tabpanel"
							id={`exp-panel-${exp.experienceId}`}
							aria-labelledby={`exp-tab-${exp.experienceId}`}
							aria-hidden={idx === 0 ? 'false' : 'true'}
							data-active={idx === 0 ? 'true' : 'false'}
							data-experience-id={exp.experienceId}
						>
							<ExperienceDetail {...exp} />
						</div>
					))
				}
			</div>
		</div>
	</div>

	<style>
		.experience-tablist {
			scrollbar-width: none;
			-ms-overflow-style: none;
		}

		.experience-tablist::-webkit-scrollbar {
			display: none;
		}

		.experience-panel {
			opacity: 0;
			pointer-events: none;
			transform: translateY(0.5rem);
			visibility: hidden;
			transition:
				opacity 180ms ease-out,
				transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
				visibility 0s linear 220ms;
		}

		.experience-panel[data-active='true'] {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
			visibility: visible;
			transition-delay: 0s;
		}

		@media (prefers-reduced-motion: reduce) {
			.experience-panel {
				transition: none;
			}
		}
	</style>

	<script>
		const setupExperienceTabs = () => {
			const tablist = document.getElementById('experience-tablist');
			if (!tablist || tablist.dataset.tabsReady === 'true') return;
			tablist.dataset.tabsReady = 'true';

			const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
			const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls') ?? ''));

			const activateTab = (index: number, focus = false) => {
				tabs.forEach((tab, tabIndex) => {
					const selected = tabIndex === index;
					tab.setAttribute('aria-selected', String(selected));
					tab.tabIndex = selected ? 0 : -1;
					tab.dataset.active = String(selected);

					const panel = panels[tabIndex];
					if (panel) {
						panel.dataset.active = String(selected);
						panel.setAttribute('aria-hidden', String(!selected));
						panel.inert = !selected;
					}
				});

				if (focus) tabs[index]?.focus({ preventScroll: true });
			};

			tabs.forEach((tab, index) => {
				tab.addEventListener('click', () => activateTab(index));
				tab.addEventListener('keydown', event => {
					let next = index;
					if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
						next = (index + 1) % tabs.length;
					} else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
						next = (index - 1 + tabs.length) % tabs.length;
					} else if (event.key === 'Home') {
						next = 0;
					} else if (event.key === 'End') {
						next = tabs.length - 1;
					} else if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault();
						activateTab(index, true);
						return;
					} else {
						return;
					}

					event.preventDefault();
					tabs[next]?.focus({ preventScroll: true });
				});
			});

			activateTab(0);
		};

		setupExperienceTabs();
		document.addEventListener('astro:page-load', setupExperienceTabs);
	</script>
</section>
