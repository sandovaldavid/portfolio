---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ArrowRightIcon from '@assets/icons/ArrowRight.astro';
import type { ExperienceItem as ExperienceItemData } from '@entities/experience';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { LinkInline, TechPill } from '@shared/ui';

type Props = Pick<
	ExperienceItemData,
	'title' | 'date' | 'description' | 'technologies' | 'company' | 'isCurrent'
>;

const { title, date, description, technologies, company, isCurrent } = Astro.props;
const lang = getLanguageFromLocale(Astro.currentLocale);
const tExperience = createScopedUiTranslator(lang, 'sections.experience');
const currentRoleUrl = getRelativeLocaleUrl(lang, 'atena');
const visibleTechnologies = technologies.slice(0, 3);
const companyContext = isCurrent
	? `${company.toUpperCase()} · ${tExperience('currentDomain')}`
	: company.toUpperCase();
---

<!--
	Portfolio / Experience Detail (Figma v2): open editorial evidence block,
	not a generic card. Desktop targets 840px and lays three achievements in
	columns; Tablet 446px and Mobile 360px stack them vertically. Role,
	company/date and achievements are localized source data. Only the current
	role receives the dedicated Atena CTA. Technology inventory is deliberately
	limited to three representative source-backed items on this home summary.
-->
<div class="flex w-full max-w-90 flex-col gap-3.5 md:max-w-111.5 lg:max-w-210 lg:gap-4">
	<header
		class="flex min-h-17.5 flex-col items-start gap-1 md:min-h-16 md:flex-row md:justify-between lg:min-h-15"
	>
		<h3 class="max-w-80 text-component-title text-content-strong md:w-62.5 lg:w-auto lg:max-w-none">
			{title}
		</h3>
		<p class="text-caption text-channel-status-online md:w-32 lg:w-auto">{date}</p>
	</header>

	<p class="text-editorial-label text-channel-accent-primary">{companyContext}</p>

	<div class="h-0.5 w-full bg-edge-subtle" aria-hidden="true"></div>

	<ul class="flex flex-col gap-2.5 lg:grid lg:grid-cols-3 lg:gap-6">
		{
			description.slice(0, 3).map(point => (
				<li class="flex min-w-0 items-start gap-2.5">
					<ArrowRightIcon
						class="size-4 shrink-0 text-content-strong"
						aria-hidden="true"
						focusable="false"
					/>
					<span class="min-w-0 flex-1 text-secondary text-content-default md:text-body">
						{point}
					</span>
				</li>
			))
		}
	</ul>

	<footer class="flex flex-col items-start gap-3 lg:flex-row lg:items-center lg:justify-between">
		{
			visibleTechnologies.length > 0 && (
				<ul class="flex flex-wrap gap-2">
					{visibleTechnologies.map(tech => (
						<li>
							<TechPill label={tech} size="sm" variant="stack" />
						</li>
					))}
				</ul>
			)
		}

		{
			isCurrent && (
				<LinkInline href={currentRoleUrl} icon={ArrowRightIcon} iconPosition="trailing">
					{tExperience('viewCurrentRole')}
				</LinkInline>
			)
		}
	</footer>
</div>
