---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ArrowUpRightIcon from '@assets/icons/ArrowUpRight.astro';
import { getPortfolioProfile } from '@entities/profile';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { Avatar, LinkButton } from '@shared/ui';

const lang = getLanguageFromLocale(Astro.currentLocale);
const profile = (await getPortfolioProfile(lang)).data;
const tAbout = createScopedUiTranslator(lang, 'sections.about');
const tCommon = createScopedUiTranslator(lang, 'common');
---

<div class="mx-auto flex w-full max-w-288 flex-col gap-6 md:gap-8">
	<div
		class="grid w-full min-w-0 items-center gap-8 md:grid-cols-[minmax(0,1fr)_184px] lg:grid-cols-[minmax(0,1fr)_192px]"
		data-about-profile
	>
		<div class="flex min-w-0 flex-col items-start gap-3">
			<p class="text-editorial-label text-channel-accent-primary">{tAbout('profileTitle')}</p>
			<p class="max-w-205 text-body text-content-default">{profile.summary}</p>
			<LinkButton
				href={getRelativeLocaleUrl(lang, 'about')}
				target="_self"
				variant="primary"
				class="w-fit"
			>
				<ArrowUpRightIcon class="size-4" aria-hidden="true" />
				{tAbout('readMore')}
			</LinkButton>
		</div>

		<div class="flex justify-center md:justify-end">
			<Avatar
				src="/profile/perfil.webp"
				alt={tAbout('imageAlt')}
				size="lg"
				class="size-40 md:size-46 lg:size-48"
			/>
		</div>
	</div>

	<section
		class="grid w-full min-w-0 gap-4 border-t border-edge-subtle pt-5 md:pt-6 lg:grid-cols-[200px_minmax(0,1fr)_auto] lg:items-center lg:gap-8"
		data-about-current-role
	>
		<div class="flex min-w-0 flex-col gap-2">
			<p class="text-editorial-label text-channel-accent-primary">
				{tAbout('homeCurrentLabel')}
			</p>
			<h3 class="text-subheading text-content-strong">{tAbout('homeCurrentMeta')}</h3>
		</div>

		<p class="max-w-180 text-body text-content-default">{profile.currentRoleSummary}</p>

		<LinkButton
			href={getRelativeLocaleUrl(lang, 'atena')}
			target="_self"
			variant="primary"
			class="w-fit lg:justify-self-end"
		>
			<ArrowUpRightIcon class="size-4" aria-hidden="true" />
			{tCommon('actions.viewWork')}
		</LinkButton>
	</section>
</div>
