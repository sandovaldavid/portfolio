---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';
import MailIcon from '@assets/icons/Mail.astro';
import LinkedInIcon from '@assets/social-networks/LinkedIn.astro';
import GitHubIcon from '@assets/technologies/GitHub.astro';
import LinkHubIcon from '@assets/social-networks/LinkHub.astro';
import { LinkButton } from '@shared/ui';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tFooter = createScopedUiTranslator(lang, 'footer');
const tNavigation = createScopedUiTranslator(lang, 'navigation');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');

const currentYear = new Date().getFullYear();
const newTabLabel = tAccessibility('externalLink');
const emailHref = `mailto:${siteConfig.email}`;

const socialLinks = [
	{
		name: 'GitHub',
		href: siteConfig.social.github,
		icon: GitHubIcon,
		opensNewTab: true,
	},
	{
		name: 'LinkedIn',
		href: siteConfig.social.linkedin,
		icon: LinkedInIcon,
		opensNewTab: true,
	},
	{
		name: tFooter('emailDavid'),
		href: emailHref,
		icon: MailIcon,
		opensNewTab: false,
	},
	{
		name: tFooter('linkHub'),
		href: siteConfig.social.linkHub,
		icon: LinkHubIcon,
		opensNewTab: true,
	},
];
---

<!--
	Portfolio / Footer CTA (Figma v2): full-width compact contact footer.
	Desktop/Tablet base height 372px; Mobile 452px. Content may grow under
	zoom/translation rather than clipping, so min-height is used at runtime.
-->
<footer
	id="contact"
	class="flex min-h-[452px] w-full flex-col items-center justify-between border-t-2 border-edge-strong bg-channel-background-canvas px-6 pt-10 pb-6 md:min-h-[372px]"
>
	<div class="flex w-full max-w-[900px] flex-col items-center gap-4 text-center">
		<h2 class="w-full max-w-[340px] text-section-title text-content-strong md:max-w-[900px]">
			{tFooter('title')}
		</h2>

		<p class="w-full max-w-[330px] text-secondary text-content-muted md:max-w-[900px]">
			{tFooter('subtitle')}
		</p>

		<LinkButton
			href={emailHref}
			target="_self"
			variant="primary"
			class="w-[240px] md:w-[200px]"
		>
			<MailIcon aria-hidden="true" />
			{tFooter('contact')}
		</LinkButton>

		<div class="flex items-center gap-4 pt-3" aria-label={tFooter('contact')}>
			{
				socialLinks.map(({ name, href, icon: Icon, opensNewTab }) => (
					<a
						href={href}
						target={opensNewTab ? '_blank' : undefined}
						rel={opensNewTab ? 'noopener noreferrer' : undefined}
						title={name}
						aria-label={opensNewTab ? `${name}, ${newTabLabel}` : name}
						class="grid size-11 place-items-center overflow-hidden rounded-none border-2 border-edge-strong bg-channel-surface-default text-content-strong shadow-retro-sm transition-[box-shadow,background-color,color] duration-100 hover:bg-channel-surface-highlight hover:shadow-retro-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus focus-visible:ring-offset-2 focus-visible:ring-offset-channel-background-canvas"
					>
						<Icon class="size-5" aria-hidden="true" />
					</a>
				))
			}
		</div>
	</div>

	<p class="w-full max-w-[330px] text-center text-caption uppercase text-content-muted md:max-w-[1100px]">
		© {currentYear} {siteConfig.name} · {tFooter('builtWith')} · V2.0.0 ·
		<a
			href={getRelativeLocaleUrl(lang, 'devlog')}
			class="transition-colors duration-100 hover:text-channel-accent-primary focus-visible:outline-none focus-visible:underline"
		>
			{tNavigation('devlog')}
		</a>
	</p>
</footer>
