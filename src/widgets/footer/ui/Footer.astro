---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';
import MailIcon from '@assets/icons/Mail.astro';
import LinkedInIcon from '@assets/social-networks/LinkedIn.astro';
import GitHubIcon from '@assets/technologies/GitHub.astro';
import LinkHubIcon from '@assets/social-networks/LinkHub.astro';
import CodeIcon from '@assets/icons/Code.astro';
import { LinkButton, LinkInline } from '@shared/ui';

const lang = getLanguageFromLocale(Astro.currentLocale);
const tFooter = createScopedUiTranslator(lang, 'footer');
const tNavigation = createScopedUiTranslator(lang, 'navigation');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');

const currentYear = new Date().getFullYear();
const newTabLabel = tAccessibility('externalLink');
const emailHref = `mailto:${siteConfig.email}`;

const socialLinks = [
	{
		name: 'GitHub',
		href: siteConfig.social.github,
		icon: GitHubIcon,
		opensNewTab: true,
	},
	{
		name: 'LinkedIn',
		href: siteConfig.social.linkedin,
		icon: LinkedInIcon,
		opensNewTab: true,
	},
	{
		name: tFooter('emailDavid'),
		href: emailHref,
		icon: MailIcon,
		opensNewTab: false,
	},
	{
		name: tFooter('linkHub'),
		href: siteConfig.social.linkHub,
		icon: LinkHubIcon,
		opensNewTab: true,
	},
];
---

<!--
	Footer CTA contract (spec/05 Footer + Plan 03 handoff): 440px tall on
	mobile and 360px on tablet/desktop; localized headline, supporting line,
	primary GET IN TOUCH mailto CTA (canonical Mail icon, 44px Button) and a
	direct "Email David" inline link; icon-only social links; built-with line.
-->
<footer
	class="mt-28 px-4 sm:px-6 lg:px-8 pb-8 w-full border-t-2 border-edge-strong pt-14"
	id="contact"
>
	<div
		class="mx-auto flex min-h-[27.5rem] max-w-2xl flex-col items-center justify-center gap-4 space-y-0 text-center md:min-h-[22.5rem]"
	>
		<h2
			class="text-4xl sm:text-5xl md:text-6xl font-bold font-pixel-clean uppercase tracking-wider text-content-strong"
		>
			{tFooter('title')}
		</h2>
		<p class="text-sm font-mono uppercase text-content-muted tracking-wide">
			{tFooter('subtitle')}
		</p>
		<div class="flex flex-col items-center gap-3 pt-6">
			<LinkButton href={emailHref} target="_self" variant="primary">
				<MailIcon aria-hidden="true" />
				{tFooter('contact')}
			</LinkButton>
			<LinkInline href={emailHref}>{tFooter('emailDavid')}</LinkInline>
		</div>
	</div>

	<div class="flex justify-center gap-4 sm:gap-5 mb-14 flex-wrap">
		{
			socialLinks.map(({ name, href, icon: Icon, opensNewTab }) => (
				<a
					href={href}
					target={opensNewTab ? '_blank' : undefined}
					rel={opensNewTab ? 'noopener noreferrer' : undefined}
					title={name}
					aria-label={opensNewTab ? `${name}, ${newTabLabel}` : name}
					class="flex items-center justify-center rounded-none p-3.5 bg-channel-surface-default border-2 border-edge-strong text-content-strong shadow-retro-md transition-[box-shadow,background-color] duration-100 hover:bg-channel-surface-highlight hover:shadow-retro-xl active:shadow-retro-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
				>
					<Icon class="size-6" aria-hidden="true" />
				</a>
			))
		}
	</div>

	<div
		class="flex flex-col md:flex-row items-center justify-between gap-4 pt-6 sm:pt-8 px-4 sm:px-8 border-t border-neutral-300 dark:border-neutral-800 font-mono text-xs sm:text-sm text-content-muted text-center md:text-left"
	>
		<p>© {currentYear} {siteConfig.fullName}. {tFooter('rights')}.</p>
		<p class="flex items-center gap-2 uppercase">
			{tFooter('builtWith')}
			<CodeIcon class="w-4 h-4 text-primary-500" aria-hidden="true" />
			<span class="text-content-muted">v2.0.0</span>
			<span aria-hidden="true">·</span>
			<a
				href={getRelativeLocaleUrl(lang, 'devlog')}
				class="underline decoration-dotted underline-offset-2 hover:text-primary-500 transition-colors"
			>
				{tNavigation('devlog')}
			</a>
		</p>
	</div>
</footer>
