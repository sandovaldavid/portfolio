---
import BriefcaseIcon from '@assets/icons/Briefcase.astro';
import BrainIcon from '@assets/icons/Brain.astro';
import CodeIcon from '@assets/icons/Code.astro';
import ProfileCheckIcon from '@assets/icons/ProfileCheck.astro';
import ScrollTextIcon from '@assets/icons/ScrollText.astro';
import BookOpenIcon from '@assets/icons/BookOpen.astro';
import SystemIcon from '@assets/icons/System.astro';

interface Props {
	navLabel: string;
	navItems: Array<{
		title: string;
		label: string;
		url: string;
		icon: string;
		prefetch?: boolean;
	}>;
}

const { navItems, navLabel } = Astro.props;
---

<!--
	Desktop nav contract (spec/03 Header): group gap 10px; item 145x40 with
	icon 16 and Navigation typography (JetBrains Mono Bold 14/20 tracking .35).
	min-width keeps translated labels safe instead of forcing a hard width.
-->
<nav class="hidden lg:flex items-center justify-center gap-2.5 font-mono" aria-label={navLabel}>
	{
		navItems.map(link => (
			<a
				class="relative flex h-10 min-w-[145px] items-center justify-center gap-2 px-3 text-sm font-bold leading-5 tracking-[0.35px] transition-colors duration-100 text-content-strong hover:text-channel-accent-primary-hover whitespace-nowrap focus-visible:outline-none focus-visible:text-channel-accent-primary"
				aria-label={link.title}
				data-section-id={link.label}
				href={link.url}
				data-astro-prefetch={link.prefetch ? 'hover' : undefined}
			>
				{link.icon === 'experience' && <BriefcaseIcon class="size-4" />}
				{link.icon === 'research' && <BrainIcon class="size-4" />}
				{link.icon === 'projects' && <CodeIcon class="size-4" />}
				{link.icon === 'devlog' && <ScrollTextIcon class="size-4" />}
				{link.icon === 'blog' && <BookOpenIcon class="size-4" />}
				{link.icon === 'about-me' && <ProfileCheckIcon class="size-4" />}
				{link.icon === 'technologies' && <SystemIcon class="size-4" />}
				<span>{link.title}</span>
			</a>
		))
	}
</nav>

<style>
	/* Active/hover indicator is an absolute rule: geometry never shifts. */
	nav a::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 0;
		height: 2px;
		background-color: currentColor;
		transition: width 0.3s ease;
		transform: translateX(-50%);
	}

	nav a:hover::after,
	nav a.active::after {
		width: calc(100% - 1rem);
	}

	@media (prefers-reduced-motion: reduce) {
		nav a::after {
			transition: none;
		}
	}
</style>
