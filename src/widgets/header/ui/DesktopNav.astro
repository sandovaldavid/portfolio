---
import AboutIcon from '@assets/icons/About.astro';
import BriefcaseIcon from '@assets/icons/Briefcase.astro';
import BrainIcon from '@assets/icons/Brain.astro';
import CodeIcon from '@assets/icons/Code.astro';
import ScrollTextIcon from '@assets/icons/ScrollText.astro';
import BookOpenIcon from '@assets/icons/BookOpen.astro';
import SystemIcon from '@assets/icons/System.astro';
import { isCurrentNavPath } from '../lib/navigation';

interface Props {
	navLabel: string;
	navItems: Array<{
		title: string;
		label: string;
		url: string;
		icon: string;
		prefetch?: boolean;
	}>;
}

const { navItems, navLabel } = Astro.props;
const currentPathname = Astro.url.pathname;
---

<!--
	Desktop nav contract (Figma v2 Header): group gap 10px; item 145×40;
	icon 16, content gap 6 and Navigation typography 14/20 tracking .35.
-->
<nav class="hidden lg:flex items-center justify-center gap-2.5" aria-label={navLabel}>
	{navItems.map(link => {
		const isCurrentPage = isCurrentNavPath(currentPathname, link.url);

		return (
			<a
				class:list={[
					'relative flex h-10 w-36.25 items-center justify-center gap-1.5 px-3 text-navigation text-content-strong transition-colors duration-100 hover:text-channel-accent-primary-hover whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-button-focus focus-visible:text-channel-accent-primary',
					isCurrentPage && 'active',
				]}
				aria-current={isCurrentPage ? 'page' : undefined}
				data-section-id={link.label}
				href={link.url}
				data-astro-prefetch={link.prefetch ? 'hover' : undefined}
			>
				{link.icon === 'experience' && <BriefcaseIcon class="size-4" aria-hidden="true" />}
				{link.icon === 'research' && <BrainIcon class="size-4" aria-hidden="true" />}
				{link.icon === 'projects' && <CodeIcon class="size-4" aria-hidden="true" />}
				{link.icon === 'devlog' && <ScrollTextIcon class="size-4" aria-hidden="true" />}
				{link.icon === 'blog' && <BookOpenIcon class="size-4" aria-hidden="true" />}
				{link.icon === 'about-me' && <AboutIcon class="size-4" aria-hidden="true" />}
				{link.icon === 'technologies' && <SystemIcon class="size-4" aria-hidden="true" />}
				<span>{link.title}</span>
			</a>
		);
	})}
</nav>

<style>
	/* Active/hover indicator is absolute so state never shifts geometry. */
	nav a::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		box-sizing: border-box;
		width: 0;
		height: 2px;
		background-color: currentColor;
		border-bottom: 2px solid transparent;
		transition: width 0.3s ease;
		transform: translateX(-50%);
	}

	nav a:hover::after,
	nav a:focus-visible::after,
	nav a.active::after,
	nav a[aria-current='page']::after {
		width: calc(100% - 1rem);
	}

	@media (forced-colors: active) {
		nav a:hover::after,
		nav a:focus-visible::after,
		nav a.active::after,
		nav a[aria-current='page']::after {
			border-color: Highlight;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		nav a::after {
			transition: none;
		}
	}
</style>
