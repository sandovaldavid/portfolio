---
import { LinkButton } from '@shared/ui';
import MenuIcon from '@assets/icons/MenuIcon.astro';
import MailIcon from '@assets/icons/Mail.astro';
import BriefcaseIcon from '@assets/icons/Briefcase.astro';
import BrainIcon from '@assets/icons/Brain.astro';
import CodeIcon from '@assets/icons/Code.astro';
import ProfileCheckIcon from '@assets/icons/ProfileCheck.astro';
import ScrollTextIcon from '@assets/icons/ScrollText.astro';
import BookOpenIcon from '@assets/icons/BookOpen.astro';
import SystemIcon from '@assets/icons/System.astro';
import type { Language, LocalizedPathMap } from '@shared/config/i18n';
import { ThemeToggle } from '@features/theme-toggle';
import { LanguagePicker } from '@features/language-picker';

interface Props {
	navItems: Array<{
		title: string;
		label: string;
		url: string;
		icon: string;
		prefetch?: boolean;
	}>;
	lang: Language;
	localizedPaths?: LocalizedPathMap;
	menuLabel: string;
	openLabel: string;
	closeLabel: string;
	resumeLabel: string;
	resumeHref: string;
	contactLabel: string;
	contactHref: string;
	newTabLabel: string;
}

const {
	navItems,
	lang,
	localizedPaths,
	menuLabel,
	openLabel,
	closeLabel,
	resumeLabel,
	resumeHref,
	contactLabel,
	contactHref,
	newTabLabel,
} = Astro.props;
---

<!--
	Mobile/tablet navigation (spec/03 Header + Plan 03): compact trigger 40x40
	(surface default, border 2 strong, hard shadow 1.5, icon 20). The overlay owns
	every preference surface below lg: primary navigation, Download resume,
	Get in touch, Theme and Language.
-->
<nav class="flex lg:hidden w-full items-center justify-between" aria-label={menuLabel}>
	<button
		id="mobile-menu-btn"
		class="grid size-10 place-items-center rounded-none border-2 border-edge-strong bg-channel-surface-default p-0 text-content-strong shadow-retro-sm transition-[box-shadow,background-color] duration-100 hover:bg-channel-surface-highlight active:shadow-retro-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
		aria-label={openLabel}
		aria-haspopup="dialog"
		aria-controls="mobile-menu"
		aria-expanded="false"
	>
		<MenuIcon class="size-5" />
	</button>
</nav>

<!-- Mobile Menu Overlay -->
<div
	id="mobile-menu"
	role="dialog"
	aria-modal="true"
	aria-label={menuLabel}
	class="fixed inset-0 w-full h-screen bg-background/95 backdrop-blur-md z-50 hidden items-center justify-center transition-all duration-100 overflow-y-auto"
>
	<div class="flex flex-col items-center justify-center gap-6 w-full max-w-sm px-6 py-10">
		<!-- Close Button -->
		<button
			id="mobile-menu-close"
			class="absolute top-6 right-6 grid size-10 place-items-center rounded-none bg-channel-surface-default border-2 border-edge-strong text-content-strong shadow-retro-sm transition-[box-shadow,background-color] duration-100 hover:bg-channel-surface-highlight active:shadow-retro-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
			aria-label={closeLabel}
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="size-5"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				aria-hidden="true"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>

		<!-- Navigation Items -->
		<nav class="flex flex-col items-center gap-3 w-full" aria-label={menuLabel}>
			{
				navItems.map(link => (
					<a
						class="w-full flex items-center justify-center gap-2 px-6 py-3 rounded-none text-base font-bold uppercase tracking-wider font-mono text-content-strong hover:text-primary-500 hover:bg-surface-highlight border-2 border-transparent hover:border-edge-strong transition-all duration-100 whitespace-nowrap"
						aria-label={link.title}
						data-section-id={link.label}
						href={link.url}
						data-astro-prefetch={link.prefetch ? 'hover' : undefined}
						data-close-menu="true"
					>
						{link.icon === 'experience' && <BriefcaseIcon class="size-5" />}
						{link.icon === 'research' && <BrainIcon class="size-5" />}
						{link.icon === 'projects' && <CodeIcon class="size-5" />}
						{link.icon === 'devlog' && <ScrollTextIcon class="size-5" />}
						{link.icon === 'blog' && <BookOpenIcon class="size-5" />}
						{link.icon === 'about-me' && <ProfileCheckIcon class="size-5" />}
						{link.icon === 'technologies' && <SystemIcon class="size-5" />}
						<span>{link.title}</span>
					</a>
				))
			}
		</nav>

		<!-- Actions: Download resume and Get in touch -->
		<div class="flex flex-col items-stretch gap-3 mt-2 w-full">
			<LinkButton href={resumeHref} target="_blank" variant="primary" {newTabLabel}>
				{resumeLabel}
			</LinkButton>
			<LinkButton href={contactHref} target="_self" variant="secondary">
				<MailIcon aria-hidden="true" />
				{contactLabel}
			</LinkButton>
		</div>

		<!-- Preferences: theme and language live here below lg (Plan 03) -->
		<div class="flex flex-col items-center gap-4 w-full border-t-2 border-edge-subtle pt-5">
			<ThemeToggle />
			<LanguagePicker {localizedPaths} currentLang={lang} />
		</div>
	</div>
</div>

<script>
	// The header is re-rendered on every client-side navigation, so the open/
	// close listeners are (re)wired on astro:page-load. Document-level listeners
	// are attached once and resolve the current elements live.
	const openMobileMenu = () => {
		const menu = document.getElementById('mobile-menu');
		const btn = document.getElementById('mobile-menu-btn');
		const close = document.getElementById('mobile-menu-close');
		menu?.classList.remove('hidden');
		menu?.classList.add('flex');
		btn?.setAttribute('aria-expanded', 'true');
		// Move focus into the dialog for keyboard/AT users.
		close?.focus();
	};

	const closeMobileMenu = () => {
		const menu = document.getElementById('mobile-menu');
		const btn = document.getElementById('mobile-menu-btn');
		if (!menu || menu.classList.contains('hidden')) return;
		menu.classList.add('hidden');
		menu.classList.remove('flex');
		btn?.setAttribute('aria-expanded', 'false');
		// Return focus to the trigger after dismissing (repo focus pattern).
		btn?.focus();
	};

	const setupMobileNav = () => {
		const btn = document.getElementById('mobile-menu-btn');
		const menu = document.getElementById('mobile-menu');
		const close = document.getElementById('mobile-menu-close');
		if (!btn || !menu) return;

		if (btn.dataset.navReady !== 'true') {
			btn.dataset.navReady = 'true';
			btn.addEventListener('click', e => {
				e.stopPropagation();
				openMobileMenu();
			});
		}

		if (close && close.dataset.navReady !== 'true') {
			close.dataset.navReady = 'true';
			close.addEventListener('click', e => {
				e.stopPropagation();
				closeMobileMenu();
			});
		}
	};

	// Close on nav-item click — closest() so clicks on the inner icon/label
	// (not just the <a>) still dismiss the menu. Attached once.
	document.addEventListener('click', e => {
		const target = e.target as HTMLElement | null;
		if (target?.closest?.('[data-close-menu]')) closeMobileMenu();
	});

	// Close on outside click (attached once, resolves elements live).
	document.addEventListener('click', e => {
		const menu = document.getElementById('mobile-menu');
		const btn = document.getElementById('mobile-menu-btn');
		if (menu && !menu.classList.contains('hidden')) {
			const target = e.target;
			if (target instanceof Node && !menu.contains(target) && target !== btn) {
				closeMobileMenu();
			}
		}
	});

	// Escape closes the dialog and returns focus to the trigger (attached once).
	document.addEventListener('keydown', e => {
		if (e.key === 'Escape') closeMobileMenu();
	});

	document.addEventListener('astro:page-load', setupMobileNav);
</script>
