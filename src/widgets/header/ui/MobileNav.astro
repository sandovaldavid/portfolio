---
import { LinkButton } from '@shared/ui';
import AboutIcon from '@assets/icons/About.astro';
import CloseIcon from '@assets/icons/Close.astro';
import MenuIcon from '@assets/icons/MenuIcon.astro';
import MailIcon from '@assets/icons/Mail.astro';
import BriefcaseIcon from '@assets/icons/Briefcase.astro';
import BrainIcon from '@assets/icons/Brain.astro';
import CodeIcon from '@assets/icons/Code.astro';
import ScrollTextIcon from '@assets/icons/ScrollText.astro';
import BookOpenIcon from '@assets/icons/BookOpen.astro';
import SystemIcon from '@assets/icons/System.astro';
import type { Language, LocalizedPathMap } from '@shared/config/i18n';
import { ThemeToggle } from '@features/theme-toggle';
import { LanguagePicker } from '@features/language-picker';
import { isCurrentNavPath } from '../lib/navigation';

interface Props {
	navItems: Array<{
		title: string;
		label: string;
		url: string;
		icon: string;
		prefetch?: boolean;
	}>;
	lang: Language;
	localizedPaths?: LocalizedPathMap;
	dialogLabel: string;
	menuLabel: string;
	openLabel: string;
	closeLabel: string;
	resumeLabel: string;
	resumeHref: string;
	contactLabel: string;
	contactHref: string;
	newTabLabel: string;
}

const {
	navItems,
	lang,
	localizedPaths,
	dialogLabel,
	menuLabel,
	openLabel,
	closeLabel,
	resumeLabel,
	resumeHref,
	contactLabel,
	contactHref,
	newTabLabel,
} = Astro.props;
const currentPathname = Astro.url.pathname;
---

<!--
	Mobile/tablet navigation (spec/03 Header + Plan 03): compact trigger 40x40
	(surface default, border 2 strong, hard shadow 1.5, icon 20). The overlay owns
	every preference surface below lg: primary navigation, Download resume,
	Get in touch, Theme and Language.
-->
<div class="flex lg:hidden w-full items-center justify-between">
	<button
		type="button"
		id="mobile-menu-btn"
		class="grid size-10 place-items-center rounded-none border-2 border-edge-strong bg-channel-surface-default p-0 text-content-strong shadow-retro-sm transition-[box-shadow,background-color] duration-100 hover:bg-channel-surface-highlight active:shadow-retro-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-transparent focus-visible:ring-2 focus-visible:ring-button-focus"
		aria-label={openLabel}
		aria-haspopup="dialog"
		aria-controls="mobile-menu"
		aria-expanded="false"
	>
		<MenuIcon class="size-5" aria-hidden="true" />
	</button>
</div>

<!-- Mobile Menu Overlay -->
<dialog
	id="mobile-menu"
	aria-label={dialogLabel}
	class="fixed inset-0 z-50 m-0 h-dvh w-full max-h-none max-w-none overflow-y-auto border-0 bg-background/95 p-0 text-content-strong backdrop-blur-md open:flex lg:hidden"
>
	<div class="m-auto flex flex-col items-center justify-center gap-6 w-full max-w-sm px-6 pt-16 pb-10">
		<!-- Close Button -->
		<button
			type="button"
			id="mobile-menu-close"
			class="fixed top-6 right-6 z-10 grid size-10 place-items-center rounded-none bg-channel-surface-default border-2 border-edge-strong text-content-strong shadow-retro-sm transition-[box-shadow,background-color] duration-100 hover:bg-channel-surface-highlight active:shadow-retro-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-transparent focus-visible:ring-2 focus-visible:ring-button-focus"
			aria-label={closeLabel}
		>
			<CloseIcon class="size-5" aria-hidden="true" />
		</button>

		<!-- Navigation Items -->
		<nav class="flex flex-col items-center gap-3 w-full" aria-label={menuLabel}>
			{navItems.map(link => {
				const isCurrentPage = isCurrentNavPath(currentPathname, link.url);

				return (
					<a
						class:list={[
							'w-full flex items-center justify-center gap-2 px-6 py-3 rounded-none text-center text-base font-bold uppercase tracking-wider font-mono text-content-strong hover:text-primary-500 hover:bg-surface-highlight border-2 hover:border-edge-strong transition-colors duration-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-button-focus',
							isCurrentPage
								? 'border-edge-strong bg-surface-highlight text-channel-accent-primary'
								: 'border-transparent',
						]}
						aria-current={isCurrentPage ? 'page' : undefined}
						data-section-id={link.label}
						href={link.url}
						data-astro-prefetch={link.prefetch ? 'hover' : undefined}
						data-close-menu="true"
					>
						{link.icon === 'experience' && (
							<BriefcaseIcon class="size-5 shrink-0" aria-hidden="true" />
						)}
						{link.icon === 'research' && (
							<BrainIcon class="size-5 shrink-0" aria-hidden="true" />
						)}
						{link.icon === 'projects' && (
							<CodeIcon class="size-5 shrink-0" aria-hidden="true" />
						)}
						{link.icon === 'devlog' && (
							<ScrollTextIcon class="size-5 shrink-0" aria-hidden="true" />
						)}
						{link.icon === 'blog' && (
							<BookOpenIcon class="size-5 shrink-0" aria-hidden="true" />
						)}
						{link.icon === 'about-me' && (
							<AboutIcon class="size-5 shrink-0" aria-hidden="true" />
						)}
						{link.icon === 'technologies' && (
							<SystemIcon class="size-5 shrink-0" aria-hidden="true" />
						)}
						<span>{link.title}</span>
					</a>
				);
			})}
		</nav>

		<!-- Actions: Download resume and Get in touch -->
		<div class="flex flex-col items-stretch gap-3 mt-2 w-full">
			<LinkButton href={resumeHref} target="_blank" variant="primary" {newTabLabel}>
				{resumeLabel}
			</LinkButton>
			<LinkButton href={contactHref} target="_self" variant="secondary" closeMenu>
				<MailIcon aria-hidden="true" />
				{contactLabel}
			</LinkButton>
		</div>

		<!-- Preferences: theme and language live here below lg (Plan 03) -->
		<div class="flex flex-col items-center gap-4 w-full border-t-2 border-edge-subtle pt-5">
			<ThemeToggle />
			<LanguagePicker {localizedPaths} currentLang={lang} />
		</div>
	</div>
</dialog>

<style>
	dialog#mobile-menu::backdrop {
		background: transparent;
	}
</style>

<script>
	// The header is re-rendered on every client-side navigation, so the open/
	// close listeners are wired on initial load and re-wired on astro:page-load
	// (including non-ClientRouter routes such as /404).
	const openMobileMenu = () => {
		const menu = document.getElementById('mobile-menu');
		const btn = document.getElementById('mobile-menu-btn');
		const close = document.getElementById('mobile-menu-close');
		if (!(menu instanceof HTMLDialogElement)) return;
		if (!menu.open) menu.showModal();
		btn?.setAttribute('aria-expanded', 'true');
		// Move focus into the dialog for keyboard/AT users.
		close?.focus();
	};

	const closeMobileMenu = (reason = 'dismiss') => {
		const menu = document.getElementById('mobile-menu');
		const btn = document.getElementById('mobile-menu-btn');
		if (!(menu instanceof HTMLDialogElement) || !menu.open) return;
		menu.close(reason);
		btn?.setAttribute('aria-expanded', 'false');
	};

	const setupMobileNav = () => {
		const btn = document.getElementById('mobile-menu-btn');
		const menu = document.getElementById('mobile-menu');
		const close = document.getElementById('mobile-menu-close');
		if (!btn || !(menu instanceof HTMLDialogElement)) return;

		if (btn.dataset.navReady !== 'true') {
			btn.dataset.navReady = 'true';
			btn.addEventListener('click', e => {
				e.stopPropagation();
				openMobileMenu();
			});
		}

		if (close && close.dataset.navReady !== 'true') {
			close.dataset.navReady = 'true';
			close.addEventListener('click', e => {
				e.stopPropagation();
				closeMobileMenu('dismiss');
			});
		}

		if (menu.dataset.dialogReady !== 'true') {
			menu.dataset.dialogReady = 'true';
			menu.addEventListener('click', e => {
				if (e.target !== menu) return;
				const rect = menu.getBoundingClientRect();
				const inViewportBox =
					(e.clientX === 0 && e.clientY === 0) ||
					(e.clientX >= rect.left &&
						e.clientX < rect.left + menu.clientWidth &&
						e.clientY >= rect.top &&
						e.clientY < rect.top + menu.clientHeight);
				if (inViewportBox) closeMobileMenu('dismiss');
			});
			menu.addEventListener('close', () => {
				const liveBtn = document.getElementById('mobile-menu-btn');
				liveBtn?.setAttribute('aria-expanded', 'false');
				if (menu.returnValue !== 'navigate') {
					liveBtn?.focus();
				}
			});
		}
	};

	const desktopBreakpoint = window.matchMedia('(min-width: 1024px)');
	desktopBreakpoint.addEventListener('change', event => {
		if (event.matches) closeMobileMenu('dismiss');
	});

	// Close on nav-item click — closest() so clicks on the inner icon/label
	// (not just the <a>) still dismiss the menu without restoring focus mid-navigation.
	document.addEventListener('click', e => {
		const target = e.target as HTMLElement | null;
		if (target?.closest?.('#mobile-menu [data-close-menu]')) {
			closeMobileMenu('navigate');
		}
	});

	document.addEventListener('astro:before-preparation', () => {
		closeMobileMenu('navigate');
	});

	setupMobileNav();
	document.addEventListener('astro:page-load', setupMobileNav);
</script>
