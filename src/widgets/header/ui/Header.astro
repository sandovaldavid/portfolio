---
/**
 * Header Widget Component
 * Main navigation header with responsive design
 * FSD Layer: Widgets > Header > UI
 *
 * Architecture: Composes smaller UI components following FSD
 * - BrandLogo: Left section with logo
 * - DesktopNav: Center navigation (lg and above)
 * - MobileNav: Right section below lg
 *
 * Shell contract (spec/03): height 72px, border-bottom 2px strong edge,
 * Top (canvas background) vs Scrolled (--color-header-surface-scrolled +
 * --shadow-header-scrolled) states; padding-x 16/24/32 at mobile/tablet/desktop.
 * ThemeToggle and LanguagePicker are never standalone header controls: they
 * live in RecruiterHUD on desktop and in MobileNav below lg.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';
import { LinkButton, BrandLogo } from '@shared/ui';
import {
	createScopedUiTranslator,
	getLanguageFromLocale,
	type LocalizedPathMap,
} from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';
import DesktopNav from './DesktopNav.astro';
import MobileNav from './MobileNav.astro';

interface Props {
	localizedPaths?: LocalizedPathMap;
}

const { localizedPaths } = Astro.props;
const lang = getLanguageFromLocale(Astro.currentLocale);
const tNavigation = createScopedUiTranslator(lang, 'navigation');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const tFooter = createScopedUiTranslator(lang, 'footer');
const homeUrl = getRelativeLocaleUrl(lang, '');
const homeSectionUrl = (section: string) => `${homeUrl}#${section}`;
const resumeUrl = lang === 'en' ? siteConfig.resume.en : siteConfig.resume.es;
const contactHref = `mailto:${siteConfig.email}`;

// Recruiter-first order: current experience, then the strongest engineering
// evidence (projects), with research as a secondary specialization. The Stack
// section remains on the homepage but is intentionally not a top-level nav
// destination — technology lists support project evidence rather than
// competing with it in the primary navigation hierarchy. Same-page anchors
// (experience/projects/research/about-me) stay grouped together in page
// order; blog is the only destination that leaves the homepage, so it goes
// last rather than interrupting the anchor sequence.
const navItems = [
	{
		title: tNavigation('experience'),
		label: 'experience',
		icon: 'experience',
		url: homeSectionUrl('experience'),
	},
	{
		title: tNavigation('projects'),
		label: 'projects',
		icon: 'projects',
		prefetch: true,
		url: homeSectionUrl('projects'),
	},
	{
		title: tNavigation('research'),
		label: 'research',
		icon: 'research',
		url: homeSectionUrl('research'),
	},
	{
		title: tNavigation('about'),
		label: 'about-me',
		icon: 'about-me',
		prefetch: true,
		url: homeSectionUrl('about-me'),
	},
	{
		title: tNavigation('blog'),
		label: 'blog',
		icon: 'blog',
		prefetch: true,
		url: getRelativeLocaleUrl(lang, 'blog'),
	},
];
---

<header
	data-header
	class="navbar-header fixed top-0 left-0 right-0 z-40 h-18 font-mono text-content-strong border-b-2 border-edge-strong"
>
	<!-- Shell contract (spec/03): 72px total incl. 2px strong edge; padding-x 16/24/32 mobile/tablet/desktop. -->
	<div class="flex h-full items-center justify-between w-full px-4 md:px-6 lg:px-8">
		<!-- Left: Brand Logo -->
		<div class="shrink-0">
			<BrandLogo href={homeUrl} accessibleLabel={tAccessibility('brandHomeLink')} />
		</div>

		<!-- Center: Desktop Navigation -->
		<div class="hidden lg:flex flex-1 min-w-0 justify-center">
			<DesktopNav navLabel={tAccessibility('mainNavigation')} {navItems} />
		</div>

		<!-- Right: Actions (Desktop) -->
		<div class="hidden lg:flex items-center justify-end gap-4 shrink-0">
			<LinkButton
				href={resumeUrl}
				target="_blank"
				variant="primary"
				newTabLabel={tAccessibility('externalLink')}
				class="min-w-47.5"
			>
				{tNavigation('resume')}
			</LinkButton>
		</div>

		<!-- Mobile Menu Button -->
		<div class="flex lg:hidden items-center gap-3 shrink-0">
			<MobileNav
				{navItems}
				{lang}
				{localizedPaths}
				menuLabel={tAccessibility('mobileNavigation')}
				openLabel={tAccessibility('openMenu')}
				closeLabel={tAccessibility('closeMenu')}
				resumeLabel={tNavigation('resume')}
				resumeHref={resumeUrl}
				contactLabel={tFooter('contact')}
				{contactHref}
				newTabLabel={tAccessibility('externalLink')}
			/>
		</div>
	</div>
</header>

<script>
	// Scrolled state (spec/03 Header): Top renders the canvas background;
	// Scrolled swaps to --color-header-surface-scrolled plus its shadow.
	// Detection is plain scroll-position based and view-transition safe: the
	// document-level listener attaches once per session and resolves the live
	// header on every event, so client navigations never duplicate listeners.
	const updateHeaderScrolledState = () => {
		const header = document.querySelector<HTMLElement>('header[data-header]');
		header?.toggleAttribute('data-scrolled', window.scrollY > 4);
	};

	updateHeaderScrolledState();
	document.addEventListener('scroll', updateHeaderScrolledState, { passive: true });
	document.addEventListener('astro:page-load', updateHeaderScrolledState);

	// Active link highlighting with IntersectionObserver. Exactly one observer
	// exists at any time: it is disconnected and rebuilt after client-side
	// navigation or visibility changes instead of stacking observers.
	let spyObserver: IntersectionObserver | null = null;

	const setupScrollSpy = () => {
		spyObserver?.disconnect();

		const sections = document.querySelectorAll('section[id]');
		const navLinks = document.querySelectorAll<HTMLElement>('header nav a[data-section-id]');

		const observer = new IntersectionObserver(
			(entries: IntersectionObserverEntry[]) => {
				entries.forEach((entry: IntersectionObserverEntry) => {
					if (entry.isIntersecting) {
						navLinks.forEach(link => {
							link.classList.toggle(
								'active',
								link.dataset.sectionId === entry.target.id
							);
						});
					}
				});
			},
			{ root: null, rootMargin: '-30% 0px -70% 0px', threshold: 0 }
		);

		sections.forEach(section => observer.observe(section));
		return observer;
	};

	spyObserver = setupScrollSpy();

	document.addEventListener('astro:page-load', () => {
		spyObserver = setupScrollSpy();
	});

	document.addEventListener('visibilitychange', () => {
		if (document.visibilityState === 'hidden') {
			spyObserver?.disconnect();
		} else {
			spyObserver = setupScrollSpy();
		}
	});
</script>

<style>
	/*
	 * Top vs Scrolled (spec/03 Header). Both states come from semantic tokens:
	 * Top = channel canvas background; Scrolled = header surface-scrolled token
	 * plus its paired shadow. Geometry never changes across states.
	 */
	.navbar-header {
		background-color: var(--channel-background-canvas);
		transition:
			background-color 160ms ease,
			box-shadow 160ms ease;
	}

	.navbar-header[data-scrolled] {
		background-color: var(--color-header-surface-scrolled);
		backdrop-filter: blur(14px);
		box-shadow: var(--shadow-header-scrolled);
	}

	@media (prefers-reduced-motion: reduce) {
		.navbar-header {
			transition: none;
		}
	}
</style>
