---
interface Props {
	href?: string;
	accessibleLabel: string;
	class?: string;
}

const { href = '/', accessibleLabel, class: className = '' } = Astro.props;
---

<a
	{href}
	aria-label={accessibleLabel}
	class={`brand-logo-link inline-flex h-11 items-center gap-2 rounded-lg px-2 py-1.5 whitespace-nowrap select-none ${className}`}
>
	<img
		src="/brand/logo-primary-dark.svg"
		alt=""
		width="32"
		height="32"
		class="block size-8 shrink-0"
		data-brand-logo
		data-brand-mode="dark"
		aria-hidden="true"
	/>
	<span
		class="brand-logo-signature hidden sm:inline-block font-gaming-mono text-base leading-[22px] tracking-[1px]"
		aria-hidden="true"
	>
		&lt;sandovaldavid/&gt;
	</span>
</a>

<script>
	const syncBrandLogoAssets = () => {
		const mode = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
		const source = `/brand/logo-primary-${mode}.svg`;

		document.querySelectorAll<HTMLImageElement>('[data-brand-logo]').forEach(image => {
			if (image.getAttribute('src') !== source) image.setAttribute('src', source);
			image.dataset.brandMode = mode;
		});
	};

	const setupBrandLogoAssets = () => {
		syncBrandLogoAssets();

		if (document.documentElement.dataset.brandLogoObserver === 'ready') return;
		document.documentElement.dataset.brandLogoObserver = 'ready';

		new MutationObserver(syncBrandLogoAssets).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['class'],
		});
	};

	setupBrandLogoAssets();
	document.addEventListener('astro:page-load', setupBrandLogoAssets);
</script>

<style>
	.brand-logo-link {
		color: var(--color-content-strong);
		outline: 2px solid transparent;
		outline-offset: -2px;
		transition:
			color 160ms ease,
			outline-color 160ms ease;
	}

	.brand-logo-signature {
		position: relative;
		transition: color 160ms ease;
	}

	.brand-logo-signature::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -3px;
		height: 2px;
		background-color: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 160ms ease;
	}

	.brand-logo-link:hover,
	.brand-logo-link:focus-visible {
		color: var(--channel-accent-primary);
	}

	.brand-logo-link:hover .brand-logo-signature::after,
	.brand-logo-link:focus-visible .brand-logo-signature::after {
		transform: scaleX(1);
	}

	.brand-logo-link:focus-visible {
		outline-color: var(--channel-accent-primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-logo-link,
		.brand-logo-signature,
		.brand-logo-signature::after {
			transition: none;
		}
	}
</style>
