---
interface Props {
	href?: string;
	class?: string;
}

const { href = '/', class: className = '' } = Astro.props;
---

<a
	{href}
	class={`brand-logo-link font-pixel-clean text-2xl font-bold text-logo-content hover:text-logo-primary-hover transition-colors whitespace-nowrap flex items-center gap-2 group select-none ${className}`}
>
	<span class="text-logo-primary prompt-symbol">&gt;</span>
	<span class="logo-typing">&lt;sandovaldavid/&gt;</span>
</a>

<script>
	const setupBrandLogo = () => {
		document.querySelectorAll<HTMLElement>('.brand-logo-link').forEach(link => {
			if (link.dataset.logoReady === 'true') return;
			link.dataset.logoReady = 'true';

			const typingElement = link.querySelector<HTMLElement>('.logo-typing');
			if (!typingElement) return;

			link.addEventListener('mouseenter', () => {
				typingElement.style.animation = 'none';
				void typingElement.offsetWidth;
				typingElement.style.animation =
					'typing-hover 1.2s steps(17) 1 forwards, blink-caret 0.75s step-end infinite, glitch 0.3s steps(2) infinite';
			});

			link.addEventListener('mouseleave', () => {
				typingElement.style.animation = 'none';
				void typingElement.offsetWidth;
				typingElement.style.animation = 'blink-caret 0.75s step-end infinite';
			});
		});
	};

	document.addEventListener('astro:page-load', setupBrandLogo);
</script>

<style>
	.brand-logo-link {
		min-width: 19ch;
	}

	.prompt-symbol {
		display: inline-block;
		animation: prompt-pulse 2s infinite ease-in-out;
	}

	.logo-typing {
		display: inline-block;
		overflow: hidden;
		white-space: nowrap;
		border-right: 3px solid currentColor;
		width: 17ch;
		animation:
			typing-load 1.5s steps(17) 1 forwards,
			blink-caret 0.75s step-end infinite;
	}

	@keyframes prompt-pulse {
		0%,
		100% {
			opacity: 0.6;
			transform: scale(0.95);
			text-shadow: 0 0 2px var(--color-logo-primary);
		}
		50% {
			opacity: 1;
			transform: scale(1.05);
			text-shadow:
				0 0 8px var(--color-logo-primary-hover),
				0 0 12px var(--color-logo-primary);
		}
	}

	@keyframes typing-load {
		from {
			width: 0;
		}
		to {
			width: 17ch;
		}
	}

	@keyframes typing-hover {
		from {
			width: 0;
		}
		to {
			width: 17ch;
		}
	}

	@keyframes blink-caret {
		from,
		to {
			border-color: transparent;
		}
		50% {
			border-color: currentColor;
		}
	}

	@keyframes glitch {
		0% {
			text-shadow:
				1.5px -1px 0 var(--color-logo-effect-magenta),
				-1.5px 1.2px 0 var(--color-logo-effect-cyan);
			transform: translate(0.5px, -0.5px);
		}
		25% {
			text-shadow:
				-1.5px 1.5px 0 var(--color-logo-effect-magenta),
				1.5px -1.2px 0 var(--color-logo-effect-cyan);
			transform: translate(-0.5px, 0.5px);
		}
		50% {
			text-shadow:
				1.2px 1.5px 0 var(--color-logo-effect-magenta),
				-1.2px -1.5px 0 var(--color-logo-effect-cyan);
			transform: translate(0.5px, 0.5px);
		}
		75% {
			text-shadow:
				-1.2px -1.2px 0 var(--color-logo-effect-magenta),
				1.2px 1.2px 0 var(--color-logo-effect-cyan);
			transform: translate(-0.5px, -0.5px);
		}
		100% {
			text-shadow:
				1.5px -1px 0 var(--color-logo-effect-magenta),
				-1.5px 1.2px 0 var(--color-logo-effect-cyan);
			transform: translate(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.prompt-symbol,
		.logo-typing {
			animation: none;
		}
	}
</style>
