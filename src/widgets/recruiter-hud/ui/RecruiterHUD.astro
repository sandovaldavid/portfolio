---
import {
	createScopedUiTranslator,
	getLanguageFromLocale,
	Language,
	type LocalizedPathMap,
} from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';
import { LinkButton, LinkInline } from '@shared/ui';
import { LanguagePicker } from '@features/language-picker';
import { ThemeToggle } from '@features/theme-toggle';
import GitHubIcon from '@assets/technologies/GitHub.astro';
import LinkedInIcon from '@assets/social-networks/LinkedIn.astro';
import MailIcon from '@assets/icons/Mail.astro';

interface Props {
	localizedPaths: LocalizedPathMap;
}

const { localizedPaths } = Astro.props;
const lang = getLanguageFromLocale(Astro.currentLocale);
const tRecruiter = createScopedUiTranslator(lang, 'recruiter');
const tTheme = createScopedUiTranslator(lang, 'theme');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const newTabLabel = tAccessibility('externalLink');
const resumeUrl = lang === Language.ENGLISH ? siteConfig.resume.en : siteConfig.resume.es;
const emailHref = `mailto:${siteConfig.email}?subject=${encodeURIComponent(tRecruiter('emailSubject'))}`;

const socialLinks = [
	{
		label: tRecruiter('github'),
		href: siteConfig.social.github,
		Icon: GitHubIcon,
		external: true,
	},
	{
		label: tRecruiter('linkedin'),
		href: siteConfig.social.linkedin,
		Icon: LinkedInIcon,
		external: true,
	},
	{
		label: tRecruiter('email'),
		href: `mailto:${siteConfig.email}`,
		Icon: MailIcon,
		external: false,
	},
];
---

<!--
	Recruiter HUD contract (spec/03): desktop ONLY (never rendered below lg).
	Closed trigger is a content-hug 44px control; the open panel is 360px wide
	with a 320px inner column. Preferences own Theme and Language on desktop.
	Hides while the Footer CTA is visible (IntersectionObserver visibility).
-->
<div
	id="recruiter-hud"
	class="recruiter-hud fixed bottom-5 right-5 z-50 hidden flex-col items-end gap-4 font-mono lg:flex"
>
	<button
		id="recruiter-hud-toggle"
		type="button"
		class="flex h-11 cursor-pointer items-center gap-2 border-2 border-button-border bg-button-primary-background px-4 text-sm font-bold uppercase tracking-wider text-button-primary-content shadow-retro-md hover:bg-button-primary-background-hover hover:shadow-retro-xl active:shadow-retro-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus focus-visible:ring-offset-2 focus-visible:ring-offset-channel-background-canvas"
		aria-controls="recruiter-hud-panel"
		aria-expanded="false"
	>
		<span class="sr-only">{tRecruiter('openPanel')}: </span>{tRecruiter('resume')}
	</button>

	<div
		id="recruiter-hud-panel"
		class="absolute bottom-16 right-0 hidden w-[360px] flex-col gap-3.5 border-2 border-channel-edge-strong bg-channel-surface-default p-5 shadow-retro-2xl"
		role="dialog"
		aria-modal="false"
		aria-labelledby="recruiter-hud-title"
	>
		<div class="flex items-start justify-between gap-4 border-b border-edge-subtle pb-2.5">
			<h2
				id="recruiter-hud-title"
				class="text-lg font-bold leading-6 text-channel-accent-primary"
			>
				{tRecruiter('title')}
			</h2>
			<button
				id="recruiter-hud-close"
				type="button"
				class="grid size-10 shrink-0 cursor-pointer place-items-center rounded-none border border-edge-strong bg-transparent text-content-strong transition-colors duration-100 hover:bg-channel-surface-highlight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
				aria-label={tRecruiter('closePanel')}
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="size-5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"
					>
					</path>
				</svg>
			</button>
		</div>

		<p class="text-sm font-normal leading-5 text-content">{tRecruiter('summary')}</p>

		<p class="text-xs font-bold leading-4 text-channel-content-muted">
			{tRecruiter('availability')}
		</p>

		<div class="flex flex-col gap-3.5">
			<LinkButton
				href={resumeUrl}
				target="_blank"
				variant="primary"
				{newTabLabel}
				class="w-full"
			>
				{tRecruiter('downloadResume')}
			</LinkButton>
			<LinkButton href={emailHref} target="_self" variant="secondary" class="w-full">
				{tRecruiter('sendEmail')}
			</LinkButton>

			<!-- Social row: 32px high, gap 24, icon 16, Inter Medium 16 -->
			<div class="flex h-8 items-center justify-between gap-6">
				{
					socialLinks.map(({ label, href, Icon, external }) => (
						<LinkInline
							href={href}
							icon={Icon}
							newTabLabel={external ? newTabLabel : undefined}
						>
							<span class="text-sm">{label}</span>
						</LinkInline>
					))
				}
			</div>
		</div>

		<!-- Preferences block owns Theme and Language on desktop (Plan 03). -->
		<div class="mt-1.5 flex w-full flex-col gap-3 border-t border-edge-subtle pt-2.5">
			<div class="flex items-center justify-between gap-3">
				<span
					class="text-xs font-bold uppercase tracking-widest text-channel-content-muted"
				>
					{tTheme('label')}
				</span>
				<ThemeToggle />
			</div>
			<div class="flex items-center justify-between gap-3">
				<span
					class="text-xs font-bold uppercase tracking-widest text-channel-content-muted"
				>
					{tRecruiter('language')}
				</span>
				<LanguagePicker {localizedPaths} currentLang={lang} />
			</div>
		</div>
	</div>
</div>

<style>
	/* Footer CTA takes over once visible: remove the HUD entirely from layout. */
	.recruiter-hud[data-footer-hidden='true'] {
		display: none;
	}
</style>

<script>
	const isOpen = (toggle: HTMLElement | null) => toggle?.getAttribute('aria-expanded') === 'true';

	const setOpen = (root: HTMLElement, open: boolean) => {
		const toggle = root.querySelector<HTMLButtonElement>('#recruiter-hud-toggle');
		const panel = root.querySelector<HTMLElement>('#recruiter-hud-panel');
		if (!toggle || !panel) return;

		panel.classList.toggle('hidden', !open);
		panel.classList.toggle('flex', open);
		toggle.setAttribute('aria-expanded', String(open));
		if (open) {
			const firstFocusable = panel.querySelector<HTMLElement>('a, button');
			firstFocusable?.focus();
		} else if (document.activeElement && root.contains(document.activeElement)) {
			toggle.focus();
		}
	};

	const setupHud = () => {
		const root = document.getElementById('recruiter-hud');
		if (!root || root.dataset.hudBound === 'true') return;
		root.dataset.hudBound = 'true';

		const toggle = root.querySelector<HTMLButtonElement>('#recruiter-hud-toggle');
		const close = root.querySelector<HTMLButtonElement>('#recruiter-hud-close');
		if (!toggle) return;

		toggle.addEventListener('click', () => setOpen(root, !isOpen(toggle)));
		close?.addEventListener('click', () => setOpen(root, false));

		// Escape/outside-click follow the mobile menu pattern: document-level,
		// attached once per element, focus returns to the trigger on dismissal.
		root.addEventListener('keydown', event => {
			if (event.key === 'Escape' && isOpen(toggle)) {
				event.stopPropagation();
				setOpen(root, false);
				toggle.focus();
			}
		});
	};

	setupHud();
	document.addEventListener('astro:page-load', setupHud);

	// Outside click resolves the live HUD so client navigations stay safe
	// without re-binding document listeners.
	document.addEventListener('click', event => {
		const root = document.getElementById('recruiter-hud');
		const toggle = root?.querySelector('#recruiter-hud-toggle');
		if (!root || !(toggle instanceof HTMLElement) || !isOpen(toggle)) return;
		const target = event.target;
		if (target instanceof Node && !root.contains(target)) setOpen(root, false);
	});

	document.addEventListener('keydown', event => {
		if (event.key !== 'Escape') return;
		const root = document.getElementById('recruiter-hud');
		const toggle = root?.querySelector('#recruiter-hud-toggle');
		if (!root || !(toggle instanceof HTMLElement) || !isOpen(toggle)) return;
		if (!root.contains(event.target as Node)) setOpen(root, false);
	});

	// Hide the HUD while the Footer CTA is visible. One observer exists for the
	// whole session; it re-observes the current footer after every navigation.
	let footerObserver: IntersectionObserver | null = null;

	const observeFooterCta = () => {
		footerObserver?.disconnect();

		const footer = document.getElementById('contact');
		if (!footer) return;

		if (!footerObserver) {
			footerObserver = new IntersectionObserver(entries => {
				entries.forEach(entry => {
					const hud = document.getElementById('recruiter-hud');
					hud?.setAttribute('data-footer-hidden', String(entry.isIntersecting));
				});
			});
		}
		footerObserver.observe(footer);
	};

	observeFooterCta();
	document.addEventListener('astro:page-load', observeFooterCta);
</script>
