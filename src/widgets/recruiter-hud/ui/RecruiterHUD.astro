---
import {
	createScopedUiTranslator,
	getLanguageFromLocale,
	Language,
	type LocalizedPathMap,
} from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';
import { LinkButton, LinkInline } from '@shared/ui';
import { LanguagePicker } from '@features/language-picker';
import { ThemeToggle } from '@features/theme-toggle';
import GitHubIcon from '@assets/technologies/GitHub.astro';
import LinkedInIcon from '@assets/social-networks/LinkedIn.astro';
import MailIcon from '@assets/icons/Mail.astro';

interface Props {
	localizedPaths: LocalizedPathMap;
}

const { localizedPaths } = Astro.props;
const lang = getLanguageFromLocale(Astro.currentLocale);
const tRecruiter = createScopedUiTranslator(lang, 'recruiter');
const tTheme = createScopedUiTranslator(lang, 'theme');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const newTabLabel = tAccessibility('externalLink');
const resumeUrl = lang === Language.ENGLISH ? siteConfig.resume.en : siteConfig.resume.es;
const emailHref = `mailto:${siteConfig.email}?subject=${encodeURIComponent(tRecruiter('emailSubject'))}`;

const socialLinks = [
	{
		label: tRecruiter('github'),
		href: siteConfig.social.github,
		Icon: GitHubIcon,
		external: true,
	},
	{
		label: tRecruiter('linkedin'),
		href: siteConfig.social.linkedin,
		Icon: LinkedInIcon,
		external: true,
	},
	{
		label: tRecruiter('email'),
		href: `mailto:${siteConfig.email}`,
		Icon: MailIcon,
		external: false,
	},
];
---

<!--
	Portfolio / Recruiter HUD (Figma v2): desktop only. The closed trigger is
	44px high and content-hug; the open composition is 360px wide and uses the
	20px / 16px panel rhythm from Figma. Open/close and Footer takeover use
	subtle transform/opacity transitions while preserving reduced-motion.
-->
<div
	id="recruiter-hud"
	class="recruiter-hud fixed bottom-5 right-5 z-50 hidden flex-col items-end gap-4 font-mono lg:flex"
	data-open="false"
	data-footer-hidden="false"
>
	<button
		id="recruiter-hud-toggle"
		type="button"
		class="flex h-11 cursor-pointer items-center gap-2 border-2 border-button-border bg-button-primary-background px-4 text-button-label text-button-primary-content shadow-retro-md transition-[background-color,box-shadow,transform] duration-150 hover:bg-button-primary-background-hover hover:shadow-retro-xl active:translate-y-0.5 active:shadow-retro-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus focus-visible:ring-offset-2 focus-visible:ring-offset-channel-background-canvas"
		aria-controls="recruiter-hud-panel"
		aria-expanded="false"
	>
		<span class="sr-only">{tRecruiter('openPanel')}: </span>{tRecruiter('resume')}
	</button>

	<div
		id="recruiter-hud-panel"
		class="recruiter-panel absolute bottom-15 right-0 flex w-90 flex-col gap-4 border-2 border-channel-edge-strong bg-channel-surface-default p-5 shadow-retro-2xl"
		role="dialog"
		aria-modal="false"
		aria-hidden="true"
		aria-labelledby="recruiter-hud-title"
	>
		<div class="flex w-full items-start justify-between gap-4 border-b border-edge-subtle pb-2.5">
			<h2
				id="recruiter-hud-title"
				class="text-lg font-bold leading-6 text-channel-accent-primary"
			>
				{tRecruiter('title')}
			</h2>
			<button
				id="recruiter-hud-close"
				type="button"
				class="grid size-10 shrink-0 cursor-pointer place-items-center border border-edge-strong bg-transparent text-content-strong transition-colors duration-100 hover:bg-channel-surface-highlight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
				aria-label={tRecruiter('closePanel')}
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="size-5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"
					></path>
				</svg>
			</button>
		</div>

		<p class="text-sm font-normal leading-5 text-content">{tRecruiter('summary')}</p>

		<p class="text-xs font-bold leading-4 text-channel-content-muted">
			{tRecruiter('availability')}
		</p>

		<div class="flex flex-col gap-4">
			<LinkButton
				href={resumeUrl}
				target="_blank"
				variant="primary"
				{newTabLabel}
				class="w-full"
			>
				{tRecruiter('downloadResume')}
			</LinkButton>
			<LinkButton href={emailHref} target="_self" variant="secondary" class="w-full">
				{tRecruiter('sendEmail')}
			</LinkButton>

			<div class="flex h-8 items-center justify-center gap-6">
				{
					socialLinks.map(({ label, href, Icon, external }) => (
						<LinkInline
							href={href}
							icon={Icon}
							newTabLabel={external ? newTabLabel : undefined}
						>
							<span>{label}</span>
						</LinkInline>
					))
				}
			</div>
		</div>

		<div class="flex w-full flex-col gap-2 border-t border-edge-subtle pt-2">
			<div class="flex items-center justify-between gap-3">
				<span class="text-xs font-bold uppercase tracking-widest text-channel-content-muted">
					{tTheme('label')}
				</span>
				<ThemeToggle />
			</div>
			<div class="flex items-center justify-between gap-3">
				<span class="text-xs font-bold uppercase tracking-widest text-channel-content-muted">
					{tRecruiter('language')}
				</span>
				<LanguagePicker {localizedPaths} currentLang={lang} />
			</div>
		</div>
	</div>
</div>

<style>
	.recruiter-hud {
		transition:
			opacity 180ms ease-out,
			transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
			visibility 0s linear 0s;
	}

	.recruiter-panel {
		opacity: 0;
		pointer-events: none;
		transform: translateY(0.5rem) scale(0.985);
		transform-origin: bottom right;
		visibility: hidden;
		transition:
			opacity 180ms ease-out,
			transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
			visibility 0s linear 220ms;
	}

	.recruiter-hud[data-open='true'] .recruiter-panel {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0) scale(1);
		visibility: visible;
		transition-delay: 0s;
	}

	.recruiter-hud[data-footer-hidden='true'] {
		opacity: 0;
		pointer-events: none;
		transform: translateY(0.5rem);
		visibility: hidden;
		transition:
			opacity 180ms ease-out,
			transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
			visibility 0s linear 220ms;
	}

	@media (prefers-reduced-motion: reduce) {
		.recruiter-hud,
		.recruiter-panel {
			transition: none;
		}
	}
</style>

<script>
	const isOpen = (root: HTMLElement | null) => root?.dataset.open === 'true';

	const setOpen = (root: HTMLElement, open: boolean) => {
		const toggle = root.querySelector<HTMLButtonElement>('#recruiter-hud-toggle');
		const panel = root.querySelector<HTMLElement>('#recruiter-hud-panel');
		if (!toggle || !panel) return;

		root.dataset.open = String(open);
		toggle.setAttribute('aria-expanded', String(open));
		panel.setAttribute('aria-hidden', String(!open));

		if (open) {
			requestAnimationFrame(() => panel.querySelector<HTMLAnchorElement>('a')?.focus());
		} else if (document.activeElement && panel.contains(document.activeElement)) {
			toggle.focus();
		}
	};

	const setupHud = () => {
		const root = document.getElementById('recruiter-hud');
		if (!root || root.dataset.hudBound === 'true') return;
		root.dataset.hudBound = 'true';

		const toggle = root.querySelector<HTMLButtonElement>('#recruiter-hud-toggle');
		const close = root.querySelector<HTMLButtonElement>('#recruiter-hud-close');
		if (!toggle) return;

		toggle.addEventListener('click', () => setOpen(root, !isOpen(root)));
		close?.addEventListener('click', () => setOpen(root, false));

		root.addEventListener('keydown', event => {
			if (event.key === 'Escape' && isOpen(root)) {
				event.stopPropagation();
				setOpen(root, false);
			}
		});
	};

	setupHud();
	document.addEventListener('astro:page-load', setupHud);

	document.addEventListener('click', event => {
		const root = document.getElementById('recruiter-hud');
		if (!root || !isOpen(root)) return;
		const target = event.target;
		if (target instanceof Node && !root.contains(target)) setOpen(root, false);
	});

	document.addEventListener('keydown', event => {
		if (event.key !== 'Escape') return;
		const root = document.getElementById('recruiter-hud');
		if (!root || !isOpen(root)) return;
		if (!root.contains(event.target as Node)) setOpen(root, false);
	});

	let footerObserver: IntersectionObserver | null = null;

	const observeFooterCta = () => {
		footerObserver?.disconnect();
		const footer = document.getElementById('contact');
		if (!footer) return;

		footerObserver ??= new IntersectionObserver(entries => {
			entries.forEach(entry => {
				const hud = document.getElementById('recruiter-hud');
				if (!hud) return;
				hud.dataset.footerHidden = String(entry.isIntersecting);
				if (entry.isIntersecting) setOpen(hud, false);
			});
		});
		footerObserver.observe(footer);
	};

	observeFooterCta();
	document.addEventListener('astro:page-load', observeFooterCta);
</script>
