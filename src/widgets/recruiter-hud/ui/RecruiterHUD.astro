---
import {
	createScopedUiTranslator,
	getLanguageFromLocale,
	Language,
	type LocalizedPathMap,
} from '@shared/config/i18n';
import { siteConfig } from '@shared/config/site.config';
import { LanguagePicker } from '@features/language-picker';
import { ThemeToggle } from '@features/theme-toggle';

interface Props {
	localizedPaths: LocalizedPathMap;
}

const { localizedPaths } = Astro.props;
const lang = getLanguageFromLocale(Astro.currentLocale);
const tRecruiter = createScopedUiTranslator(lang, 'recruiter');
const tTheme = createScopedUiTranslator(lang, 'theme');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const newTabLabel = tAccessibility('externalLink');
const resumeUrl = lang === Language.ENGLISH ? siteConfig.resume.en : siteConfig.resume.es;
const emailHref = `mailto:${siteConfig.email}?subject=${encodeURIComponent(tRecruiter('emailSubject'))}`;
---

<div id="recruiter-hud" class="fixed bottom-5 right-5 z-50 font-mono">
	<button
		id="recruiter-hud-toggle"
		type="button"
		class="flex items-center gap-2 px-4 py-3 bg-button-primary-background hover:bg-button-primary-background-hover text-button-primary-content border-2 border-button-border font-bold uppercase tracking-wider shadow-retro-md hover:shadow-retro-lg cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus focus-visible:ring-offset-2 focus-visible:ring-offset-channel-background-canvas"
		aria-label={tRecruiter('openPanel')}
		aria-controls="recruiter-hud-panel"
		aria-expanded="false"
	>
		<span aria-hidden="true">[ CV ]</span>
		<span class="sr-only sm:not-sr-only">{tRecruiter('openPanel')}</span>
	</button>

	<div
		id="recruiter-hud-panel"
		class="absolute bottom-16 right-0 w-[min(22rem,calc(100vw-2.5rem))] bg-channel-surface-default border-2 border-channel-edge-default p-5 shadow-retro-2xl hidden flex-col gap-4"
		role="dialog"
		aria-modal="false"
		aria-labelledby="recruiter-hud-title"
	>
		<div
			class="flex items-start justify-between gap-4 border-b-2 border-dashed border-channel-edge-subtle pb-3"
		>
			<div>
				<h2
					id="recruiter-hud-title"
					class="font-pixel-clean text-xl font-bold text-channel-accent-primary"
				>
					{tRecruiter('title')}
				</h2>
				<p class="mt-2 text-sm text-channel-content-strong">{tRecruiter('summary')}</p>
			</div>
			<button
				id="recruiter-hud-close"
				type="button"
				class="px-2 py-1 border border-channel-edge-default font-bold cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
				aria-label={tRecruiter('closePanel')}
			>
				<span aria-hidden="true">×</span>
			</button>
		</div>

		<p class="text-sm text-channel-content-muted">{tRecruiter('availability')}</p>

		<div class="grid gap-2">
			<a
				href={emailHref}
				class="w-full text-center px-4 py-2 bg-button-primary-background hover:bg-button-primary-background-hover text-button-primary-content font-bold uppercase tracking-wider border-2 border-button-border shadow-retro-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
			>
				{tRecruiter('sendEmail')}
			</a>
			<a
				href={resumeUrl}
				target="_blank"
				rel="noreferrer"
				class="w-full text-center px-4 py-2 bg-button-secondary-background hover:bg-button-secondary-background-hover text-button-secondary-content font-bold uppercase tracking-wider border-2 border-button-border shadow-retro-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
			>
				{tRecruiter('downloadResume')}
				<span class="sr-only"> {newTabLabel}</span>
			</a>
			<div class="grid grid-cols-2 gap-2">
				<a
					href={siteConfig.social.github}
					target="_blank"
					rel="noreferrer"
					class="text-center px-3 py-2 border-2 border-channel-edge-default font-bold uppercase hover:bg-channel-surface-highlight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
				>
					{tRecruiter('github')}
					<span class="sr-only"> {newTabLabel}</span>
				</a>
				<a
					href={siteConfig.social.linkedin}
					target="_blank"
					rel="noreferrer"
					class="text-center px-3 py-2 border-2 border-channel-edge-default font-bold uppercase hover:bg-channel-surface-highlight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus"
				>
					{tRecruiter('linkedin')}
					<span class="sr-only"> {newTabLabel}</span>
				</a>
			</div>
		</div>

		<div
			class="flex items-center justify-between gap-3 border-t border-channel-edge-subtle pt-3"
		>
			<span class="text-xs font-bold text-channel-content-muted uppercase tracking-widest">
				{tTheme('label')}
			</span>
			<ThemeToggle />
		</div>

		<div
			class="flex items-center justify-between gap-3 border-t border-channel-edge-subtle pt-3"
		>
			<span class="text-xs font-bold text-channel-content-muted uppercase tracking-widest">
				{tRecruiter('language')}
			</span>
			<LanguagePicker {localizedPaths} currentLang={lang} />
		</div>
	</div>
</div>

<script is:inline data-astro-rerun>
	(function () {
		const root = document.getElementById('recruiter-hud');
		if (!root || root.dataset.bound === 'true') return;
		root.dataset.bound = 'true';

		const toggle = root.querySelector('#recruiter-hud-toggle');
		const close = root.querySelector('#recruiter-hud-close');
		const panel = root.querySelector('#recruiter-hud-panel');

		if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

		const setOpen = open => {
			panel.classList.toggle('hidden', !open);
			panel.classList.toggle('flex', open);
			toggle.setAttribute('aria-expanded', String(open));
			if (open) {
				const firstLink = panel.querySelector('a, button');
				if (firstLink instanceof HTMLElement) firstLink.focus();
			}
		};

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		close?.addEventListener('click', () => {
			setOpen(false);
			toggle.focus();
		});

		root.addEventListener('keydown', event => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});
	})();
</script>
