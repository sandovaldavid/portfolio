---
import type { render } from 'astro:content';
import ArrowLeftIcon from '@assets/icons/ArrowLeft.astro';
import ArrowRightIcon from '@assets/icons/ArrowRight.astro';
import type { BlogPost } from '@entities/blog';
import { Avatar, LinkInline } from '@shared/ui';

interface Props {
	post: BlogPost;
	Content: Awaited<ReturnType<typeof render>>['Content'];
	backText: string;
	backLink: string;
	publishedLabel: string;
	updatedLabel: string;
	tagsLabel: string;
	previousPost?: {
		title: string;
		href: string;
	};
	nextPost?: {
		title: string;
		href: string;
	};
	previousLabel?: string;
	nextLabel?: string;
	paginationLabel?: string;
	authorRole?: string;
	authorBio?: string;
}

const {
	post,
	Content,
	backText,
	backLink,
	publishedLabel,
	updatedLabel,
	tagsLabel,
	previousPost,
	nextPost,
	previousLabel,
	nextLabel,
	paginationLabel,
	authorRole,
	authorBio,
} = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;

const authorName = 'David Sandoval';

/*
 * Blog detail composition:
 * - Shell clearance: pt-18 matches fixed navbar contract.
 * - Header: full-bleed canvas banner with back navigation, date chips, title, description, and retro tags.
 * - Reading column: centered max-w-190 (760px) container providing consistent reading rhythm.
 * - Typography & Code blocks: retro borders, monospace code slabs, and high-contrast blockquotes.
 * - Sign-off: retro author card followed by sequential previous/next article navigation.
 */
const articleBodyClasses =
	'article-body prose prose-neutral max-w-none dark:prose-invert ' +
	'[&_h2]:font-mono [&_h2]:font-bold [&_h2]:tracking-[-0.5px] [&_h2]:text-content-strong [&_h2]:mt-10 [&_h2]:mb-4 ' +
	'[&_h3]:font-mono [&_h3]:font-semibold [&_h3]:text-content-strong [&_h3]:mt-8 [&_h3]:mb-3 ' +
	'[&_p]:font-sans [&_p]:text-content-default [&_p]:leading-relaxed [&_p]:mb-5 ' +
	'[&_ul]:font-sans [&_ul]:text-content-default [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-5 ' +
	'[&_ol]:font-sans [&_ol]:text-content-default [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-5 ' +
	'[&_li]:mb-2 ' +
	'[&_blockquote]:border-l-4 [&_blockquote]:border-channel-accent-primary [&_blockquote]:bg-channel-surface-highlight [&_blockquote]:px-5 [&_blockquote]:py-3 [&_blockquote]:not-italic [&_blockquote]:my-6 ' +
	'[&_pre]:overflow-x-auto [&_pre]:rounded-none [&_pre]:border-2 [&_pre]:border-edge-strong [&_pre]:bg-channel-surface-default [&_pre]:p-4 [&_pre]:shadow-retro-md [&_pre]:my-6 ' +
	'[&_code]:font-mono [&_code]:text-channel-accent-primary ' +
	'[&_a]:text-channel-accent-primary [&_a]:underline [&_a]:underline-offset-4 [&_a]:hover:opacity-80';
---

<article class="w-full pt-18">
	<header class="w-full border-b border-edge-subtle bg-channel-background-canvas px-5 py-8 md:px-8 md:py-10 lg:px-20 lg:py-12">
		<div class="mx-auto flex w-full max-w-320 flex-col gap-6">
			<nav aria-label={backText}>
				<LinkInline
					href={backLink}
					class="inline-flex items-center gap-2 self-start text-sm"
				>
					<ArrowLeftIcon class="size-4 shrink-0" aria-hidden="true" />
					{backText}
				</LinkInline>
			</nav>

			<div class="flex flex-col gap-4">
				<div class="flex flex-wrap items-center gap-3">
					<span class="inline-flex items-center rounded-none border border-edge-subtle bg-channel-surface-highlight px-2.5 py-1 text-caption text-content-muted">
						{publishedLabel}:
						<time
							datetime={pubDate.toISOString()}
							class="ml-1.5 font-mono text-content-strong"
						>
							{pubDate.toISOString().split('T')[0]}
						</time>
					</span>
					{updatedDate && (
						<span class="inline-flex items-center rounded-none border border-channel-accent-primary/40 bg-badge-brand-bg px-2.5 py-1 text-editorial-label uppercase text-channel-accent-primary">
							{updatedLabel}:
							<time datetime={updatedDate.toISOString()} class="ml-1.5 font-mono">
								{updatedDate.toISOString().split('T')[0]}
							</time>
						</span>
					)}
				</div>

				<h1 class="max-w-220 text-page-title-mobile text-content-strong md:text-page-title">
					{title}
				</h1>

				<p class="max-w-200 text-body text-content-default">{description}</p>

				{tags.length > 0 && (
					<ul class="flex flex-wrap items-center gap-2 pt-1" aria-label={tagsLabel}>
						{tags.map(tag => (
							<li class="inline-flex items-center rounded-none border border-badge-brand-outline-border bg-badge-brand-bg px-2.5 py-1 font-retro-tag text-xs font-bold uppercase tracking-wide text-badge-brand-text">
								{tag}
							</li>
						))}
					</ul>
				)}
			</div>
		</div>
	</header>

	<div class="w-full bg-channel-background-canvas px-5 py-10 md:px-8 md:py-14 lg:px-20 lg:py-16">
		<div class="mx-auto w-full max-w-190">
			<div class={articleBodyClasses}>
				<Content />
			</div>

			<footer class="mt-14 flex flex-col gap-8 border-t-2 border-edge-strong pt-8">
				{authorRole && authorBio && (
					<div class="flex flex-col items-start gap-4 border-2 border-edge-strong bg-channel-surface-default p-5 shadow-retro-md sm:flex-row sm:items-center">
						<Avatar
							src="/profile/perfil.webp"
							alt={authorName}
							size="sm"
							class="shrink-0"
						/>
						<div class="flex flex-col gap-1">
							<strong class="font-mono text-base text-content-strong">
								{authorName}
							</strong>
							<p class="font-mono text-caption text-channel-accent-primary">
								{authorRole}
							</p>
							<p class="text-sm text-content-default">{authorBio}</p>
						</div>
					</div>
				)}

				{(previousPost || nextPost) && (
					<nav class="grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label={paginationLabel}>
						{previousPost ? (
							<a
								href={previousPost.href}
								class="group flex flex-col gap-1 border-2 border-edge-strong bg-channel-surface-default p-4 shadow-retro-md transition-[box-shadow] duration-100 hover:shadow-retro-xl"
							>
								<span class="flex items-center gap-1 font-mono text-caption text-content-muted">
									<ArrowLeftIcon class="size-3.5 shrink-0" aria-hidden="true" />
									{previousLabel}
								</span>
								<span class="line-clamp-2 font-mono text-sm font-medium text-content-strong group-hover:text-channel-accent-primary">
									{previousPost.title}
								</span>
							</a>
						) : (
							<div />
						)}
						{nextPost ? (
							<a
								href={nextPost.href}
								class="group flex flex-col items-end gap-1 border-2 border-edge-strong bg-channel-surface-default p-4 text-right shadow-retro-md transition-[box-shadow] duration-100 hover:shadow-retro-xl sm:col-start-2"
							>
								<span class="flex items-center gap-1 font-mono text-caption text-content-muted">
									{nextLabel}
									<ArrowRightIcon class="size-3.5 shrink-0" aria-hidden="true" />
								</span>
								<span class="line-clamp-2 font-mono text-sm font-medium text-content-strong group-hover:text-channel-accent-primary">
									{nextPost.title}
								</span>
							</a>
						) : (
							<div />
						)}
					</nav>
				)}
			</footer>
		</div>
	</div>
</article>
