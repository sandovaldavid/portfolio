---
import type { BlogPost } from '@entities/blog';
import { EditorialCard } from '@shared/ui';

interface Props {
	post: BlogPost;
	label: string;
	readMoreText: string;
	readMoreLink: string;
	/** Heading level for the card title inside the page outline. */
	headingLevel?: 'h2' | 'h3';
}

const { post, label, readMoreText, readMoreLink, headingLevel = 'h2' } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<EditorialCard
	typeLabel={label}
	metaText={pubDate.toISOString().split('T')[0]}
	datetime={pubDate.toISOString()}
	{tags}
	{title}
	{description}
	ctaText={readMoreText}
	ctaHref={readMoreLink}
	{headingLevel}
/>
