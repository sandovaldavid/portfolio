---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getBlogPosts, getBlogSlug } from '@entities/blog';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import BlogCard from './BlogCard.astro';

/*
 * Blog list composition (spec/04 "Blog List" + plans/pages/blog-list.md):
 * intro inside the 1280 container — kicker ENGINEERING NOTES / NOTAS DE
 * INGENIERÍA, title and body line — followed by the centered Editorial Card
 * pair (520 + 32 + 520 desktop, x0/x401 pairs in the 770 tablet column,
 * single 340 stack with 24px gap on mobile). Vertical rhythm stays
 * content-driven so translated copy grows without clipping.
 */
const lang = getLanguageFromLocale(Astro.currentLocale);
const tBlog = createScopedUiTranslator(lang, 'pages.blog');
const posts = await getBlogPosts(lang);
---

<div class="w-full px-5 md:px-8 lg:px-0">
	<div class="mx-auto flex w-full max-w-[1280px] flex-col">
		<header aria-labelledby="blog-list-title">
			<p class="text-editorial-label uppercase tracking-[0.5px] text-channel-accent-primary">
				{tBlog('introKicker')}
			</p>
			<h1
				id="blog-list-title"
				class="mt-2 max-w-[720px] font-mono text-[40px] font-bold leading-12 tracking-[-0.5px] text-content-strong lg:text-[48px] lg:leading-14 lg:tracking-[-1px]"
			>
				{tBlog('introTitle')}
			</h1>
			<p class="mt-4 max-w-[720px] text-body text-content-muted">{tBlog('introBody')}</p>
		</header>

		<section class="pt-10 lg:pt-16" aria-label={tBlog('gridSectionLabel')}>
			<div
				class="flex w-full flex-col items-center gap-6 md:flex-row md:flex-wrap md:items-stretch md:justify-center md:gap-8"
			>
				{
					posts.map(post => (
						<div class="flex w-full max-w-[340px] md:max-w-[369px] lg:max-w-[520px]">
							<BlogCard
								post={post}
								label={tBlog('label')}
								readMoreText={tBlog('readMore')}
								readMoreLink={getRelativeLocaleUrl(
									lang,
									`blog/${getBlogSlug(post)}`
								)}
							/>
						</div>
					))
				}
			</div>
		</section>
	</div>
</div>
