---
import { normalizeQuotedDiagramLineBreaks } from '../model/diagram';

export type DiagramTone = 'brand' | 'info' | 'success' | 'secondary' | 'warning' | 'danger';

interface Props {
	title: string;
	description: string;
	chart: string;
	/** Optional stable color assignment for important actors. Unassigned nodes rotate through the semantic palette. */
	tones?: Partial<Record<string, DiagramTone>>;
}

interface DiagramNode {
	id: string;
	label: string;
	lines: string[];
	index: number;
	level: number;
	tone: DiagramTone;
	x: number;
	y: number;
}

interface DiagramEdge {
	from: string;
	to: string;
	label?: string;
	optional: boolean;
}

const { title, description, chart, tones = {} } = Astro.props;
const lines = normalizeQuotedDiagramLineBreaks(chart, title)
	.split('\n')
	.map(line => line.trim())
	.filter(line => line.length > 0 && !line.startsWith('%%'));
const header = lines[0]?.match(/^flowchart\s+(LR|TD)$/i);
if (!header) {
	throw new Error(`Unsupported case-study Mermaid header for "${title}". Use flowchart LR or flowchart TD.`);
}

const direction = header[1].toUpperCase() as 'LR' | 'TD';
const nodes = new Map<string, DiagramNode>();
const edges: DiagramEdge[] = [];
const nodeTokenPattern = /^([A-Za-z0-9_-]+)(?:\[(?:"([\s\S]+)"|([^\]]+))\])?$/;
const toneCycle: DiagramTone[] = ['brand', 'info', 'success', 'secondary', 'warning', 'danger'];
const toneTokens: Record<DiagramTone, { background: string; foreground: string }> = {
	brand: { background: 'var(--color-badge-brand-bg)', foreground: 'var(--color-badge-brand-text)' },
	info: { background: 'var(--color-badge-info-bg)', foreground: 'var(--color-badge-info-text)' },
	success: {
		background: 'var(--color-status-success-bg)',
		foreground: 'var(--color-status-success-text)',
	},
	secondary: {
		background: 'var(--color-badge-secondary-bg)',
		foreground: 'var(--color-badge-secondary-text)',
	},
	warning: {
		background: 'var(--color-badge-warning-bg)',
		foreground: 'var(--color-badge-warning-text)',
	},
	danger: {
		background: 'var(--color-badge-danger-bg)',
		foreground: 'var(--color-badge-danger-text)',
	},
};

const wrapLabel = (value: string, maxLength = 28): string[] => {
	const explicitLines = value.replaceAll('\\n', '\n').split('\n');
	const wrapped: string[] = [];

	for (const explicitLine of explicitLines) {
		const words = explicitLine.trim().split(/\s+/).filter(Boolean);
		if (words.length === 0) continue;
		let current = '';
		for (const word of words) {
			const next = current ? `${current} ${word}` : word;
			if (current && next.length > maxLength) {
				wrapped.push(current);
				current = word;
			} else {
				current = next;
			}
		}
		if (current) wrapped.push(current);
	}

	return wrapped.length > 0 ? wrapped : [value.trim()];
};

const parseNode = (token: string): DiagramNode => {
	const match = token.trim().match(nodeTokenPattern);
	if (!match) throw new Error(`Unsupported node syntax in diagram "${title}": ${token}`);
	const id = match[1];
	const existing = nodes.get(id);
	const rawLabel = match[2] ?? match[3];
	if (!rawLabel && existing) return existing;

	const label = (rawLabel ?? existing?.label ?? id).replaceAll('\\n', ' · ').trim();
	const node: DiagramNode = {
		id,
		label,
		lines: wrapLabel(rawLabel ?? existing?.label ?? id),
		index: existing?.index ?? nodes.size,
		level: existing?.level ?? 0,
		tone: tones[id] ?? existing?.tone ?? toneCycle[(existing?.index ?? nodes.size) % toneCycle.length],
		x: 0,
		y: 0,
	};
	nodes.set(id, node);
	return node;
};

for (const line of lines.slice(1)) {
	const dotted = line.match(/^(.+?)\s*-\.\s*(.*?)\s*\.->\s*(.+)$/);
	if (dotted) {
		const from = parseNode(dotted[1]);
		const to = parseNode(dotted[3]);
		const label = dotted[2].trim();
		edges.push({ from: from.id, to: to.id, ...(label ? { label } : {}), optional: true });
		continue;
	}

	const solid = line.match(/^(.+?)\s*-->\s*(?:\|([^|]+)\|\s*)?(.+)$/);
	if (solid) {
		const from = parseNode(solid[1]);
		const to = parseNode(solid[3]);
		const label = solid[2]?.trim();
		edges.push({ from: from.id, to: to.id, ...(label ? { label } : {}), optional: false });
		continue;
	}

	parseNode(line);
}

if (nodes.size === 0) throw new Error(`Diagram "${title}" has no nodes.`);
const nodeList = [...nodes.values()].sort((left, right) => left.index - right.index);
const nodeOrder = new Map(nodeList.map((node, index) => [node.id, index]));
const isForwardEdge = (edge: DiagramEdge) =>
	(nodeOrder.get(edge.to) ?? 0) > (nodeOrder.get(edge.from) ?? 0);

// Longest-path ranks keep the authored left-to-right / top-to-bottom flow readable.
// Cyclic/back edges are excluded from rank inflation and routed locally after layout.
for (let pass = 0; pass < nodeList.length; pass += 1) {
	let changed = false;
	for (const edge of edges) {
		if (!isForwardEdge(edge)) continue;
		const from = nodes.get(edge.from);
		const to = nodes.get(edge.to);
		if (!from || !to) continue;
		const nextLevel = from.level + 1;
		if (nextLevel > to.level) {
			to.level = nextLevel;
			changed = true;
		}
	}
	if (!changed) break;
}

// Secondary workers/migrators are often authored after the main chain. If they only feed a deep
// target, place them beside that target's previous rank instead of leaving them at the far-left root.
for (const node of nodeList) {
	if (node.level !== 0) continue;
	const incomingForward = edges.some(edge => edge.to === node.id && isForwardEdge(edge));
	if (incomingForward) continue;
	const targetLevels = edges
		.filter(edge => edge.from === node.id && isForwardEdge(edge))
		.map(edge => nodes.get(edge.to)?.level ?? 0)
		.filter(level => level > 1);
	if (targetLevels.length > 0) {
		node.level = Math.max(0, Math.min(...targetLevels) - 1);
	}
}

const levels = new Map<number, DiagramNode[]>();
for (const node of nodeList) {
	const levelNodes = levels.get(node.level) ?? [];
	levelNodes.push(node);
	levels.set(node.level, levelNodes);
}
const levelList = [...levels.entries()].sort(([left], [right]) => left - right);

const nodeWidth = 220;
const nodeHeight = 100;
const mainGap = 92;
const crossGap = 24;
const margin = 56;
const backEdgeOffset = 36;
const backEdgeStep = 16;
const maxCrossCount = Math.max(...levelList.map(([, levelNodes]) => levelNodes.length));
const levelCount = levelList.length;
const graphWidth =
	direction === 'LR'
		? margin * 2 + levelCount * nodeWidth + Math.max(0, levelCount - 1) * mainGap
		: margin * 2 + maxCrossCount * nodeWidth + Math.max(0, maxCrossCount - 1) * crossGap;
const graphHeight =
	direction === 'TD'
		? margin * 2 + levelCount * nodeHeight + Math.max(0, levelCount - 1) * mainGap
		: margin * 2 + maxCrossCount * nodeHeight + Math.max(0, maxCrossCount - 1) * crossGap;

for (let levelIndex = 0; levelIndex < levelList.length; levelIndex += 1) {
	const [, levelNodes] = levelList[levelIndex];
	const crossSize =
		direction === 'LR'
			? levelNodes.length * nodeHeight + Math.max(0, levelNodes.length - 1) * crossGap
			: levelNodes.length * nodeWidth + Math.max(0, levelNodes.length - 1) * crossGap;
	const crossAvailable = direction === 'LR' ? graphHeight : graphWidth;
	const crossStart = (crossAvailable - crossSize) / 2;

	for (let nodeIndex = 0; nodeIndex < levelNodes.length; nodeIndex += 1) {
		const node = levelNodes[nodeIndex];
		if (direction === 'LR') {
			node.x = margin + levelIndex * (nodeWidth + mainGap);
			node.y = crossStart + nodeIndex * (nodeHeight + crossGap);
		} else {
			node.x = crossStart + nodeIndex * (nodeWidth + crossGap);
			node.y = margin + levelIndex * (nodeHeight + mainGap);
		}
	}
}

const backEdges = edges.filter(edge => {
	const from = nodes.get(edge.from);
	const to = nodes.get(edge.to);
	return Boolean(from && to && to.level <= from.level);
});

const edgePath = (edge: DiagramEdge) => {
	const from = nodes.get(edge.from);
	const to = nodes.get(edge.to);
	if (!from || !to) return { path: '', labelX: 0, labelY: 0 };

	const fromCenterX = from.x + nodeWidth / 2;
	const fromCenterY = from.y + nodeHeight / 2;
	const toCenterX = to.x + nodeWidth / 2;
	const toCenterY = to.y + nodeHeight / 2;
	const backward = to.level <= from.level;

	if (direction === 'LR' && !backward) {
		const startX = from.x + nodeWidth;
		const endX = to.x;
		const controlX = (startX + endX) / 2;
		return {
			path: `M ${startX} ${fromCenterY} C ${controlX} ${fromCenterY}, ${controlX} ${toCenterY}, ${endX} ${toCenterY}`,
			labelX: controlX,
			labelY: (fromCenterY + toCenterY) / 2 - 14,
		};
	}

	if (direction === 'TD' && !backward) {
		const startY = from.y + nodeHeight;
		const endY = to.y;
		const controlY = (startY + endY) / 2;
		return {
			path: `M ${fromCenterX} ${startY} C ${fromCenterX} ${controlY}, ${toCenterX} ${controlY}, ${toCenterX} ${endY}`,
			labelX: (fromCenterX + toCenterX) / 2,
			labelY: controlY - 14,
		};
	}

	const laneIndex = Math.max(0, backEdges.indexOf(edge));
	const laneOffset = backEdgeOffset + laneIndex * backEdgeStep;
	if (direction === 'LR') {
		const useTopLane = fromCenterY <= toCenterY;
		const unclampedLaneY = useTopLane
			? Math.min(from.y, to.y) - laneOffset
			: Math.max(from.y + nodeHeight, to.y + nodeHeight) + laneOffset;
		const laneY = Math.max(12, Math.min(graphHeight - 12, unclampedLaneY));
		const startX = from.x;
		const endX = to.x + nodeWidth;
		return {
			path: `M ${startX} ${fromCenterY} C ${startX} ${laneY}, ${endX} ${laneY}, ${endX} ${toCenterY}`,
			labelX: (startX + endX) / 2,
			labelY: laneY + (useTopLane ? -10 : 10),
		};
	}

	const useLeftLane = fromCenterX <= toCenterX;
	const unclampedLaneX = useLeftLane
		? Math.min(from.x, to.x) - laneOffset
		: Math.max(from.x + nodeWidth, to.x + nodeWidth) + laneOffset;
	const laneX = Math.max(12, Math.min(graphWidth - 12, unclampedLaneX));
	const startY = from.y;
	const endY = to.y + nodeHeight;
	return {
		path: `M ${fromCenterX} ${startY} C ${laneX} ${startY}, ${laneX} ${endY}, ${toCenterX} ${endY}`,
		labelX: laneX + (useLeftLane ? -10 : 10),
		labelY: (startY + endY) / 2,
	};
};

const diagramHash = [...title]
	.reduce((hash, character) => (hash * 31 + character.charCodeAt(0)) >>> 0, 7)
	.toString(36);
const solidMarkerId = `diagram-arrow-${diagramHash}`;
const optionalMarkerId = `diagram-arrow-muted-${diagramHash}`;
const titleId = `diagram-title-${diagramHash}`;
const descriptionId = `diagram-description-${diagramHash}`;
---

<figure class="w-full" data-mermaid-figure data-diagram-direction={direction}>
	<div
		class="diagram-scroll overflow-x-auto overscroll-x-contain border-2 border-edge-strong bg-channel-surface-default p-3 shadow-retro-md md:p-5"
		data-mermaid-host
		data-mermaid-state="rendered"
	>
		<svg
			width={graphWidth}
			height={graphHeight}
			viewBox={`0 0 ${graphWidth} ${graphHeight}`}
			class="mx-auto block max-w-none"
			role="img"
			aria-labelledby={`${titleId} ${descriptionId}`}
			data-diagram-svg
		>
			<title id={titleId}>{title}</title>
			<desc id={descriptionId}>{description}</desc>
			<defs>
				<marker
					id={solidMarkerId}
					viewBox="0 0 10 10"
					refX="9"
					refY="5"
					markerWidth="7"
					markerHeight="7"
					orient="auto-start-reverse"
				>
					<path d="M 0 0 L 10 5 L 0 10 z" fill="var(--channel-accent-primary)"></path>
				</marker>
				<marker
					id={optionalMarkerId}
					viewBox="0 0 10 10"
					refX="9"
					refY="5"
					markerWidth="7"
					markerHeight="7"
					orient="auto-start-reverse"
				>
					<path d="M 0 0 L 10 5 L 0 10 z" fill="var(--channel-content-muted)"></path>
				</marker>
			</defs>

			<g aria-hidden="true" data-diagram-edges>
				{
					edges.map(edge => {
						const geometry = edgePath(edge);
						const stroke = edge.optional
							? 'var(--channel-content-muted)'
							: 'var(--channel-accent-primary)';
						const marker = edge.optional ? optionalMarkerId : solidMarkerId;
						const labelWidth = edge.label ? Math.max(64, edge.label.length * 7.25 + 20) : 0;
						return (
							<g data-diagram-edge data-edge-optional={String(edge.optional)}>
								<path
									d={geometry.path}
									fill="none"
									stroke={stroke}
									stroke-width={edge.optional ? '1.75' : '2.25'}
									stroke-dasharray={edge.optional ? '8 7' : undefined}
									marker-end={`url(#${marker})`}
								></path>
								{edge.label && (
									<g
										transform={`translate(${geometry.labelX - labelWidth / 2} ${geometry.labelY - 12})`}
									>
										<rect
											width={labelWidth}
											height="24"
											fill="var(--channel-surface-default)"
											stroke="var(--color-edge-subtle)"
											stroke-width="1"
										></rect>
										<text
											x={labelWidth / 2}
											y="16"
											text-anchor="middle"
											font-family="var(--font-mono)"
											font-size="12"
											font-weight="700"
											fill="var(--channel-content-default)"
										>
											{edge.label}
										</text>
									</g>
								)}
							</g>
						);
					})
				}
			</g>

			<g data-diagram-nodes>
				{
					nodeList.map(node => {
						const tone = toneTokens[node.tone];
						const lineHeight = 18;
						const firstLineY =
							node.y + nodeHeight / 2 - ((node.lines.length - 1) * lineHeight) / 2 + 5;
						return (
							<g data-diagram-node data-node-id={node.id} data-node-tone={node.tone}>
								<rect
									x={node.x}
									y={node.y}
									width={nodeWidth}
									height={nodeHeight}
									fill={tone.background}
									stroke={tone.foreground}
									stroke-width="2"
								></rect>
								<line
									x1={node.x + 2}
									y1={node.y + 2}
									x2={node.x + nodeWidth - 2}
									y2={node.y + 2}
									stroke={tone.foreground}
									stroke-width="4"
								></line>
								<text
									x={node.x + nodeWidth / 2}
									y={firstLineY}
									text-anchor="middle"
									font-family="var(--font-mono)"
									font-size="13"
									font-weight="700"
									fill={tone.foreground}
								>
									{node.lines.map((line, index) => (
										<tspan
											x={node.x + nodeWidth / 2}
											dy={index === 0 ? 0 : lineHeight}
										>
											{line}
										</tspan>
									))}
								</text>
								<title>{node.label}</title>
							</g>
						);
					})
				}
			</g>
		</svg>
	</div>
	<figcaption class="mt-3 text-caption leading-relaxed text-content-muted">
		<span class="font-bold text-content-strong">{title}.</span> {description}
	</figcaption>
</figure>

<style>
	.diagram-scroll {
		scrollbar-width: none;
	}

	.diagram-scroll::-webkit-scrollbar {
		display: none;
		width: 0;
		height: 0;
	}
</style>
