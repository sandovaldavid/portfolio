---
interface Props {
	title: string;
	description: string;
	chart: string;
}

interface DiagramNode {
	id: string;
	label: string;
}

interface DiagramEdge {
	from: string;
	to: string;
	label?: string;
	optional: boolean;
}

/**
 * MDX chart props are JavaScript template literals, so a Mermaid label written
 * with `\n` reaches this component as a physical line break. Normalize only
 * line breaks that occur inside quoted node labels before splitting statements.
 * This keeps authoring readable without accepting arbitrary Mermaid syntax.
 */
const normalizeQuotedLineBreaks = (value: string, diagramTitle: string): string => {
	let normalized = '';
	let inQuote = false;
	let escaped = false;

	for (const char of value.replaceAll('\r\n', '\n')) {
		if (char === '"' && !escaped) {
			inQuote = !inQuote;
		}

		if (char === '\n' && inQuote) {
			normalized += '\\n';
			escaped = false;
			continue;
		}

		normalized += char;
		if (char === '\\' && !escaped) {
			escaped = true;
		} else {
			escaped = false;
		}
	}

	if (inQuote) {
		throw new Error(`Unterminated quoted node label in diagram "${diagramTitle}".`);
	}

	return normalized;
};

const { title, description, chart } = Astro.props;
const lines = normalizeQuotedLineBreaks(chart, title)
	.split('\n')
	.map(line => line.trim())
	.filter(line => line.length > 0 && !line.startsWith('%%'));
const header = lines[0]?.match(/^flowchart\s+(LR|TD)$/i);
if (!header) {
	throw new Error(`Unsupported case-study Mermaid header for "${title}". Use flowchart LR or flowchart TD.`);
}

const direction = header[1].toUpperCase() as 'LR' | 'TD';
const nodes = new Map<string, DiagramNode>();
const edges: DiagramEdge[] = [];
const nodeTokenPattern = /^([A-Za-z0-9_-]+)(?:\[(?:"([\s\S]+)"|([^\]]+))\])?$/;

const parseNode = (token: string): DiagramNode => {
	const match = token.trim().match(nodeTokenPattern);
	if (!match) throw new Error(`Unsupported node syntax in diagram "${title}": ${token}`);
	const id = match[1];
	const label = (match[2] ?? match[3] ?? nodes.get(id)?.label ?? id)
		.replaceAll('\\n', ' · ')
		.trim();
	const node = { id, label };
	nodes.set(id, node);
	return node;
};

for (const line of lines.slice(1)) {
	const dotted = line.match(/^(.+?)\s*-\.\s*(.*?)\s*\.->\s*(.+)$/);
	if (dotted) {
		const from = parseNode(dotted[1]);
		const to = parseNode(dotted[3]);
		const label = dotted[2].trim();
		edges.push({ from: from.id, to: to.id, ...(label ? { label } : {}), optional: true });
		continue;
	}

	const solid = line.match(/^(.+?)\s*-->\s*(?:\|([^|]+)\|\s*)?(.+)$/);
	if (solid) {
		const from = parseNode(solid[1]);
		const to = parseNode(solid[3]);
		const label = solid[2]?.trim();
		edges.push({ from: from.id, to: to.id, ...(label ? { label } : {}), optional: false });
		continue;
	}

	parseNode(line);
}

if (nodes.size === 0) throw new Error(`Diagram "${title}" has no nodes.`);
const nodeList = [...nodes.values()];
---

<figure class="w-full" data-mermaid-figure data-diagram-direction={direction}>
	<div
		class="border-2 border-edge-strong bg-channel-surface-default p-4 shadow-retro-md md:p-6"
		role="img"
		aria-label={description}
		data-mermaid-host
		data-mermaid-state="rendered"
	>
		<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-diagram-nodes>
			{
				nodeList.map(node => (
					<div class="flex min-h-16 items-center justify-center border-2 border-edge-strong bg-channel-surface-highlight px-4 py-3 text-center text-code font-bold text-content-strong">
						{node.label}
					</div>
				))
			}
		</div>

		{
			edges.length > 0 && (
				<ol class="mt-5 grid gap-2" data-diagram-edges>
					{edges.map(edge => (
						<li class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 text-caption md:text-secondary">
							<span class="min-w-0 border border-edge-subtle bg-channel-background-canvas px-2 py-1 text-right font-mono text-content-strong">
								{nodes.get(edge.from)?.label}
							</span>
							<span class:list={['flex min-w-14 flex-col items-center text-center font-mono', edge.optional ? 'text-content-muted' : 'text-channel-accent-primary']}>
								{edge.label && <span class="max-w-28 text-caption">{edge.label}</span>}
								<span aria-hidden="true">{edge.optional ? '⇢' : '→'}</span>
							</span>
							<span class="min-w-0 border border-edge-subtle bg-channel-background-canvas px-2 py-1 font-mono text-content-strong">
								{nodes.get(edge.to)?.label}
							</span>
						</li>
					))}
				</ol>
			)
		}
	</div>
	<figcaption class="mt-3 text-caption text-content-muted">
		<span class="font-bold text-content-strong">{title}.</span> {description}
	</figcaption>
</figure>
