---
interface Props {
	title: string;
	description: string;
	chart: string;
}

const { title, description, chart } = Astro.props;
---

<figure class="w-full" data-mermaid-figure>
	<div
		class="mermaid-host min-h-48 overflow-x-auto border-2 border-edge-strong bg-channel-surface-default p-4 shadow-retro-md md:p-6"
		data-mermaid-host
		data-mermaid-state="pending"
		role="img"
		aria-label={description}
	>
		<pre
			class="mermaid-source overflow-x-auto whitespace-pre text-code text-content-muted"
			data-mermaid-source
		><code>{chart}</code></pre>
	</div>
	<figcaption class="mt-3 text-caption text-content-muted">
		<span class="font-bold text-content-strong">{title}.</span> {description}
	</figcaption>
</figure>

<script is:inline type="module">
	const MERMAID_URL = 'https://cdn.jsdelivr.net/npm/mermaid@11.17.0/dist/mermaid.esm.min.mjs';

	const getState = () => {
		window.__portfolioMermaid ??= {
			modulePromise: null,
			observer: null,
			counter: 0,
		};
		return window.__portfolioMermaid;
	};

	const loadMermaid = async () => {
		const state = getState();
		state.modulePromise ??= import(MERMAID_URL).then(module => module.default);
		const mermaid = await state.modulePromise;
		mermaid.initialize({
			startOnLoad: false,
			securityLevel: 'strict',
			theme: 'base',
			fontFamily: 'JetBrains Mono, monospace',
			flowchart: { htmlLabels: false, useMaxWidth: true, curve: 'linear' },
		});
		return mermaid;
	};

	const renderDiagram = async host => {
		if (host.dataset.mermaidState !== 'pending') return;
		host.dataset.mermaidState = 'loading';
		const source = host.querySelector('[data-mermaid-source]')?.textContent?.trim();
		if (!source) {
			host.dataset.mermaidState = 'failed';
			return;
		}

		try {
			const mermaid = await loadMermaid();
			const state = getState();
			state.counter += 1;
			const { svg, bindFunctions } = await mermaid.render(
				`portfolio-mermaid-${state.counter}`,
				source
			);
			host.innerHTML = svg;
			bindFunctions?.(host);
			host.dataset.mermaidState = 'rendered';
		} catch {
			host.dataset.mermaidState = 'failed';
		}
	};

	const observe = () => {
		const state = getState();
		state.observer ??= new IntersectionObserver(
			entries => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					state.observer.unobserve(entry.target);
					void renderDiagram(entry.target);
				}
			},
			{ rootMargin: '240px 0px' }
		);

		for (const host of document.querySelectorAll('[data-mermaid-host][data-mermaid-state="pending"]')) {
			state.observer.observe(host);
		}
	};

	if (!window.__portfolioMermaidEventsBound) {
		window.__portfolioMermaidEventsBound = true;
		document.addEventListener('astro:after-swap', observe);
	}
	observe();
</script>

<style>
	.mermaid-host :global(svg) {
		display: block;
		width: 100%;
		min-width: 38rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-mono) !important;
	}

	.mermaid-host :global(.node rect),
	.mermaid-host :global(.node polygon),
	.mermaid-host :global(.node circle),
	.mermaid-host :global(.node ellipse) {
		fill: var(--channel-surface-highlight) !important;
		stroke: var(--channel-edge-strong) !important;
		stroke-width: 2px !important;
	}

	.mermaid-host :global(.label),
	.mermaid-host :global(.nodeLabel),
	.mermaid-host :global(.edgeLabel),
	.mermaid-host :global(text) {
		color: var(--channel-content-strong) !important;
		fill: var(--channel-content-strong) !important;
		font-family: var(--font-mono) !important;
	}

	.mermaid-host :global(.edgeLabel rect),
	.mermaid-host :global(.labelBkg) {
		fill: var(--channel-background-canvas) !important;
	}

	.mermaid-host :global(.flowchart-link),
	.mermaid-host :global(.edge-pattern-solid),
	.mermaid-host :global(.edge-pattern-dashed) {
		stroke: var(--channel-accent-primary) !important;
		stroke-width: 2px !important;
	}

	.mermaid-host :global(marker path) {
		fill: var(--channel-accent-primary) !important;
		stroke: var(--channel-accent-primary) !important;
	}

	@media (max-width: 47.999rem) {
		.mermaid-host :global(svg) {
			min-width: 34rem;
		}
	}
</style>
