---
import { getMermaidDirection, prepareMermaidChart, type DiagramTone } from '../model/diagram';

interface Props {
	title: string;
	description: string;
	chart: string;
	/** Optional stable semantic color assignment for important flowchart actors. */
	tones?: Partial<Record<string, DiagramTone>>;
}

const { title, description, chart, tones = {} } = Astro.props;
const preparedChart = prepareMermaidChart(chart, title, description, tones);
const direction = getMermaidDirection(chart);
const diagramHash = [...`${title}\u0000${chart}`]
	.reduce((hash, character) => (hash * 31 + character.charCodeAt(0)) >>> 0, 7)
	.toString(36);
---

<figure
	class="w-full"
	data-mermaid-figure
	data-diagram-direction={direction}
	data-diagram-density="balanced"
>
	<div
		class="diagram-scroll min-h-72 overflow-x-auto overscroll-x-contain border-2 border-edge-strong bg-channel-surface-default p-3 shadow-retro-md md:p-5"
		data-mermaid-host
		data-mermaid-id={diagramHash}
		data-mermaid-source={preparedChart}
		data-mermaid-state="pending"
		aria-busy="true"
	>
		<div
			class="flex min-h-64 flex-col items-center justify-center gap-3 px-4 text-center"
			role="img"
			aria-label={`${title}. ${description}`}
			data-mermaid-fallback
		>
			<span class="text-editorial-label text-channel-accent-primary">{title}</span>
			<span class="max-w-180 text-secondary text-content-muted">{description}</span>
		</div>
	</div>
	<figcaption class="mt-3 text-caption leading-relaxed text-content-muted">
		<span class="font-bold text-content-strong">{title}.</span>
		{description}
	</figcaption>
</figure>

<script>
	let mermaidPromise: Promise<(typeof import('mermaid'))['default']> | undefined;
	let renderSequence = 0;

	const getMermaid = () => {
		mermaidPromise ??= import('mermaid').then(({ default: mermaid }) => {
			mermaid.initialize({
				startOnLoad: false,
				securityLevel: 'strict',
				theme: 'base',
				htmlLabels: false,
				flowchart: {
					useMaxWidth: false,
					curve: 'basis',
					nodeSpacing: 40,
					rankSpacing: 72,
				},
			});
			return mermaid;
		});
		return mermaidPromise;
	};

	const renderHost = async (host: HTMLElement) => {
		if (host.dataset.mermaidState !== 'pending') return;
		const source = host.dataset.mermaidSource;
		if (!source) return;

		host.dataset.mermaidState = 'loading';

		try {
			await document.fonts.ready;
			const mermaid = await getMermaid();
			const renderId = `portfolio-mermaid-${host.dataset.mermaidId ?? 'diagram'}-${renderSequence++}`;
			const { svg, bindFunctions } = await mermaid.render(renderId, source);

			host.innerHTML = svg;
			const svgElement = host.querySelector('svg');
			if (!svgElement) throw new Error('Mermaid rendered without an SVG root.');

			const viewBox = svgElement.getAttribute('viewBox')?.trim().split(/\s+/).map(Number);
			if (viewBox?.length === 4 && viewBox.every(Number.isFinite)) {
				const [, , width, height] = viewBox;
				if (width > 0 && height > 0) {
					svgElement.setAttribute('width', String(Math.ceil(width)));
					svgElement.setAttribute('height', String(Math.ceil(height)));
				}
			}

			svgElement.removeAttribute('style');
			svgElement.setAttribute('role', 'img');
			svgElement.setAttribute('preserveAspectRatio', 'xMidYMid meet');
			svgElement.setAttribute('data-diagram-svg', '');
			bindFunctions?.(host);
			host.dataset.mermaidState = 'rendered';
			host.removeAttribute('aria-busy');
			host.removeAttribute('data-mermaid-source');
		} catch (error) {
			host.dataset.mermaidState = 'error';
			host.removeAttribute('aria-busy');
			console.error('[MermaidDiagram] Failed to render diagram.', error);
		}
	};

	const initializeMermaidHosts = () => {
		const hosts = Array.from(
			document.querySelectorAll<HTMLElement>(
				'[data-mermaid-host][data-mermaid-state="pending"]'
			)
		);
		if (hosts.length === 0) return;

		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver(
				entries => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						observer.unobserve(entry.target);
						void renderHost(entry.target as HTMLElement);
					}
				},
				{ rootMargin: '600px 0px' }
			);
			hosts.forEach(host => observer.observe(host));
		} else {
			hosts.forEach(host => void renderHost(host));
		}
	};

	initializeMermaidHosts();
	document.addEventListener('astro:page-load', initializeMermaidHosts);

	window.addEventListener('beforeprint', () => {
		document
			.querySelectorAll<HTMLElement>('[data-mermaid-host][data-mermaid-state="pending"]')
			.forEach(host => void renderHost(host));
	});
</script>

<style>
	.diagram-scroll {
		scrollbar-width: none;
		touch-action: pan-x pan-y;
	}

	.diagram-scroll::-webkit-scrollbar {
		display: none;
		width: 0;
		height: 0;
	}

	.diagram-scroll :global(svg) {
		display: block;
		height: auto;
		max-width: none;
		margin-inline: auto;
		font-family: var(--font-mono) !important;
	}

	.diagram-scroll :global(svg text),
	.diagram-scroll :global(svg .nodeLabel),
	.diagram-scroll :global(svg .edgeLabel) {
		font-family: var(--font-mono) !important;
		fill: var(--channel-content-default) !important;
		color: var(--channel-content-default) !important;
	}

	.diagram-scroll :global(.node rect),
	.diagram-scroll :global(.node polygon),
	.diagram-scroll :global(.node path) {
		fill: var(--channel-surface-default) !important;
		stroke: var(--color-edge-strong) !important;
		stroke-width: 2px !important;
	}

	.diagram-scroll :global(.flowchart-link),
	.diagram-scroll :global(.edgePath path) {
		stroke: var(--channel-accent-primary) !important;
		stroke-width: 2.25px !important;
	}

	.diagram-scroll :global(marker path) {
		fill: var(--channel-accent-primary) !important;
		stroke: var(--channel-accent-primary) !important;
	}

	.diagram-scroll :global(.edgeLabel rect),
	.diagram-scroll :global(.labelBkg) {
		fill: var(--channel-surface-default) !important;
		stroke: var(--color-edge-subtle) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-brand rect),
	.diagram-scroll :global(g.portfolio-tone-brand polygon),
	.diagram-scroll :global(g.portfolio-tone-brand path) {
		fill: var(--color-badge-brand-bg) !important;
		stroke: var(--color-badge-brand-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-info rect),
	.diagram-scroll :global(g.portfolio-tone-info polygon),
	.diagram-scroll :global(g.portfolio-tone-info path) {
		fill: var(--color-badge-info-bg) !important;
		stroke: var(--color-badge-info-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-success rect),
	.diagram-scroll :global(g.portfolio-tone-success polygon),
	.diagram-scroll :global(g.portfolio-tone-success path) {
		fill: var(--color-status-success-bg) !important;
		stroke: var(--color-status-success-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-secondary rect),
	.diagram-scroll :global(g.portfolio-tone-secondary polygon),
	.diagram-scroll :global(g.portfolio-tone-secondary path) {
		fill: var(--color-badge-secondary-bg) !important;
		stroke: var(--color-badge-secondary-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-warning rect),
	.diagram-scroll :global(g.portfolio-tone-warning polygon),
	.diagram-scroll :global(g.portfolio-tone-warning path) {
		fill: var(--color-badge-warning-bg) !important;
		stroke: var(--color-badge-warning-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-danger rect),
	.diagram-scroll :global(g.portfolio-tone-danger polygon),
	.diagram-scroll :global(g.portfolio-tone-danger path) {
		fill: var(--color-badge-danger-bg) !important;
		stroke: var(--color-badge-danger-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-brand text),
	.diagram-scroll :global(g.portfolio-tone-brand .nodeLabel) {
		fill: var(--color-badge-brand-text) !important;
		color: var(--color-badge-brand-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-info text),
	.diagram-scroll :global(g.portfolio-tone-info .nodeLabel) {
		fill: var(--color-badge-info-text) !important;
		color: var(--color-badge-info-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-success text),
	.diagram-scroll :global(g.portfolio-tone-success .nodeLabel) {
		fill: var(--color-status-success-text) !important;
		color: var(--color-status-success-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-secondary text),
	.diagram-scroll :global(g.portfolio-tone-secondary .nodeLabel) {
		fill: var(--color-badge-secondary-text) !important;
		color: var(--color-badge-secondary-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-warning text),
	.diagram-scroll :global(g.portfolio-tone-warning .nodeLabel) {
		fill: var(--color-badge-warning-text) !important;
		color: var(--color-badge-warning-text) !important;
	}

	.diagram-scroll :global(g.portfolio-tone-danger text),
	.diagram-scroll :global(g.portfolio-tone-danger .nodeLabel) {
		fill: var(--color-badge-danger-text) !important;
		color: var(--color-badge-danger-text) !important;
	}

	@media (min-width: 768px) {
		.diagram-scroll :global(svg) {
			max-width: 100%;
		}
	}

	@media print {
		.diagram-scroll {
			overflow: visible;
			box-shadow: none;
		}

		.diagram-scroll :global(svg) {
			max-width: 100%;
		}
	}
</style>
