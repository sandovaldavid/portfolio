---
import { Badge } from '@shared/ui';
import type { ProjectItem } from '@entities/project';
import {
	createScopedUiTranslator,
	getLanguageFromLocale,
	type Language,
} from '@shared/config/i18n';

interface Props {
	project: ProjectItem;
	lang?: Language;
}

const { project, lang = getLanguageFromLocale(Astro.currentLocale) } = Astro.props;
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const newTabLabel = tAccessibility('externalLink');
const { status } = project.caseStudy;
const lifecycleBadgeVariant = {
	active: 'success',
	maintained: 'default',
	experimental: 'warning',
	archived: 'default',
	deprecated: 'danger',
} as const;
---

<article class="w-full pt-18" data-project-case-study="mdx">
	<header
		class="w-full bg-channel-background-canvas px-5 py-8 md:px-8 md:py-10 lg:px-20 lg:py-12"
		data-case-study-hero
	>
		<div
			class="mx-auto grid w-full max-w-320 gap-4 lg:grid-cols-[minmax(0,640px)_minmax(0,560px)] lg:items-center lg:gap-20"
			data-case-study-hero-shell
		>
			<div class="flex min-w-0 flex-col gap-2">
				<p class="text-editorial-label-compact uppercase text-channel-accent-primary md:text-editorial-label">
					{project.caseStudy.kicker}
				</p>
				<h1 class="text-page-title-mobile text-content-strong md:text-page-title lg:text-hero-display">
					{project.title}
				</h1>
			</div>

			<div class="flex min-w-0 flex-col gap-4">
				<p class="text-secondary text-content-default md:text-body">{project.description}</p>
				<div
					class="flex flex-wrap items-center gap-3"
					aria-label={`${status.lifecycle}, ${status.source}, ${status.demo}`}
				>
					<Badge variant={lifecycleBadgeVariant[project.lifecycle]} size="sm">
						{status.lifecycle}
					</Badge>
					{
						project.github && project.sourceAccess === 'public' ? (
							<a
								href={project.github}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${status.source}, ${newTabLabel}`}
								class="inline-flex no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus focus-visible:ring-offset-2 focus-visible:ring-offset-channel-background-canvas"
							>
								<Badge variant="info" size="sm">{status.source}</Badge>
							</a>
						) : (
							<Badge variant="info" size="sm">{status.source}</Badge>
						)
					}
					{
						project.link ? (
							<a
								href={project.link}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${status.demo}, ${newTabLabel}`}
								class="inline-flex no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-button-focus focus-visible:ring-offset-2 focus-visible:ring-offset-channel-background-canvas"
							>
								<Badge variant="default" size="sm">{status.demo}</Badge>
							</a>
						) : (
							<Badge variant="default" size="sm">{status.demo}</Badge>
						)
					}
				</div>
			</div>
		</div>
	</header>

	<div class="w-full" data-case-study-content>
		<slot />
	</div>
</article>
