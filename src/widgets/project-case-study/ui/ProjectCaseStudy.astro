---
import { Badge } from '@shared/ui';
import type { ProjectItem } from '@entities/project';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import ProjectResources from './ProjectResources.astro';

interface Props {
	project: ProjectItem;
}

const { project } = Astro.props;
const lang = getLanguageFromLocale(Astro.currentLocale);
const tPage = createScopedUiTranslator(lang, 'pages.projects');
const tProjects = createScopedUiTranslator(lang, 'sections.projects');

const lifecycleBadgeVariant = {
	active: 'success',
	maintained: 'info',
	experimental: 'warning',
	archived: 'default',
	deprecated: 'danger',
} as const;

const lifecycleLabel = {
	active: tProjects('lifecycle.active'),
	maintained: tProjects('lifecycle.maintained'),
	experimental: tProjects('lifecycle.experimental'),
	archived: tProjects('lifecycle.archived'),
	deprecated: tProjects('lifecycle.deprecated'),
}[project.lifecycle];

const sourceLabel = {
	public: tPage('sourcePublic'),
	private: tPage('sourcePrivate'),
	mixed: tPage('sourceMixed'),
}[project.sourceAccess];

const sourceBadgeVariant = {
	public: 'info',
	private: 'default',
	mixed: 'warning',
} as const;
const versionLabel = project.version ? `${tPage('versionPrefix')}${project.version}` : undefined;
const heroStatusLabel = [versionLabel, sourceLabel, lifecycleLabel].filter(Boolean).join(', ');
---

<article class="w-full pt-18" data-project-case-study="mdx">
	<header
		class="w-full bg-channel-background-canvas px-5 py-8 md:px-8 md:py-10 lg:px-20 lg:py-12"
		data-case-study-hero
	>
		<div
			class="mx-auto grid w-full max-w-320 gap-4 lg:grid-cols-[minmax(0,640px)_minmax(0,560px)] lg:items-center lg:gap-20"
			data-case-study-hero-shell
		>
			<div class="flex min-w-0 flex-col gap-2">
				<p
					class="text-editorial-label-compact uppercase text-channel-accent-primary md:text-editorial-label"
				>
					{project.caseStudy.kicker}
				</p>
				<h1 class="text-page-title-mobile text-content-strong md:text-page-title">
					{project.title}
				</h1>
			</div>

			<div class="flex min-w-0 flex-col gap-4">
				<p class="text-body text-content-default">
					{project.description}
				</p>
				<div
					class="flex flex-wrap items-center gap-3"
					aria-label={heroStatusLabel}
					data-project-status
				>
					{
						versionLabel && (
							<Badge variant="secondary" size="sm">
								{versionLabel}
							</Badge>
						)
					}
					<Badge variant={sourceBadgeVariant[project.sourceAccess]} size="sm">
						{sourceLabel}
					</Badge>
					<Badge variant={lifecycleBadgeVariant[project.lifecycle]} size="sm">
						{lifecycleLabel}
					</Badge>
				</div>
			</div>
		</div>
	</header>

	<ProjectResources projectId={project.projectId} />

	<div class="w-full" data-case-study-content>
		<slot />
	</div>
</article>
