---
interface Props {
	eyebrow?: string;
	title: string;
	surface?: 'canvas' | 'highlight';
	width?: 'auto' | 'wide' | 'reading';
	id?: string;
}

const { eyebrow, title, surface = 'canvas', width = 'auto', id } = Astro.props;
---

<section
	{id}
	class:list={[
		'w-full px-5 py-8 md:px-8 md:py-10 lg:px-20 lg:py-12',
		surface === 'highlight' ? 'bg-channel-surface-highlight' : 'bg-channel-background-canvas',
	]}
	data-case-study-section
>
	<div class="mx-auto w-full max-w-320">
		<div
			class:list={[width === 'reading' ? 'max-w-210' : 'w-full']}
			data-case-study-section-content
			data-case-study-width={width}
		>
			{
				eyebrow && (
					<p class="text-editorial-label-compact uppercase text-channel-accent-primary md:text-editorial-label">
						{eyebrow}
					</p>
				)
			}
			<h2
				class:list={[
					'text-feature-title text-content-strong md:text-section-title',
					eyebrow && 'mt-2',
				]}
			>
				{title}
			</h2>
			<div class="case-study-copy mt-5 text-body text-content-default">
				<slot />
			</div>
		</div>
	</div>
</section>

<style is:global>
	[data-case-study-width='auto']:not(
		:has([data-case-study-grid], [data-mermaid-figure], [data-project-gallery])
	) {
		max-width: 52.5rem;
	}

	.case-study-copy p + p,
	.case-study-copy p + ul,
	.case-study-copy p + ol,
	.case-study-copy ul + p,
	.case-study-copy ol + p {
		margin-top: 1rem;
	}

	.case-study-copy ul,
	.case-study-copy ol {
		padding-left: 1.25rem;
	}

	.case-study-copy ul {
		list-style: square;
	}

	.case-study-copy ol {
		list-style: decimal;
	}

	.case-study-copy li + li {
		margin-top: 0.5rem;
	}

	.case-study-copy strong {
		color: var(--channel-content-strong);
		font-weight: 700;
	}

	.case-study-copy code {
		font-family: var(--font-code);
		font-size: 0.875em;
	}
</style>
