---
import { Image } from 'astro:assets';
import GitHubIcon from '@assets/technologies/GitHub.astro';
import LinkIcon from '@assets/icons/Link.astro';
import ArrowLeftIcon from '@assets/icons/ArrowLeft.astro';
import { TechPill, LinkButton, LinkInline, ContentPanel, TitleSection } from '@shared/ui';
import type { ProjectItem } from '@entities/project';
import {
	createScopedUiTranslator,
	getLanguageFromLocale,
	type Language,
} from '@shared/config/i18n';

interface Props {
	project: ProjectItem;
	backLink: string;
	lang?: Language;
}

const { project, backLink, lang = getLanguageFromLocale(Astro.currentLocale) } = Astro.props;

const tProjects = createScopedUiTranslator(lang, 'sections.projects');
const tPage = createScopedUiTranslator(lang, 'pages.projects');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');

/*
 * Transitional renderer for case studies that have not yet received the v2
 * recruiter-facing presentation contract. Delete this file once every project
 * detail has been reviewed against the current Figma case-study family.
 */
const caseStudyLabel = `${tPage('caseStudyKicker')} · ${project.category}`;
const newTabLabel = tAccessibility('externalLink');

const { caseStudy } = project;
const evidence = caseStudy?.evidence;
const architecture = evidence?.architecture;

const architectureNodes = architecture
	? [
			{ accent: 'border-channel-status-error', lines: architecture.client.split('\n') },
			{ accent: 'border-channel-accent-primary', lines: architecture.api.split('\n') },
		]
	: [];
const architectureLeaves = architecture
	? [
			{ accent: 'border-badge-info-text', lines: architecture.identity.split('\n') },
			{
				accent: 'border-status-success-border',
				lines: architecture.modules.split('\n'),
			},
			{ accent: 'border-channel-accent-secondary', lines: architecture.database.split('\n') },
		]
	: [];
---

<div class="w-full font-sans px-5 md:px-8 lg:px-0">
	<div class="mx-auto flex w-full max-w-[1280px] flex-col">
		<LinkInline href={backLink} class="mb-8 inline-flex items-center gap-2 self-start text-sm">
			<ArrowLeftIcon class="size-4" />
			{tProjects('back')}
		</LinkInline>

		<header
			class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,640fr)_minmax(0,560fr)] lg:gap-x-20"
		>
			<div>
				<p class="text-editorial-label uppercase tracking-[0.5px] text-channel-accent-primary">
					{caseStudyLabel}
				</p>
				<h1
					class="mt-2 font-mono text-4xl font-bold leading-12 tracking-[-0.5px] text-content-strong lg:text-5xl lg:leading-14 lg:tracking-[-1px]"
				>
					{project.title}
				</h1>
				<p class="mt-4 max-w-[560px] text-body text-content-muted">{project.description}</p>

				<div class="mt-6 flex flex-wrap gap-3">
					{
						project.github && (
							<LinkButton href={project.github} {newTabLabel}>
								<GitHubIcon class="size-5" />
								{tProjects('codeButton')}
							</LinkButton>
						)
					}
					{
						project.link && (
							<LinkButton href={project.link} {newTabLabel}>
								<LinkIcon class="size-4" />
								{tProjects('previewButton')}
							</LinkButton>
						)
					}
				</div>

				<ul class="mt-6 flex flex-row flex-wrap gap-x-2 gap-y-1.5">
					{
						project.tags.map(tag => (
							<li>
								<TechPill
									label={tag.name}
									icon={tag.icon}
									size="sm"
									variant="card"
									class={tag.class}
								/>
							</li>
						))
					}
				</ul>
			</div>

			<div
				class="flex flex-col gap-5 border-2 border-edge-strong bg-channel-surface-default p-5 shadow-retro-md"
				aria-label={`${caseStudy.status.lifecycle}, ${caseStudy.status.source}, ${caseStudy.status.demo}`}
			>
				<dl class="grid gap-4 sm:grid-cols-3">
					<div>
						<dt class="font-retro-tag text-xs font-bold uppercase tracking-wide text-channel-accent-primary">
							{caseStudy.status.lifecycleLabel}
						</dt>
						<dd class="mt-1 text-secondary font-bold text-content-strong">
							{caseStudy.status.lifecycle}
						</dd>
					</div>
					<div>
						<dt class="font-retro-tag text-xs font-bold uppercase tracking-wide text-channel-accent-primary">
							{caseStudy.status.sourceLabel}
						</dt>
						<dd class="mt-1 text-secondary font-bold text-content-strong">
							{caseStudy.status.source}
						</dd>
					</div>
					<div>
						<dt class="font-retro-tag text-xs font-bold uppercase tracking-wide text-channel-accent-primary">
							{caseStudy.status.demoLabel}
						</dt>
						<dd class="mt-1 text-secondary font-bold text-content-strong">
							{caseStudy.status.demo}
						</dd>
					</div>
				</dl>

				<dl class="flex flex-wrap gap-x-8 gap-y-2 border-t border-edge-subtle pt-4">
					<div>
						<dt class="font-retro-tag text-xs font-bold uppercase tracking-wide text-channel-accent-primary">
							{tProjects('timeline')}
						</dt>
						<dd class="mt-1 text-secondary text-content-default">{caseStudy.timeline}</dd>
					</div>
					<div>
						<dt class="font-retro-tag text-xs font-bold uppercase tracking-wide text-channel-accent-primary">
							{tProjects('role')}
						</dt>
						<dd class="mt-1 text-secondary text-content-default">{caseStudy.role}</dd>
					</div>
				</dl>

				<div class="border-t border-edge-subtle pt-4">
					<p class="text-editorial-label uppercase tracking-wide text-channel-status-error">
						{caseStudy.status.limitationsLabel}
					</p>
					<ul class="mt-2 space-y-2">
						{caseStudy.status.limitations.map(item => <li class="text-secondary text-content-muted">{item}</li>)}
					</ul>
				</div>
			</div>
		</header>

		<figure class="relative mt-12 overflow-hidden border-2 border-edge-strong shadow-retro-md">
			<Image
				src={project.image}
				width={1200}
				height={630}
				class="h-auto w-full object-cover"
				alt={project.imageAlt}
				loading="eager"
				decoding="sync"
			/>
		</figure>

		<section
			class="mt-14 grid grid-cols-1 justify-center gap-6 md:grid-cols-[repeat(2,minmax(0,620px))]"
			aria-label={tPage('narrativeSectionLabel')}
		>
			<ContentPanel headingLevel="h2" title={tPage('problemLabel')}>
				<p class="text-base leading-relaxed">{caseStudy.problem}</p>
			</ContentPanel>
			<ContentPanel headingLevel="h2" title={tPage('approachLabel')}>
				<p class="text-base leading-relaxed">{caseStudy.approach}</p>
			</ContentPanel>
			<ContentPanel headingLevel="h2" title={tPage('tradeoffsLabel')}>
				<p class="text-base leading-relaxed">{caseStudy.tradeoffs}</p>
			</ContentPanel>
			<ContentPanel headingLevel="h2" title={tPage('outcomeLabel')}>
				<p class="text-base leading-relaxed">{caseStudy.outcome}</p>
			</ContentPanel>
		</section>

		{
			evidence && (
				<section class="mt-16">
					<TitleSection className="mb-8">{tPage('evidenceTitle')}</TitleSection>
					<div class="flex justify-center">
						<ContentPanel headingLevel="h3" variant="highlight" title={evidence.statusLabel}>
							<p class="font-mono text-sm font-bold text-content-strong">{evidence.status}</p>
							<p>{evidence.statusDetail}</p>
						</ContentPanel>
					</div>
					<div class="mt-6 grid grid-cols-1 justify-center gap-6 md:grid-cols-[repeat(2,minmax(0,620px))]">
						<ContentPanel headingLevel="h3" variant="success" title={evidence.implementedLabel}>
							<ul class="space-y-2.5">
								{evidence.implemented.map(item => (
									<li class="flex items-start gap-2">
										<span class="mt-[7px] size-1.5 shrink-0 bg-status-success-text" aria-hidden="true" />
										<span>{item}</span>
									</li>
								))}
							</ul>
						</ContentPanel>

						<ContentPanel headingLevel="h3" title={evidence.plannedLabel}>
							<ul class="space-y-2.5">
								{evidence.planned.map(item => (
									<li class="flex items-start gap-2">
										<span class="mt-[7px] size-1.5 shrink-0 bg-channel-accent-primary" aria-hidden="true" />
										<span>{item}</span>
									</li>
								))}
							</ul>
						</ContentPanel>

						<ContentPanel headingLevel="h3" variant="danger" title={evidence.limitationsLabel}>
							<ul class="space-y-2.5">
								{evidence.limitations.map(item => (
									<li class="flex items-start gap-2">
										<span class="mt-[7px] size-1.5 shrink-0 bg-channel-status-error" aria-hidden="true" />
										<span>{item}</span>
									</li>
								))}
							</ul>
						</ContentPanel>

						<ContentPanel headingLevel="h3" title={evidence.sourcesLabel}>
							<ul class="space-y-3">
								{evidence.sources.map(source => (
									<li class="border border-edge-subtle p-3">
										{source.href ? (
											<a
												href={source.href}
												target="_blank"
												rel="noopener noreferrer"
												class="font-mono text-sm font-bold text-channel-accent-primary underline decoration-2 underline-offset-4 hover:no-underline"
											>
												{source.label}
												<span class="sr-only">{' '}{tAccessibility('externalLink')}</span>
											</a>
										) : (
											<p class="font-mono text-sm font-bold text-content-strong">{source.label}</p>
										)}
										<p class="mt-1.5 text-secondary text-content-muted">{source.access}</p>
									</li>
								))}
							</ul>
						</ContentPanel>

						{architecture && (
							<figure class="w-full max-w-[1264px] border-2 border-edge-strong bg-channel-portfolio-terminal-surface p-5 shadow-retro-lg md:col-span-2">
								<div class="grid gap-4 md:grid-cols-[1fr_auto_1fr] md:items-center">
									{architectureNodes.map(node => (
										<div class:list={['border-2 bg-channel-portfolio-terminal-surface-raised p-4 text-center', node.accent]}>
											{node.lines.map((line, index) => (
												<p class:list={[index === 0 ? 'text-sm font-bold text-channel-portfolio-terminal-content' : 'mt-1 text-caption text-channel-portfolio-terminal-content-muted']}>
													{line}
												</p>
											))}
										</div>
									))}
									<div class="hidden text-2xl text-channel-portfolio-terminal-content md:block" aria-hidden="true">→</div>
								</div>

								<div class="my-4 text-center text-2xl text-channel-portfolio-terminal-content" aria-hidden="true">↓</div>

								<div class="grid gap-4 md:grid-cols-3">
									{architectureLeaves.map(node => (
										<div class:list={['border-2 bg-channel-portfolio-terminal-surface-raised p-4 text-center', node.accent]}>
											{node.lines.map((line, index) => (
												<p class:list={[index === 0 ? 'text-sm font-bold text-channel-portfolio-terminal-content' : 'mt-1 text-caption text-channel-portfolio-terminal-content-muted']}>
													{line}
												</p>
											))}
										</div>
									))}
								</div>

								<div class="mt-4 border-2 border-channel-edge-default bg-channel-portfolio-terminal-surface-raised p-4 text-center">
									{architecture.processes.split('\n').map((line, index) => (
										<p class:list={[index === 0 ? 'text-sm font-bold text-channel-portfolio-terminal-content' : 'mt-1 text-caption text-channel-portfolio-terminal-content-muted']}>
											{line}
										</p>
									))}
								</div>
								<figcaption class="mt-5 text-caption text-channel-portfolio-terminal-content-muted">{architecture.caption}</figcaption>
							</figure>
						)}
					</div>
				</section>
			)
		}

		<section class="mt-16 pb-2">
			<TitleSection className="mb-8">{tPage('learningsTitle')}</TitleSection>
			<div class="flex flex-col items-center gap-2.5 md:flex-row md:flex-wrap md:justify-center">
				{caseStudy.learnings.map(learning => <ContentPanel density="compact">{learning}</ContentPanel>)}
			</div>
		</section>
	</div>
</div>
