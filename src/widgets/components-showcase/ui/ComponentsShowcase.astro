---
import CodeIcon from '@assets/icons/Code.astro';
import MailIcon from '@assets/icons/Mail.astro';
import ArrowRightIcon from '@assets/icons/ArrowRight.astro';
import LinkedInIcon from '@assets/social-networks/LinkedIn.astro';
import GitHubIcon from '@assets/technologies/GitHub.astro';
import { createScopedUiTranslator, Language } from '@shared/config/i18n';
import {
	Avatar,
	Badge,
	Button,
	LinkButton,
	LinkInline,
	SectionContainer,
	SocialPill,
	TitleSection,
	TechPill,
} from '@shared/ui';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const tPage = createScopedUiTranslator(lang, 'pages.components');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const newTabLabel = tAccessibility('externalLink');
const avatarSizes = ['xs', 'sm', 'md', 'lg', 'responsive'] as const;
const badgeVariants = [
	'default',
	'primary',
	'secondary',
	'success',
	'warning',
	'danger',
	'info',
] as const;
const badgeVariantLabels = {
	default: 'defaultBadge',
	primary: 'primaryBadge',
	secondary: 'secondaryBadge',
	success: 'completedBadge',
	warning: 'warningBadge',
	danger: 'dangerBadge',
	info: 'infoBadge',
} as const;
---

<div class="px-4 py-16">
	<SectionContainer>
		<TitleSection>
			<CodeIcon aria-hidden="true" />
			{tPage('heading')}
		</TitleSection>

		<div class="space-y-16 mt-8">
			<section>
				<h2 class="text-2xl font-bold mb-3 text-content-strong">
					{tPage('buttonsHeading')}
				</h2>
				<p class="text-content-muted mb-4">{tPage('buttonsDescription')}</p>
				<p class="text-content-muted mb-4">
					{tPage('linksDescription')}
				</p>
				<div class="flex flex-wrap items-center gap-4">
					<LinkButton href="https://github.com" {newTabLabel} class="min-w-[190px]">
						<GitHubIcon aria-hidden="true" />
						{tPage('githubLabel')}
					</LinkButton>
					<LinkButton
						href="https://linkedin.com"
						{newTabLabel}
						variant="secondary"
						class="min-w-[190px]"
					>
						<LinkedInIcon aria-hidden="true" />
						{tPage('linkedinLabel')}
					</LinkButton>
					<LinkButton
						href="mailto:example@email.com"
						target="_self"
						class="min-w-[190px]"
					>
						<MailIcon aria-hidden="true" />
						{tPage('contactLabel')}
					</LinkButton>
				</div>
				<div class="mt-4 flex flex-wrap items-center gap-4">
					<LinkButton
						href="mailto:example@email.com"
						target="_self"
						disabled
						class="min-w-[190px]"
					>
						{tPage('disabledState')} · {tPage('primaryAction')}
					</LinkButton>
					<Button variant="secondary" disabled class="min-w-[190px]">
						{tPage('disabledState')} · {tPage('secondaryAction')}
					</Button>
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold mb-3 text-content-strong">
					{tPage('socialHeading')}
				</h2>
				<p class="text-content-muted mb-4">{tPage('socialDescription')}</p>
				<div class="flex flex-wrap gap-4">
					<SocialPill href="https://github.com" {newTabLabel}>
						<GitHubIcon aria-hidden="true" />
						{tPage('githubLabel')}
					</SocialPill>
					<SocialPill href="https://linkedin.com" {newTabLabel}>
						<LinkedInIcon aria-hidden="true" />
						{tPage('linkedinLabel')}
					</SocialPill>
					<SocialPill href="mailto:example@email.com" target="_self">
						<MailIcon aria-hidden="true" />
						{tPage('contactLabel')}
					</SocialPill>
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold mb-3 text-content-strong">
					{tPage('linksHeading')}
				</h2>
				<p class="text-content-muted mb-4">{tPage('linksDescription')}</p>
				<div class="flex flex-wrap gap-6">
					<LinkInline href="https://github.com" icon={GitHubIcon} {newTabLabel}>
						{tPage('profileLink')}
					</LinkInline>
					<LinkInline
						href="https://linkedin.com"
						icon={ArrowRightIcon}
						iconPosition="trailing"
						{newTabLabel}
					>
						{tPage('networkLink')}
					</LinkInline>
					<LinkInline href="mailto:example@email.com" target="_self">
						{tPage('contactLabel')}
					</LinkInline>
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold mb-3 text-content-strong">
					{tPage('avatarsHeading')}
				</h2>
				<p class="text-content-muted mb-4">{tPage('avatarsDescription')}</p>
				<div class="flex flex-wrap gap-8 items-end">
					{
						avatarSizes.map(size => (
							<div class="flex flex-col items-center gap-2">
								<Avatar
									src="/profile/perfil.webp"
									alt={tPage('profileAlt')}
									{size}
								/>
								<span class="text-sm text-content-muted uppercase">{size}</span>
							</div>
						))
					}
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold mb-3 text-content-strong">
					{tPage('badgesHeading')}
				</h2>
				<p class="text-content-muted mb-4">{tPage('badgesDescription')}</p>
				<div class="flex flex-wrap gap-3">
					{
						badgeVariants.map(variant => (
							<Badge variant={variant}>{tPage(badgeVariantLabels[variant])}</Badge>
						))
					}
					<Badge variant="info">
						<CodeIcon aria-hidden="true" />
						{tPage('typescriptLabel')}
					</Badge>
				</div>
				<div class="mt-4 flex flex-wrap items-center gap-3">
					<Badge variant="success" size="sm">{tPage('completedBadge')}</Badge>
					<Badge variant="success" size="md">{tPage('completedBadge')}</Badge>
					<Badge variant="success" size="lg">{tPage('completedBadge')}</Badge>
					<Badge variant="warning" size="sm">
						<CodeIcon aria-hidden="true" />
						{tPage('warningBadge')}
					</Badge>
					<Badge variant="danger" size="lg">
						<CodeIcon aria-hidden="true" />
						{tPage('dangerBadge')}
					</Badge>
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold mb-3 text-content-strong">
					{tPage('techPillsHeading')}
				</h2>
				<p class="text-content-muted mb-4">{tPage('techPillsDescription')}</p>
				<div class="flex flex-wrap items-center gap-3">
					<TechPill label={tPage('techPillShortLabel')} size="sm" variant="card" />
					<TechPill
						label={tPage('techPillShortLabel')}
						size="sm"
						variant="card"
						icon={CodeIcon}
					/>
					<TechPill label={tPage('typescriptLabel')} size="md" variant="card" />
					<TechPill
						label={tPage('typescriptLabel')}
						size="md"
						variant="card"
						icon={CodeIcon}
					/>
				</div>
				<div class="mt-4 flex flex-wrap items-center gap-3">
					<TechPill label={tPage('techPillShortLabel')} size="sm" variant="stack" />
					<TechPill
						label={tPage('techPillShortLabel')}
						size="sm"
						variant="stack"
						icon={CodeIcon}
					/>
					<TechPill label={tPage('typescriptLabel')} size="md" variant="stack" />
					<TechPill
						label={tPage('typescriptLabel')}
						size="md"
						variant="stack"
						icon={CodeIcon}
					/>
				</div>
				<div class="mt-4 flex flex-wrap items-center gap-3">
					<TechPill
						label={tPage('techPillLongLabel')}
						size="sm"
						variant="stack"
						icon={CodeIcon}
					/>
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold mb-3 text-content-strong">
					{tPage('containersHeading')}
				</h2>
				<p class="text-content-muted mb-4">{tPage('containersDescription')}</p>
				<SectionContainer class="bg-channel-surface-highlight p-8">
					<h3 class="text-xl font-semibold mb-3 text-content-strong">
						{tPage('containerTitle')}
					</h3>
					<p class="text-content">{tPage('containerBody')}</p>
				</SectionContainer>
			</section>

			<section>
				<h2 class="text-2xl font-bold mb-3 text-content-strong">
					{tPage('titlesHeading')}
				</h2>
				<p class="text-content-muted mb-4">{tPage('titlesDescription')}</p>
				<div class="space-y-6">
					<TitleSection>{tPage('simpleTitle')}</TitleSection>
					<TitleSection>
						<GitHubIcon aria-hidden="true" />
						{tPage('iconTitle')}
					</TitleSection>
					<TitleSection>
						<CodeIcon aria-hidden="true" />
						{tPage('featuredTitle')}
					</TitleSection>
					<div class="w-[340px]">
						<TitleSection className="mb-0">{tPage('wrappingTitle')}</TitleSection>
					</div>
				</div>
			</section>
		</div>
	</SectionContainer>
</div>
