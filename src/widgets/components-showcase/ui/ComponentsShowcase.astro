---
import ArrowRightIcon from '@assets/icons/ArrowRight.astro';
import ArrowUpRightIcon from '@assets/icons/ArrowUpRight.astro';
import MailIcon from '@assets/icons/Mail.astro';
import LinkedInIcon from '@assets/social-networks/LinkedIn.astro';
import GitHubIcon from '@assets/technologies/GitHub.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { createScopedUiTranslator, Language } from '@shared/config/i18n';
import { CORE_STACK } from '@shared/config/technology';
import {
	Avatar,
	Badge,
	BrandLogo,
	Button,
	LinkInline,
	SocialPill,
	TechPill,
	TitleSection,
} from '@shared/ui';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const tPage = createScopedUiTranslator(lang, 'pages.components');
const tAccessibility = createScopedUiTranslator(lang, 'accessibility');
const newTabLabel = tAccessibility('externalLink');
const homeUrl = getRelativeLocaleUrl(lang, '');

const avatarSizes = ['xs', 'sm', 'md', 'lg'] as const;
const badgeVariants = [
	'default',
	'primary',
	'secondary',
	'success',
	'warning',
	'danger',
	'info',
] as const;
const badgeVariantLabels = {
	default: 'defaultBadge',
	primary: 'primaryBadge',
	secondary: 'secondaryBadge',
	success: 'successBadge',
	warning: 'warningBadge',
	danger: 'dangerBadge',
	info: 'infoBadge',
} as const;
const showcasedTechnologies = [CORE_STACK[3], CORE_STACK[0], CORE_STACK[2], CORE_STACK[5]];
const panelClasses =
	'border border-channel-edge-subtle bg-channel-background-canvas p-4 md:p-5';
---

<div class="w-full">
	<header
		class="mx-auto flex w-full max-w-7xl flex-col gap-3 px-5 md:px-8"
		aria-labelledby="components-showcase-title"
	>
		<p class="text-editorial-label uppercase text-channel-accent-primary">
			{tPage('introKicker')}
		</p>
		<h1
			id="components-showcase-title"
			class="text-page-title-mobile text-channel-content-strong lg:text-page-title"
		>
			{tPage('heading')}
		</h1>
		<p class="max-w-180 text-body text-channel-content-default">{tPage('introDescription')}</p>
	</header>

	<section class="mt-12 w-full bg-channel-surface-highlight py-10 md:mt-14 md:py-12">
		<div class="mx-auto w-full max-w-7xl px-5 md:px-8">
			<TitleSection className="uppercase">
				<ArrowRightIcon class="text-channel-accent-primary" aria-hidden="true" />
				{tPage('sharedUiLabel')}
			</TitleSection>

			<div class="mt-6 grid gap-5">
				<section class={panelClasses} data-showcase-panel="buttons">
					<h2 class="text-editorial-label-compact uppercase text-channel-accent-primary">
						{tPage('buttonsHeading')}
					</h2>
					<div class="mt-4 flex flex-wrap items-center gap-4">
						<Button class="min-w-42">
							<ArrowUpRightIcon aria-hidden="true" />
							{tPage('primaryDefault')}
						</Button>
						<Button class="min-w-42 bg-button-primary-background-hover shadow-retro-xl">
							<ArrowUpRightIcon aria-hidden="true" />
							{tPage('primaryHover')}
						</Button>
						<Button variant="secondary" class="min-w-42">
							<ArrowUpRightIcon aria-hidden="true" />
							{tPage('secondaryDefault')}
						</Button>
						<Button
							variant="secondary"
							class="min-w-42 ring-2 ring-button-focus ring-offset-2 ring-offset-channel-background-canvas"
						>
							<ArrowUpRightIcon aria-hidden="true" />
							{tPage('secondaryFocus')}
						</Button>
						<Button variant="secondary" disabled class="min-w-42">
							<ArrowUpRightIcon aria-hidden="true" />
							{tPage('secondaryDisabled')}
						</Button>
					</div>
				</section>

				<section class={panelClasses} data-showcase-panel="badges">
					<h2 class="text-editorial-label-compact uppercase text-channel-accent-primary">
						{tPage('badgesHeading')}
					</h2>
					<div class="mt-4 flex flex-wrap items-center gap-3">
						{
							badgeVariants.map(variant => (
								<Badge variant={variant}>{tPage(badgeVariantLabels[variant])}</Badge>
							))
						}
					</div>
				</section>

				<section class={panelClasses} data-showcase-panel="tech-pills">
					<h2 class="text-editorial-label-compact uppercase text-channel-accent-primary">
						{tPage('techPillsHeading')}
					</h2>
					<ul class="mt-4 flex flex-wrap items-center gap-3" role="list">
						{
							showcasedTechnologies.map(({ name, icon }) => (
								<li>
									<TechPill label={name} icon={icon} size="sm" variant="stack" />
								</li>
							))
						}
					</ul>
				</section>

				<section class={panelClasses} data-showcase-panel="links">
					<h2 class="text-editorial-label-compact uppercase text-channel-accent-primary">
						{tPage('linksHeading')}
					</h2>
					<div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
						<LinkInline href="#shell-components" icon={ArrowRightIcon} iconPosition="trailing">
							{tPage('linkDefault')}
						</LinkInline>
						<LinkInline
							href="#shell-components"
							icon={ArrowRightIcon}
							iconPosition="trailing"
							class="underline decoration-2 underline-offset-3"
						>
							{tPage('linkHover')}
						</LinkInline>
						<LinkInline
							href="#shell-components"
							icon={ArrowRightIcon}
							iconPosition="trailing"
							class="underline decoration-2 underline-offset-3 outline-2 outline-offset-2 outline-button-focus"
						>
							{tPage('linkFocus')}
						</LinkInline>
					</div>
				</section>

				<section class={panelClasses} data-showcase-panel="social-pills">
					<h2 class="text-editorial-label-compact uppercase text-channel-accent-primary">
						{tPage('socialHeading')}
					</h2>
					<div class="mt-4 flex flex-wrap items-center gap-4">
						<SocialPill href="https://github.com" {newTabLabel}>
							<GitHubIcon aria-hidden="true" />
							{tPage('githubLabel')}
						</SocialPill>
						<SocialPill href="https://linkedin.com" {newTabLabel}>
							<LinkedInIcon aria-hidden="true" />
							{tPage('linkedinLabel')}
						</SocialPill>
						<SocialPill href="mailto:example@email.com" target="_self">
							<MailIcon aria-hidden="true" />
							{tPage('emailLabel')}
						</SocialPill>
					</div>
				</section>

				<section class={panelClasses} data-showcase-panel="avatars">
					<h2 class="text-editorial-label-compact uppercase text-channel-accent-primary">
						{tPage('avatarsHeading')}
					</h2>
					<div class="mt-4 flex flex-wrap items-end gap-4 md:gap-6">
						{
							avatarSizes.map(size => (
								<Avatar src="/profile/perfil.webp" alt={tPage('profileAlt')} {size} />
							))
						}
					</div>
				</section>
			</div>
		</div>
	</section>

	<section id="shell-components" class="mx-auto w-full max-w-7xl px-5 pt-10 md:px-8 md:pt-12">
		<TitleSection className="uppercase">
			<ArrowRightIcon class="text-channel-accent-primary" aria-hidden="true" />
			{tPage('shellHeading')}
		</TitleSection>

		<div class="mt-6 flex flex-wrap items-center gap-x-16 gap-y-8">
			<BrandLogo
				href={homeUrl}
				variant="full"
				accessibleLabel={tPage('brandLogoFullLabel')}
			/>
			<BrandLogo
				href={homeUrl}
				variant="compact"
				accessibleLabel={tPage('brandLogoCompactLabel')}
			/>
		</div>
	</section>
</div>
