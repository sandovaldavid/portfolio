---
interface Props {
	eyebrow: string;
	title: string;
	surface?: 'canvas' | 'highlight';
	layout?: 'prose' | 'split' | 'lead' | 'triad';
}

const { eyebrow, title, surface = 'canvas', layout = 'prose' } = Astro.props;
const useFullWidthProse = surface === 'highlight' && layout === 'prose';
const contentLayout = {
	prose: useFullWidthProse ? 'w-full' : 'max-w-220',
	split: 'grid w-full max-w-320 grid-cols-1 gap-4 md:grid-cols-2',
	lead: 'grid w-full max-w-320 grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1.18fr)_minmax(0,0.82fr)]',
	triad: 'grid w-full max-w-320 grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3',
}[layout];
---

<section
	class:list={[
		'w-full px-5 py-10 md:px-8 md:py-12 lg:px-20 lg:py-14',
		surface === 'highlight' && 'bg-channel-surface-highlight',
	]}
	data-experience-section
	data-experience-section-layout={layout}
	data-experience-section-surface={surface}
>
	<div class="mx-auto flex w-full max-w-320 flex-col gap-5">
		<div class:list={['flex flex-col gap-2', useFullWidthProse ? 'w-full' : 'max-w-220']}>
			<p class="text-editorial-label uppercase text-channel-accent-primary">{eyebrow}</p>
			<h2 class="text-feature-title text-content-strong md:text-section-title">{title}</h2>
		</div>
		<div
			class:list={[
				contentLayout,
				layout === 'prose' && 'text-body text-content-default [&>p+p]:mt-4',
			]}
		>
			<slot />
		</div>
	</div>
</section>
