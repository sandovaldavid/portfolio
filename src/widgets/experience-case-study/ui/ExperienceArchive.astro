---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ArrowRightIcon from '@assets/icons/ArrowRight.astro';
import { ExperienceTechnologyPill, type ExperienceList } from '@entities/experience';
import { createScopedUiTranslator, getLanguageFromLocale } from '@shared/config/i18n';
import { Badge, LinkButton } from '@shared/ui';

interface Props {
	experience: ExperienceList;
}

const { experience } = Astro.props;
const lang = getLanguageFromLocale(Astro.currentLocale);
const tPage = createScopedUiTranslator(lang, 'pages.experience');
---

<article class="flex w-full max-w-320 flex-col gap-10 px-5 md:px-8 lg:px-0" data-experience-archive>
	<header class="flex max-w-220 flex-col gap-4">
		<p class="text-editorial-label uppercase text-channel-accent-primary">{tPage('careerHistory')}</p>
		<h1 class="text-page-title-mobile text-content-strong md:text-page-title">{tPage('archiveTitle')}</h1>
		<p class="text-body text-content-default">{tPage('archiveSummary')}</p>
	</header>

	<ol class="flex flex-col gap-5">
		{
			experience.map((item, index) => (
				<li>
					<article class="grid min-w-0 gap-5 border-2 border-edge-strong bg-channel-surface-default p-5 shadow-retro-md md:p-6 lg:grid-cols-[180px_minmax(0,1fr)_auto] lg:items-center lg:gap-8">
						<div class="flex flex-col items-start gap-2">
							<span class="font-mono text-caption text-channel-accent-primary">
								{String(index + 1).padStart(2, '0')}
							</span>
							<Badge variant={item.isCurrent ? 'success' : 'default'} size="sm">
								{item.isCurrent ? tPage('currentStatus') : tPage('pastStatus')}
							</Badge>
							<p class="text-secondary text-content-muted">{item.date}</p>
						</div>

						<div class="flex min-w-0 flex-col gap-3">
							<div class="flex min-w-0 flex-col gap-1">
								<h2 class="text-component-title text-content-strong md:text-feature-title">{item.company}</h2>
								<p class="text-editorial-label uppercase text-channel-accent-primary">{item.title}</p>
							</div>
							<p class="max-w-180 text-secondary text-content-default md:text-body">{item.summary}</p>
							<ul class="flex flex-wrap gap-2">
								{item.technologies.slice(0, 4).map(technology => (
									<li>
										<ExperienceTechnologyPill technology={technology} size="sm" />
									</li>
								))}
							</ul>
						</div>

						<LinkButton
							href={getRelativeLocaleUrl(lang, `experience/${item.experienceId}`)}
							target="_self"
							variant={item.isCurrent ? 'primary' : 'secondary'}
							class="w-fit shrink-0"
						>
							{tPage('viewRole')}
							<ArrowRightIcon class="size-4" aria-hidden="true" />
						</LinkButton>
					</article>
				</li>
			))
		}
	</ol>
</article>
