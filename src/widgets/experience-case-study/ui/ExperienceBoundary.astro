---
interface Props {
	eyebrow: string;
	title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="w-full px-5 py-10 md:px-8 md:py-12 lg:px-20 lg:py-14" data-experience-boundary>
	<div class="mx-auto w-full max-w-320">
		<div
			class="flex max-w-220 flex-col gap-3 border-2 border-edge-strong bg-channel-surface-highlight p-5 shadow-retro-md md:p-6"
		>
			<p class="text-editorial-label uppercase text-channel-accent-primary">{eyebrow}</p>
			<h2 class="text-component-title text-content-strong md:text-feature-title">{title}</h2>
			<div class="text-body text-content-default [&>p+p]:mt-4">
				<slot />
			</div>
		</div>
	</div>
</section>
