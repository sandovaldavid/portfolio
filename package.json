{
	"name": "portfolio",
	"private": true,
	"type": "module",
	"version": "1.0.0",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "astro dev",
		"build": "astro check --minimumFailingSeverity hint && astro build",
		"preview": "astro preview",
		"prepare": "husky",
		"astro": "astro",
		"format": "node scripts/format-tracked-files.mjs --write",
		"format:check": "node scripts/format-tracked-files.mjs --check",
		"lint:eslint": "eslint .",
		"lint:architecture": "node scripts/check-architecture.mjs",
		"lint": "bun run lint:eslint && bun run lint:architecture",
		"lint:fix": "eslint . --fix && bun run lint:architecture",
		"typecheck:astro": "astro check --minimumFailingSeverity hint",
		"typecheck:tooling": "tsc --noEmit --project tsconfig.tooling.json",
		"typecheck": "bun run typecheck:astro && bun run typecheck:tooling",
		"check:docs": "node scripts/check-doc-links.mjs",
		"check:devcontainer": "node scripts/check-devcontainer.mjs && node scripts/check-local-browser-validation.mjs",
		"check:i18n:catalogs": "node scripts/i18n/check-catalogs.mjs",
		"check:i18n:content": "node scripts/i18n/check-content.mjs",
		"check:i18n:hardcoded": "node scripts/i18n/check-hardcoded.mjs",
		"check:i18n:routes": "node scripts/i18n/check-routes.mjs",
		"check:i18n": "bun run check:i18n:catalogs && bun run check:i18n:content && bun run check:i18n:hardcoded",
		"check": "bun run format:check && bun run check:docs && bun run check:devcontainer && bun run check:i18n && bun run lint && bun run typecheck",
		"check:production-output": "node scripts/check-production-output.mjs",
		"check:links": "node scripts/check-built-links.mjs && bun run check:production-output && bun run check:i18n:routes",
		"validate:local": "node scripts/run-local-validation.mjs",
		"validate:local:inside": "node scripts/run-local-validation-inside.mjs",
		"screenshots": "node scripts/capture-screenshots.mjs",
		"screenshots:design-system": "node scripts/capture-design-system-evidence.mjs",
		"test": "node scripts/run-playwright.mjs",
		"test:docker": "bash docker/docker-test.sh",
		"test:local": "bun run validate:local",
		"test:e2e:smoke": "node scripts/run-playwright.mjs tests/e2e/smoke.spec.ts tests/e2e/research-page-layout.spec.ts tests/e2e/design-system-colors.spec.ts tests/e2e/performance.spec.ts tests/e2e/editorial-localization.spec.ts tests/e2e/i18n-routing.spec.ts tests/e2e/metadata-localization.spec.ts tests/e2e/i18n-enforcement.spec.ts tests/e2e/recruiter-journey.spec.ts tests/e2e/brand-identity.spec.ts tests/e2e/navigation-focus-geometry.spec.ts --project=chromium",
		"test:e2e:report": "playwright show-report playwright-report --host 127.0.0.1 --port 9323",
		"test:e2e:desktop": "node scripts/run-playwright.mjs --project=chromium --project=firefox --project=webkit",
		"test:e2e:extended": "node scripts/run-playwright.mjs --project=chromium --project=firefox --project=webkit --project='Mobile Chrome' --project='Mobile Safari'",
		"test:e2e:visual": "RUN_VISUAL_TESTS=true node scripts/run-playwright.mjs tests/e2e/visual.spec.ts --project=chromium",
		"test:e2e:visual:docker": "CI=true RUN_VISUAL_TESTS=true E2E_USE_PRODUCTION_PREVIEW=1 bash docker/docker-test.sh tests/e2e/visual.spec.ts --project=chromium",
		"test:snapshots": "RUN_VISUAL_TESTS=true node scripts/run-playwright.mjs tests/e2e/visual.spec.ts --update-snapshots --project=chromium",
		"test:snapshots:all": "bun run test:snapshots",
		"test:ui": "node scripts/run-playwright.mjs --ui",
		"test:debug": "node scripts/run-playwright.mjs --debug",
		"test:unit": "vitest",
		"test:unit:ci": "vitest run",
		"test:unit:ui": "vitest --ui",
		"test:unit:coverage": "echo 'Unit coverage scope: shared i18n and content-ID utilities only; not whole-repository coverage.' && vitest run --coverage",
		"test:all": "bun run test:unit:ci && bun run test",
		"lighthouse": "lhci autorun --config=config/lighthouse/lighthouserc.json",
		"lighthouse:collect": "lhci collect --config=config/lighthouse/lighthouserc.json",
		"lighthouse:assert": "lhci assert --config=config/lighthouse/lighthouserc.json",
		"lighthouse:collect:extended": "lhci collect --config=config/lighthouse/lighthouserc.extended.json",
		"lighthouse:assert:extended": "lhci assert --config=config/lighthouse/lighthouserc.extended.json",
		"bundle:analyze": "node scripts/analyze-bundle.js",
		"performance:check": "node scripts/check-route-performance.mjs",
		"bundle:visualize": "ANALYZE_BUNDLE=true bun run build && bun run bundle:analyze"
	},
	"dependencies": {
		"@astrojs/mdx": "7.0.8",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"astro": "^7.2.9",
		"mermaid": "11.17.2",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "1.62.1",
		"playwright-core": "1.62.1",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^26.4.0",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.8.1",
		"eslint-plugin-astro": "~3.1.0",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
