{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"paths": {
			"@app/*": ["./src/app/*"],
			"@assets/*": ["./src/assets/*"],
			"@content/*": ["./src/content/*"],
			"@entities/*": ["./src/entities/*"],
			"@features/*": ["./src/features/*"],
			"@scripts/*": ["./scripts/*"],
			"@shared/*": ["./src/shared/*"],
			"@tests/*": ["./tests/*"],
			"@widgets/*": ["./src/widgets/*"]
		}
	},
	"exclude": ["dist", "coverage/", "tests/", "playwright.config.ts", "vitest.config.ts"]
}
